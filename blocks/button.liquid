{% doc %}
Button content block.
{% enddoc %}
{% if block.settings.label != blank and block.settings.link != blank %}<a class="button{% if block.settings.secondary %} button--secondary{% endif %}" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>{% endif %}
{% schema %}
{
  "name": "Button",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Destination"
    },
    {
      "type": "checkbox",
      "id": "secondary",
      "label": "Secondary style",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Button"
    }
  ]
}
{% endschema %}
