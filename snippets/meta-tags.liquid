<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">

{%- liquid
  assign seo_title = page_title | default: shop.name

  case request.page_type
    when 'cart', 'search', 'list-collections', '404', 'password', 'gift_card'
      assign title_key = 'seo.' | append: request.page_type | replace: '-', '_' | append: '_title'
      assign seo_title = title_key | t: shop: shop.name, terms: search.terms
  endcase

  assign seo_title_downcase = seo_title | downcase
  assign shop_name_downcase = shop.name | downcase
  unless seo_title_downcase contains shop_name_downcase
    capture seo_title
      echo seo_title
      echo ' | '
      echo shop.name
    endcapture
  endunless

  assign seo_description = page_description

  if seo_description == blank
    case request.page_type
      when 'product'
        assign seo_description = product.description
      when 'collection'
        assign seo_description = collection.description
      when 'page'
        assign seo_description = page.content
      when 'article'
        assign seo_description = article.excerpt_or_content
      when 'policy'
        assign seo_description = policy.body
      else
        assign description_key = 'seo.' | append: request.page_type | replace: '-', '_' | append: '_description'
        assign seo_description = description_key | t: shop: shop.name
    endcase
  endif
  if seo_description == blank or seo_description contains 'Translation missing'
    assign seo_description = 'seo.default_description' | t: shop: shop.name, title: page_title
  endif

  assign seo_description = seo_description | strip_html | strip_newlines | strip | truncate: 160
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign seo_image = page_image
  assign twitter_card = 'summary'

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  if seo_image != blank
    assign twitter_card = 'summary_large_image'
  elsif settings.social_share_image != blank
    assign seo_image = settings.social_share_image
    assign twitter_card = 'summary_large_image'
  elsif shop.brand.logo != blank
    assign seo_image = shop.brand.logo
  endif

  assign seo_image_alt = seo_image.alt | default: seo_title

  case request.page_type
    when 'search', 'cart', '404', 'password', 'gift_card'
      assign robots_content = 'noindex,follow'
  endcase

  assign root_absolute_url = request.origin | append: routes.root_url
  assign collections_absolute_url = request.origin | append: routes.collections_url
  assign organization_id = shop.url | append: '#organization'
-%}

<title>
  {{- seo_title | escape -}}
  {%- if current_tags %} &ndash; tagged “{{ current_tags | join: ', ' | escape }}”{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
</title>

<meta name="description" content="{{ seo_description | escape }}">

{%- if robots_content != blank -%}
  <meta name="robots" content="{{ robots_content }}">
{%- endif -%}

<link rel="canonical" href="{{ og_url | escape }}">

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url | escape }}">
<meta property="og:title" content="{{ seo_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ seo_description | escape }}">

{%- if seo_image != blank -%}
  <meta property="og:image" content="https:{{ seo_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ seo_image | image_url: width: 1200 }}">
  <meta property="og:image:alt" content="{{ seo_image_alt | escape }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  {%- assign og_variant = product.selected_variant | default: product.selected_or_first_available_variant -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  <meta property="product:price:amount" content="{{ og_variant.price | money_without_currency | strip_html }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

<meta name="twitter:card" content="{{ twitter_card }}">
<meta name="twitter:url" content="{{ og_url | escape }}">
<meta name="twitter:title" content="{{ seo_title | escape }}">
<meta name="twitter:description" content="{{ seo_description | escape }}">
{%- if seo_image != blank -%}
  <meta name="twitter:image" content="https:{{ seo_image | image_url: width: 1200 }}">
  <meta name="twitter:image:alt" content="{{ seo_image_alt | escape }}">
{%- endif -%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": {{ organization_id | json }},
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }}{% if shop.brand.logo != blank %},
    "logo": {{ shop.brand.logo | image_url: width: 600 | prepend: 'https:' | json }}{% endif %}
  }
</script>

{%- case request.page_type -%}
  {%- when 'product' -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ root_absolute_url | json }} },
          { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ canonical_url | json }} }
        ]
      }
    </script>
  {%- when 'collection' -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ root_absolute_url | json }} },
          { "@type": "ListItem", "position": 2, "name": "Collections", "item": {{ collections_absolute_url | json }} },
          { "@type": "ListItem", "position": 3, "name": {{ collection.title | json }}, "item": {{ canonical_url | json }} }
        ]
      }
    </script>
  {%- when 'list-collections' -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ root_absolute_url | json }} },
          { "@type": "ListItem", "position": 2, "name": "Collections", "item": {{ canonical_url | json }} }
        ]
      }
    </script>
  {%- when 'page' -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ root_absolute_url | json }} },
          { "@type": "ListItem", "position": 2, "name": {{ page.title | json }}, "item": {{ canonical_url | json }} }
        ]
      }
    </script>
  {%- when 'blog' -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ root_absolute_url | json }} },
          { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ canonical_url | json }} }
        ]
      }
    </script>
  {%- when 'article' -%}
    {%- assign blog_absolute_url = request.origin | append: blog.url -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ root_absolute_url | json }} },
          { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ blog_absolute_url | json }} },
          { "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": {{ canonical_url | json }} }
        ]
      }
    </script>
  {%- when 'policy' -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ root_absolute_url | json }} },
          { "@type": "ListItem", "position": 2, "name": {{ policy.title | json }}, "item": {{ canonical_url | json }} }
        ]
      }
    </script>
{%- endcase -%}

