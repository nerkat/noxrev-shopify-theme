{% doc %}
Applies optional layout settings to one section instance.
@param {section} section - Section being styled.
{% enddoc %}
{% style %}
{% if section.settings.custom_spacing %}
#shopify-section-{{ section.id }} > :is(section, .page-width, .container, .custom-section) { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
@media (max-width: 749px) { #shopify-section-{{ section.id }} > :is(section, .page-width, .container, .custom-section) { padding-top: {{ section.settings.padding_top_mobile }}px; padding-bottom: {{ section.settings.padding_bottom_mobile }}px; } }
{% endif %}
{% unless section.settings.layout_width == 'inherit' %}
#shopify-section-{{ section.id }} :is(.container,.page-width) { width: min(calc(100% - 2 * var(--page-margin)), {% case section.settings.layout_width %}{% when 'narrow' %}760px{% when 'full' %}100%{% else %}var(--page-width){% endcase %}); }
{% endunless %}
{% unless section.settings.layout_alignment == 'inherit' %}
#shopify-section-{{ section.id }} { text-align: {{ section.settings.layout_alignment }}; }
#shopify-section-{{ section.id }} :is([class$="__header"],[class$="__copy"],[class$="__content"]) { text-align: {{ section.settings.layout_alignment }}; }
{% endunless %}
{% if section.settings.device_visibility == 'desktop' %}@media(max-width:749px){#shopify-section-{{ section.id }}{display:none}}{% endif %}
{% if section.settings.device_visibility == 'mobile' %}@media(min-width:750px){#shopify-section-{{ section.id }}{display:none}}{% endif %}
{% if request.design_mode %}#shopify-section-{{ section.id }}.shopify-section--selected{display:block}{% endif %}
{% endstyle %}
{% if section.settings.use_section_scheme %}
{% assign scheme = section.settings.color_scheme %}
{% style %}
#shopify-section-{{ section.id }} {
--theme-color-background: {{ scheme.settings.background }};
--theme-color-background-alt: {{ scheme.settings.background }};
--theme-color-surface: {{ scheme.settings.background }};
--theme-color-surface-strong: {{ scheme.settings.background }};
--theme-color-text: {{ scheme.settings.text }};
--theme-color-text-muted: {{ scheme.settings.text | color_modify: 'alpha', 0.68 }};
--theme-color-secondary: {{ scheme.settings.accent }};
--theme-color-primary: {{ scheme.settings.button }};
--theme-color-border: {{ scheme.settings.border }};
--brand-button-text: {{ scheme.settings.button_label }};
--theme-gradient-cta: linear-gradient({{ scheme.settings.button }}, {{ scheme.settings.button }});
color: var(--theme-color-text); background-color: var(--theme-color-background);
}
#shopify-section-{{ section.id }} > :is(section,div) {background-color:var(--theme-color-background);color:var(--theme-color-text)}
#shopify-section-{{ section.id }} :is([class$="__panel"],[class$="__card"]) {background:var(--theme-color-surface)}
{% endstyle %}
{% endif %}
