{% doc %}
  Renders a reusable product card.

  @param {product} product - Product object to render
  @param {boolean} [show_vendor] - When true, render the vendor line
{% enddoc %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = product.featured_media | default: product.media.first
  assign featured_image = featured_media.preview_image | default: featured_media
  assign featured_image_alt = featured_image.alt | default: product.title
  assign compare_at_price = current_variant.compare_at_price
  assign price = current_variant.price | default: product.price
  assign on_sale = false
  assign meta_label = product.type
  assign option_count = product.variants.size

  if compare_at_price > price
    assign on_sale = true
  endif

  if meta_label == blank and show_vendor and product.vendor != blank
    assign meta_label = product.vendor
  endif
-%}

<article class="product-card card panel link-surface">
  <div class="product-card__badges">
    {% unless product.available %}
      <span class="badge badge--secondary">Sold out</span>
    {% endunless %}

    {% if on_sale %}
      <span class="badge">Sale</span>
    {% endif %}
  </div>

  {% if meta_label != blank %}
    <div class="product-card__meta">
      <span class="chip">{{ meta_label | escape }}</span>
    </div>
  {% endif %}

  <a class="product-card__link" href="{{ product.url }}">
    <div class="product-card__media card__media">
      {% render 'responsive-image',
        image: featured_image,
        alt: featured_image_alt,
        class: 'product-card__image',
        loading: 'lazy',
        sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw',
        widths: '320, 480, 720, 960'
      %}
    </div>

    <div class="product-card__content card__content">
      <h3 class="product-card__title">{{ product.title | escape }}</h3>

      {% if show_vendor and product.vendor != blank %}
        <p class="product-card__vendor">{{ product.vendor | escape }}</p>
      {% endif %}

      <div class="product-card__footer">
        <div>
          <div class="product-card__price" aria-label="Product price">
            <p class="product-card__price-current">{% render 'price', amount: price %}</p>

            {% if on_sale %}
              <p class="product-card__price-compare">
                <span class="visually-hidden">Regular price</span>
                {% render 'price', amount: compare_at_price %}
              </p>
            {% endif %}
          </div>

          {% if option_count > 1 %}
            <p class="product-card__status">{{ option_count }} options</p>
          {% endif %}
        </div>

        <span class="product-card__cta">Open product</span>
      </div>

      {% unless product.available %}
        <p class="product-card__status">Currently unavailable</p>
      {% endunless %}
    </div>
  </a>
</article>
