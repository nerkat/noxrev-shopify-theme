{%- liquid
  assign show_breadcrumbs = true
  assign current_label = ''
  assign parent_label = ''
  assign parent_url = ''

  if settings.show_breadcrumbs == false
    assign show_breadcrumbs = false
  endif

  case request.page_type
    when 'index', 'password', 'gift_card'
      assign show_breadcrumbs = false
    when 'product'
      assign current_label = product.title
      if collection != blank
        assign parent_label = collection.title
        assign parent_url = collection.url
      else
        assign parent_label = 'breadcrumbs.products' | t
        assign parent_url = routes.all_products_collection_url
      endif
    when 'collection'
      assign current_label = collection.title
      assign parent_label = 'breadcrumbs.collections' | t
      assign parent_url = routes.collections_url
    when 'list-collections'
      assign current_label = 'breadcrumbs.collections' | t
    when 'page'
      assign current_label = page.title
    when 'blog'
      assign current_label = blog.title
    when 'article'
      assign current_label = article.title
      assign parent_label = blog.title
      assign parent_url = blog.url
    when 'policy'
      assign current_label = policy.title
    when 'search'
      assign current_label = 'breadcrumbs.search' | t
    when 'cart'
      assign current_label = 'breadcrumbs.cart' | t
    when '404'
      assign current_label = 'breadcrumbs.not_found' | t
    else
      assign show_breadcrumbs = false
  endcase

  assign visibility_key = 'breadcrumbs_' | append: request.page_type
  if settings[visibility_key] == false
    assign show_breadcrumbs = false
  endif
  if current_label == blank
    assign show_breadcrumbs = false
  endif
-%}

{%- if show_breadcrumbs -%}
  <nav class="visible-breadcrumbs" aria-label="{{ 'breadcrumbs.label' | t }}">
    <ol class="visible-breadcrumbs__list page-width" role="list">
      <li class="visible-breadcrumbs__item">
        <a class="visible-breadcrumbs__link" href="{{ routes.root_url }}">{{ 'breadcrumbs.home' | t }}</a>
      </li>
      {%- if parent_label != blank and parent_url != blank -%}
        <li class="visible-breadcrumbs__item">
          <a class="visible-breadcrumbs__link" href="{{ parent_url }}">{{ parent_label | escape }}</a>
        </li>
      {%- endif -%}
      <li class="visible-breadcrumbs__item" aria-current="page">
        <span class="visible-breadcrumbs__current">{{ current_label | escape }}</span>
      </li>
    </ol>
  </nav>
{%- endif -%}

{% style %}
{% if settings.breadcrumbs_mobile %}@media(max-width:749px){.template-product .visible-breadcrumbs{display:block}}{% else %}@media(max-width:749px){.visible-breadcrumbs{display:none}}{% endif %}
{% unless settings.breadcrumbs_desktop %}@media(min-width:750px){.visible-breadcrumbs{display:none}}{% endunless %}
{% endstyle %}
