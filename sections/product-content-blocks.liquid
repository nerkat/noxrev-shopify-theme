{% javascript %}
  (() => {
    const initAnimatedFaqs = (scope = document) => {
      scope.querySelectorAll('.product-content-blocks__faq-item').forEach((item) => {
        if (item.dataset.faqAnimated === 'true') {
          return;
        }

        const summary = item.querySelector('summary');
        const panel = item.querySelector('.product-content-blocks__faq-panel');

        if (!summary || !panel) {
          return;
        }

        if (item.open) {
          panel.style.height = 'auto';
          panel.style.opacity = '1';
        } else {
          panel.style.height = '0px';
          panel.style.opacity = '0';
        }

        summary.addEventListener('click', (event) => {
          event.preventDefault();

          if (item.classList.contains('is-animating')) {
            return;
          }

          const isOpening = !item.open;
          item.classList.add('is-animating');

          if (isOpening) {
            item.open = true;
            panel.style.height = '0px';
            panel.style.opacity = '1';

            requestAnimationFrame(() => {
              panel.style.height = `${panel.scrollHeight}px`;
            });

            const onOpenEnd = (evt) => {
              if (evt.propertyName !== 'height') {
                return;
              }

              panel.style.height = 'auto';
              panel.style.opacity = '1';
              item.classList.remove('is-animating');
              panel.removeEventListener('transitionend', onOpenEnd);
            };

            panel.addEventListener('transitionend', onOpenEnd);
          } else {
            panel.style.height = `${panel.scrollHeight}px`;
            panel.style.opacity = '1';

            requestAnimationFrame(() => {
              panel.style.height = '0px';
              panel.style.opacity = '0';
            });

            const onCloseEnd = (evt) => {
              if (evt.propertyName !== 'height') {
                return;
              }

              item.open = false;
              panel.style.height = '0px';
              panel.style.opacity = '0';
              item.classList.remove('is-animating');
              panel.removeEventListener('transitionend', onCloseEnd);
            };

            panel.addEventListener('transitionend', onCloseEnd);
          }
        });

        item.dataset.faqAnimated = 'true';
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initAnimatedFaqs());
    } else {
      initAnimatedFaqs();
    }

    document.addEventListener('shopify:section:load', (event) => {
      initAnimatedFaqs(event.target);
    });
  })();
{% endjavascript %}

