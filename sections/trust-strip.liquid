{% if section.blocks.size > 0 %}
  <section class="trust-strip full-width">
    <div class="trust-strip__inner">
      {% for block in section.blocks %}
        <div class="trust-strip__item panel" {{ block.shopify_attributes }}>
          {% if block.settings.eyebrow != blank %}
            <p class="trust-strip__eyebrow">{{ block.settings.eyebrow | escape }}</p>
          {% endif %}

          {% if block.settings.heading != blank %}
            <h2 class="trust-strip__heading">{{ block.settings.heading | escape }}</h2>
          {% endif %}

          {% if block.settings.text != blank %}
            <p class="trust-strip__text">{{ block.settings.text | escape }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .trust-strip {
    background: transparent;
    padding: 1rem 0;
  }

  .trust-strip__inner {
    width: min(100% - (var(--page-margin) * 2), var(--page-width));
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .trust-strip__item {
    display: grid;
    gap: 0.65rem;
    border-radius: var(--theme-radius-lg);
    padding: 1.15rem 1rem;
  }

  .trust-strip__eyebrow {
    margin: 0;
    color: var(--theme-color-accent);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .trust-strip__heading {
    margin: 0;
    color: var(--theme-color-text);
    font-size: 1.02rem;
    line-height: 1.25;
  }

  .trust-strip__text {
    margin: 0;
    color: var(--theme-color-text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .trust-strip__inner {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust strip",
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Compatibility"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Choose the exact iPad fit before checkout."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Use the fit guide or send us your model name so your NoxRev keyboard case matches your device the first time."
        }
      ]
    }
  ],
  "max_blocks": 3
}
{% endschema %}
