{% style %}@media(max-width:749px){#shopify-section-{{ section.id }} .footer__logo{max-width:{{ section.settings.mobile_logo_width }}px}}{% if section.settings.footer_layout == 'stack' %}#shopify-section-{{ section.id }} .footer__top{grid-template-columns:1fr}{% endif %}{% endstyle %}
{% liquid
  assign brand_text = section.settings.brand_text | default: shop.name
  assign has_primary_menu = false
  assign has_secondary_menu = false
  assign has_social_links = false
  assign footer_support_email = section.settings.contact_email
  assign footer_support_phone = section.settings.contact_phone
  assign footer_social_tiktok = section.settings.social_tiktok
  assign footer_social_instagram = section.settings.social_instagram
  assign footer_social_facebook = section.settings.social_facebook
  assign footer_social_youtube = section.settings.social_youtube
  if section.settings.use_global_support_contact
    assign footer_support_email = settings.global_support_email | default: footer_support_email
    assign footer_support_phone = settings.global_support_phone | default: footer_support_phone
  else
    assign footer_support_email = footer_support_email | default: settings.global_support_email
    assign footer_support_phone = footer_support_phone | default: settings.global_support_phone
  endif
  if section.settings.use_global_social_profiles
    assign footer_social_tiktok = settings.global_social_tiktok_url | default: footer_social_tiktok
    assign footer_social_instagram = settings.global_social_instagram_url | default: footer_social_instagram
    assign footer_social_facebook = settings.global_social_facebook_url | default: footer_social_facebook
    assign footer_social_youtube = settings.global_social_youtube_url | default: footer_social_youtube
  else
    assign footer_social_tiktok = footer_social_tiktok | default: settings.global_social_tiktok_url
    assign footer_social_instagram = footer_social_instagram | default: settings.global_social_instagram_url
    assign footer_social_facebook = footer_social_facebook | default: settings.global_social_facebook_url
    assign footer_social_youtube = footer_social_youtube | default: settings.global_social_youtube_url
  endif

  if section.settings.primary_menu != blank
    for link in section.settings.primary_menu.links
      assign has_primary_menu = true
      break
    endfor
  endif

  if section.settings.secondary_menu != blank
    for link in section.settings.secondary_menu.links
      assign has_secondary_menu = true
      break
    endfor
  endif

  if footer_social_instagram != blank
    assign has_social_links = true
  endif

  if footer_social_facebook != blank
    assign has_social_links = true
  endif

  if footer_social_tiktok != blank
    assign has_social_links = true
  endif

  if footer_social_youtube != blank
    assign has_social_links = true
  endif
-%}

<footer class="footer{% if section.settings.use_section_scheme %} color-{{ section.settings.color_scheme }}{% endif %}" style="--footer-logo-max-width: {{ section.settings.logo_max_width | default: 190 }}px;">
  <div class="section footer__inner">
    <div class="footer__shell container">
      <div class="footer__top">
        <div class="footer__brand">
          <a class="footer__brand-link" href="{{ routes.root_url }}" aria-label="{{ brand_text | escape }}">
            {% if section.settings.logo != blank %}
              {{
                section.settings.logo
                | image_url: width: 240
                | image_tag: class: 'footer__logo', loading: 'lazy', alt: brand_text
              }}
            {% else %}
              <span class="footer__brand-text">{{ brand_text | escape }}</span>
            {% endif %}
          </a>

          {% if section.settings.text != blank %}
            <p class="footer__text">{{ section.settings.text | escape }}</p>
          {% endif %}

          <div class="footer__contact">{% if settings.global_response_time != blank %}<p>{{ settings.global_response_time | escape }}</p>{% endif %}
            {% if footer_support_email != blank %}
              <a href="mailto:{{ footer_support_email | escape }}">{{ footer_support_email | escape }}</a>
            {% endif %}
            {% if footer_support_phone != blank %}
              <a href="tel:{{ footer_support_phone | replace: ' ', '' }}">
                {{- footer_support_phone -}}
              </a>
            {% endif %}
            {% if section.settings.contact_info != blank %}
              <p>{{ section.settings.contact_info | escape }}</p>
            {% endif %}
          </div>

          {% if section.settings.show_social_links and has_social_links %}
            <div class="footer__social" aria-label="Social links">
              {% if footer_social_tiktok != blank %}
                <a class="footer__social-link" href="{{ footer_social_tiktok }}" aria-label="TikTok">
                  <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true">
                    <path d="M14 4v9.1a4.2 4.2 0 1 1-3.2-4.1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
                    <path d="M14 4c.5 2.6 2.1 4.2 4.8 4.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
                  </svg>
                </a>
              {% endif %}
              {% if footer_social_instagram != blank %}
                <a class="footer__social-link" href="{{ footer_social_instagram }}" aria-label="Instagram">
                  <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true">
                    <rect x="5" y="5" width="14" height="14" rx="4" stroke="currentColor" stroke-width="1.7"></rect>
                    <circle cx="12" cy="12" r="3.2" stroke="currentColor" stroke-width="1.7"></circle>
                    <path d="M16.3 7.8h.01" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
                  </svg>
                </a>
              {% endif %}
              {% if footer_social_facebook != blank %}
                <a class="footer__social-link" href="{{ footer_social_facebook }}" aria-label="Facebook">
                  <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true">
                    <path d="M14 8.6h2.3V5.2A10 10 0 0 0 13.1 5c-3.1 0-5 1.8-5 5.2v2.2H5v3.8h3.1V22h3.8v-5.8h3.1l.5-3.8h-3.6v-1.8c0-1.1.3-2 2.1-2Z" stroke="currentColor" stroke-width="1.45" stroke-linejoin="round"></path>
                  </svg>
                </a>
              {% endif %}
              {% if footer_social_youtube != blank %}
                <a class="footer__social-link" href="{{ footer_social_youtube }}" aria-label="YouTube">
                  <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true">
                    <path d="M21 12s0-3.2-.4-4.4c-.2-.7-.8-1.3-1.5-1.5C17.8 5.8 12 5.8 12 5.8s-5.8 0-7.1.3c-.7.2-1.3.8-1.5 1.5C3 8.8 3 12 3 12s0 3.2.4 4.4c.2.7.8 1.3 1.5 1.5 1.3.3 7.1.3 7.1.3s5.8 0 7.1-.3c.7-.2 1.3-.8 1.5-1.5.4-1.2.4-4.4.4-4.4Z" stroke="currentColor" stroke-width="1.55" stroke-linejoin="round"></path>
                    <path d="m10.4 9.4 4.2 2.6-4.2 2.6V9.4Z" fill="currentColor"></path>
                  </svg>
                </a>
              {% endif %}
            </div>
          {% endif %}
        </div>

        <div class="footer__navs">
          {% if has_primary_menu %}
            <nav class="footer__menu" aria-label="Footer primary">
              <h2 class="footer__heading">{{ section.settings.primary_menu_heading | default: 'Browse' | escape }}</h2>
              {% for link in section.settings.primary_menu.links %}
                <a class="footer__link" href="{{ link.url }}">{{ link.title }}</a>
              {% endfor %}
            </nav>
          {% endif %}

          {% if has_secondary_menu %}
            <nav class="footer__menu" aria-label="Footer secondary">
              <h2 class="footer__heading">{{ section.settings.secondary_menu_heading | default: 'Help' | escape }}</h2>
              {% for link in section.settings.secondary_menu.links %}
                <a class="footer__link" href="{{ link.url }}">{{ link.title }}</a>
              {% endfor %}
            </nav>
          {% endif %}
        </div>
      </div>

      {% if section.settings.show_trust_row %}<div class="footer__trust">{% for i in (1..3) %}{% assign key = 'benefit_' | append: i %}{% render 'store-benefit', record: section.settings[key] %}{% endfor %}</div>{% endif %}
      <div class="footer__bottom">
        {% if shop.enabled_payment_types.size > 0 %}
          {% if section.settings.show_payment_icons != false %}
            <div class="footer__payments" aria-label="Accepted payment methods">
              {% for type in shop.enabled_payment_types %}
                {{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}
              {% endfor %}
            </div>
          {% endif %}
        {% elsif section.settings.payment_text != blank %}
          <div class="footer__payments" aria-label="Accepted payment methods">
            <p class="footer__payment-text">{{ section.settings.payment_text | escape }}</p>
          </div>
        {% endif %}
        <p class="footer__copyright">{{ section.settings.copyright_text | escape }}</p>
      </div>
    </div>
  </div>
</footer>

{% stylesheet %}
  .footer {
    display: grid;
    border-top: 1px solid color-mix(in srgb, var(--theme-color-secondary) 14%, transparent);
    background: radial-gradient(circle at 12% 0%, color-mix(in srgb, var(--theme-color-secondary) 12%, transparent), transparent 34rem),
      radial-gradient(circle at 88% 0%, rgba(255, 77, 166, 0.1), transparent 30rem),
      linear-gradient(180deg, rgba(2, 8, 20, 0.76), rgba(2, 8, 20, 0.98));
  }

  .footer__inner {
    padding-top: clamp(2.4rem, 5vw, 4.5rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .footer__shell {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 2rem);
    padding: clamp(1.2rem, 2.6vw, 2rem);
  }

  .footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
    gap: clamp(1.75rem, 4vw, 4rem);
    align-items: start;
  }

  .footer__brand,
  .footer__menu,
  .footer__social,
  .footer__contact {
    display: grid;
    gap: 0.75rem;
  }

  .footer__brand-link,
  .footer__link,
  .footer__contact a {
    color: inherit;
    text-decoration: none;
    transition: color var(--transition-base), text-shadow var(--transition-base);
  }

  .footer__brand-link:focus-visible,
  .footer__link:focus-visible,
  .footer__contact a:focus-visible,
  .footer__social-link:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--theme-color-secondary) 72%, transparent);
    outline-offset: 4px;
  }

  .footer__link:hover,
  .footer__brand-link:hover,
  .footer__contact a:hover,
  .footer__social-link:hover {
    color: var(--theme-color-secondary);
    text-shadow: 0 0 14px color-mix(in srgb, var(--theme-color-secondary) 18%, transparent);
  }

  .footer__brand {
    max-width: 30rem;
  }

  .footer__brand-text {
    font-family: var(--theme-font-display);
    font-size: calc(clamp(1.35rem, 2vw, 2rem) * var(--body-scale, 1));
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--theme-color-text);
    text-shadow: 0 0 22px color-mix(in srgb, var(--theme-color-secondary) 16%, transparent);
  }

  .footer__logo {
    display: block;
    max-width: var(--footer-logo-max-width, 190px);
    width: auto;
    height: auto;
  }

  .footer__text,
  .footer__contact p {
    color: var(--theme-color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .footer__contact,
  .footer__contact a {
    color: var(--theme-color-text-muted);
    font-size: calc(0.95rem * var(--body-scale, 1));
  }

  .footer__heading {
    grid-column: span 2;
    margin: 0;
    color: var(--theme-color-secondary);
    font-size: calc(0.78rem * var(--heading-scale, 1));
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .footer__navs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .footer__menu,
  .footer__policies {
    grid-template-columns: 1fr 1fr;
    align-content: start;
  }

  .footer__link {
    color: var(--theme-color-text-muted);
    font-size: calc(0.95rem * var(--body-scale, 1));
  }

  .footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 0.25rem;
  }

  .footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.65rem;
    height: 2.65rem;
    border: 1px solid color-mix(in srgb, var(--theme-color-secondary) 24%, transparent);
    border-radius: 12px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--theme-color-text) 5.5%, transparent), color-mix(in srgb, var(--theme-color-text) 1.8%, transparent));
    color: var(--theme-color-secondary);
    text-decoration: none;
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--theme-color-text) 5%, transparent);
    transition: border-color var(--transition-base), color var(--transition-base), box-shadow var(--transition-base),
      transform var(--transition-base);
  }

  .footer__social-link svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  .footer__social-link:hover,
  .footer__social-link:focus-visible {
    border-color: color-mix(in srgb, var(--theme-color-secondary) 68%, transparent);
    color: var(--theme-color-accent);
    box-shadow: 0 0 24px color-mix(in srgb, var(--theme-color-secondary) 18%, transparent), 0 0 18px rgba(255, 77, 166, 0.12),
      inset 0 1px 0 color-mix(in srgb, var(--theme-color-text) 8%, transparent);
    transform: translateY(-1px) scale(1.05);
  }

  .footer__trust {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-radius: 1rem;
    background: rgba(2, 8, 20, 0.38);
    overflow: hidden;
  }

  .footer__trust-item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    min-height: 3.35rem;
    padding: 0.75rem 1rem;
    color: var(--theme-color-text-muted);
    font-size: calc(0.86rem * var(--body-scale, 1));
    font-weight: 600;
    transition: color var(--transition-base), background-color var(--transition-base);
  }

  .footer__trust-item:hover {
    color: var(--theme-color-text);
    background: color-mix(in srgb, var(--theme-color-text) 1.8%, transparent);
  }

  .footer__trust-item + .footer__trust-item {
    border-left: 1px solid color-mix(in srgb, var(--theme-color-text) 8%, transparent);
  }

  .footer__trust-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.76rem;
    height: 1.76rem;
    color: var(--theme-color-primary);
    transition: color var(--transition-base), filter var(--transition-base), transform var(--transition-base);
  }

  .footer__trust-icon svg {
    width: 1.52rem;
    height: 1.52rem;
  }

  .footer__trust-item:hover .footer__trust-icon {
    color: var(--theme-color-secondary);
    filter: drop-shadow(0 0 10px color-mix(in srgb, var(--theme-color-secondary) 20%, transparent));
    transform: translateY(-1px);
  }

  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--theme-color-text) 8%, transparent);
    color: var(--theme-color-text-soft);
    font-size: calc(0.82rem * var(--body-scale, 1));
  }

  .footer__payments {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.38rem;
  }

  .footer__payment-icon {
    width: 2.35rem;
    height: auto;
    padding: 0.18rem 0.28rem;
    border: 1px solid color-mix(in srgb, var(--theme-color-text) 8%, transparent);
    border-radius: 0.35rem;
    background: color-mix(in srgb, var(--theme-color-text) 5.5%, transparent);
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--theme-color-text) 4%, transparent);
  }

  .footer__payment-text,
  .footer__copyright {
    margin: 0;
  }

  @media (max-width: 860px) {
    .footer__top,
    .footer__navs,
    .footer__trust {
      grid-template-columns: 1fr;
    }

    .footer__trust-item {
      justify-content: flex-start;
    }

    .footer__trust-item + .footer__trust-item {
      border-left: 0;
      border-top: 1px solid color-mix(in srgb, var(--theme-color-text) 8%, transparent);
    }

    .footer__bottom {
      flex-direction: column;
    }
  }
{% endstylesheet %}

