{% liquid
  assign brand_text = section.settings.brand_text | default: shop.name
  assign has_primary_menu = false
  assign has_secondary_menu = false
  assign has_social_links = false

  if section.settings.primary_menu != blank
    for link in section.settings.primary_menu.links
      assign has_primary_menu = true
      break
    endfor
  endif

  if section.settings.secondary_menu != blank
    for link in section.settings.secondary_menu.links
      assign has_secondary_menu = true
      break
    endfor
  endif

  if section.settings.social_instagram != blank
    assign has_social_links = true
  endif

  if section.settings.social_facebook != blank
    assign has_social_links = true
  endif

  if section.settings.social_tiktok != blank
    assign has_social_links = true
  endif
-%}

<footer class="footer">
  <div class="container section footer__inner">
    <div class="footer__brand">
      <a class="footer__brand-link" href="{{ routes.root_url }}">
        {% if section.settings.logo != blank %}
          {{
            section.settings.logo
            | image_url: width: 400
            | image_tag: class: 'footer__logo', loading: 'lazy', alt: brand_text
          }}
        {% else %}
          <span class="footer__brand-text">{{ brand_text | escape }}</span>
        {% endif %}
      </a>

      {% if section.settings.text != blank %}
        <p class="footer__text">{{ section.settings.text | escape }}</p>
      {% endif %}

      <div class="footer__contact">
        {% if section.settings.contact_email != blank %}
          <a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a>
        {% endif %}
        {% if section.settings.contact_phone != blank %}
          <a href="tel:{{ section.settings.contact_phone | replace: ' ', '' }}">{{ section.settings.contact_phone }}</a>
        {% endif %}
        {% if section.settings.contact_info != blank %}
          <p>{{ section.settings.contact_info | escape }}</p>
        {% endif %}
      </div>

      {% if has_social_links %}
        <div class="footer__social footer__social--brand">
          {% if section.settings.social_instagram != blank %}
            <a class="footer__social-link" href="{{ section.settings.social_instagram }}">Instagram</a>
          {% endif %}
          {% if section.settings.social_facebook != blank %}
            <a class="footer__social-link" href="{{ section.settings.social_facebook }}">Facebook</a>
          {% endif %}
          {% if section.settings.social_tiktok != blank %}
            <a class="footer__social-link" href="{{ section.settings.social_tiktok }}">TikTok</a>
          {% endif %}
        </div>
      {% endif %}
    </div>

    {% if has_primary_menu %}
      <nav class="footer__menu" aria-label="Footer primary">
        <h2 class="footer__heading">Browse</h2>
        {% for link in section.settings.primary_menu.links %}
          <a class="footer__link" href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      </nav>
    {% endif %}

    <div class="footer__meta">
      {% if has_secondary_menu %}
        <nav class="footer__menu" aria-label="Footer secondary">
          <h2 class="footer__heading">Help</h2>
          {% for link in section.settings.secondary_menu.links %}
            <a class="footer__link" href="{{ link.url }}">{{ link.title }}</a>
          {% endfor %}
        </nav>
      {% endif %}

      {% if shop.privacy_policy or shop.refund_policy or shop.shipping_policy or shop.terms_of_service %}
        <div class="footer__policies">
          <h2 class="footer__heading">Policies</h2>
          {% if shop.privacy_policy != blank %}
            <a class="footer__link" href="{{ shop.privacy_policy.url }}">Privacy policy</a>
          {% endif %}
          {% if shop.refund_policy != blank %}
            <a class="footer__link" href="{{ shop.refund_policy.url }}">Refund policy</a>
          {% endif %}
          {% if shop.shipping_policy != blank %}
            <a class="footer__link" href="{{ shop.shipping_policy.url }}">Shipping policy</a>
          {% endif %}
          {% if shop.terms_of_service != blank %}
            <a class="footer__link" href="{{ shop.terms_of_service.url }}">Terms of service</a>
          {% endif %}
        </div>
      {% endif %}

      <p class="footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
    </div>
  </div>
</footer>

{% stylesheet %}
  .footer {
    display: grid;
    border-top: 1px solid var(--theme-color-border);
    background: linear-gradient(180deg, rgba(2, 8, 20, 0.74), rgba(2, 8, 20, 0.96));
  }

  .footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
  }

  .footer__brand,
  .footer__menu,
  .footer__meta,
  .footer__policies,
  .footer__social,
  .footer__contact {
    display: grid;
    gap: 0.75rem;
  }

  .footer__brand-link,
  .footer__link {
    color: inherit;
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .footer__link:hover,
  .footer__brand-link:hover,
  .footer__contact a:hover,
  .footer__social-link:hover {
    color: var(--theme-color-secondary);
  }

  .footer__brand {
    max-width: 28rem;
  }

  .footer__brand-text {
    font-family: var(--theme-font-display);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .footer__logo {
    display: block;
    max-width: 180px;
    width: auto;
    height: auto;
  }

  .footer__text,
  .footer__contact p {
    color: var(--theme-color-text-muted);
    line-height: 1.6;
  }

  .footer__contact,
  .footer__contact a {
    color: var(--theme-color-text-muted);
    font-size: 0.95rem;
  }

  .footer__heading {
    margin: 0;
    color: var(--theme-color-text-soft);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .footer__menu,
  .footer__policies {
    align-content: start;
  }

  .footer__link {
    color: var(--theme-color-text-muted);
    font-size: 0.95rem;
  }

  .footer__social--brand {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .footer__social-link {
    border: 1px solid var(--theme-color-border);
    border-radius: var(--theme-radius-pill);
    background: rgba(255, 255, 255, 0.04);
    color: var(--theme-color-text-muted);
    padding: 0.35rem 0.7rem;
    font-size: 0.78rem;
    text-decoration: none;
  }

  .footer__copyright {
    margin-top: 0.5rem;
    color: var(--theme-color-text-soft);
    font-size: 0.85rem;
  }

  @media (max-width: 860px) {
    .footer__inner {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand text",
      "default": "Store name"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Use this footer area for store information, support details, and policy links."
    },
    {
      "type": "link_list",
      "id": "primary_menu",
      "label": "Primary menu"
    },
    {
      "type": "link_list",
      "id": "secondary_menu",
      "label": "Secondary menu"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact email"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Contact phone"
    },
    {
      "type": "textarea",
      "id": "contact_info",
      "label": "Contact details"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok URL"
    }
  ]
}
{% endschema %}
