{% comment %}
  This section is used in the search template to render search results for
  products, articles, and pages.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/search
{% endcomment %}

<section class="container section search">
  <div class="search__header">
    <h1 class="search__title">{{ 'search.title' | t }}</h1>

    <form class="search__form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="Search-In-Section-{{ section.id }}">{{ 'search.title' | t }}</label>
      <input
        id="Search-In-Section-{{ section.id }}"
        class="field"
        type="search"
        size="50"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'search.placeholder' | t }}"
      >
      <button class="button" type="submit">{{ 'search.submit' | t }}</button>
    </form>
  </div>

  {% if search.performed %}
    {% if search.results_count == 0 %}
      <p class="search__empty">{{ 'search.no_results_html' | t: terms: search.terms }}</p>
    {% else %}
      <p class="search__summary">{{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}</p>

      {% paginate search.results by 20 %}
        <div class="search__results grid grid--4">
          {% for result in search.results %}
            {% if result.object_type == 'product' %}
              {% render 'product-card', product: result %}
            {% else %}
              {% assign featured_image = result.featured_image | default: result.image %}
              <article class="search-result card">
                <a class="search-result__link" href="{{ result.url }}">
                  <div class="search-result__media card__media">
                    {% render 'responsive-image',
                      image: featured_image,
                      alt: result.title,
                      class: 'search-result__image',
                      loading: 'lazy',
                      sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw',
                      widths: '240, 360, 540, 720'
                    %}
                  </div>

                  <div class="search-result__content card__content">
                    <p class="search-result__type">{{ result.object_type | capitalize }}</p>
                    <h2 class="search-result__title">{{ result.title | escape }}</h2>

                    {% if result.price %}
                      <p class="search-result__price">{% render 'price', amount: result.price, show_currency: true %}</p>
                    {% endif %}
                  </div>
                </a>
              </article>
            {% endif %}
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <div class="search__pagination">
            {{ paginate | default_pagination }}
          </div>
        {% endif %}
      {% endpaginate %}
    {% endif %}
  {% endif %}
</section>

{% stylesheet %}
  .search {
    display: grid;
    gap: 1.5rem;
  }

  .search__header {
    display: grid;
    gap: 1rem;
  }

  .search__title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }

  .search__form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem;
    max-width: 40rem;
  }

  .search__summary,
  .search__empty,
  .search-result__type,
  .search-result__price {
    color: var(--color-muted);
  }

  .search-result__link {
    display: grid;
    gap: 1rem;
    color: inherit;
    text-decoration: none;
  }

  .search-result__media {
    aspect-ratio: 4 / 5;
  }

  .search-result__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .search-result__title {
    margin: 0;
    font-size: 1rem;
    line-height: 1.35;
  }

  .search__pagination {
    margin-top: 2rem;
  }

  @media (max-width: 749px) {
    .search__form {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "settings": []
}
{% endschema %}
