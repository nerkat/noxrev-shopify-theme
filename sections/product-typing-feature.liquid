{% liquid
  assign feature_image = section.settings.image | default: product.featured_media.preview_image
%}

<section class="product-typing-feature section">
  <div class="container">
    <article class="product-typing-feature__panel">
      <div class="product-typing-feature__copy">
        <p class="product-typing-feature__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="product-typing-feature__title">{{ section.settings.title }}</h2>
        <p class="product-typing-feature__text">{{ section.settings.text }}</p>

        <div class="product-typing-feature__icons" role="list">
          {% for block in section.blocks %}
            <div class="product-typing-feature__icon-item" role="listitem" {{ block.shopify_attributes }}>
              <span class="product-typing-feature__icon" aria-hidden="true">
                {% if block.settings.icon_image != blank %}
                  {{ block.settings.icon_image | image_url: width: 64 | image_tag: loading: 'lazy', alt: '', class: 'product-typing-feature__icon-image' }}
                {% else %}
                  {% render 'product-marketing-icon', icon: block.settings.icon %}
                {% endif %}
              </span>
              <span>{{ block.settings.label }}</span>
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="product-typing-feature__media">
        {% if feature_image != blank %}
          {% render 'responsive-image',
            image: feature_image,
            alt: section.settings.image_alt,
            class: 'product-typing-feature__image',
            loading: 'lazy',
            sizes: '(min-width: 900px) 52vw, 100vw',
            widths: '420, 640, 860, 1100, 1400'
          %}
        {% else %}
          <div class="product-typing-feature__placeholder" aria-hidden="true"></div>
        {% endif %}
      </div>
    </article>
  </div>
</section>

{% stylesheet %}
  .product-typing-feature {
    padding: 0 0 1rem;
  }

  .product-typing-feature__panel {
    position: relative;
    min-height: 24rem;
    overflow: hidden;
    border-radius: 1rem;
    background: rgba(4, 13, 25, 0.94);
  }

  .product-typing-feature__panel::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.9) 0%, rgba(2, 8, 18, 0.76) 42%, rgba(2, 8, 18, 0.18) 72%, rgba(2, 8, 18, 0) 100%),
      radial-gradient(circle at 18% 20%, rgba(0, 229, 255, 0.12), transparent 34%);
  }

  .product-typing-feature__copy {
    position: relative;
    z-index: 2;
    max-width: 29rem;
    padding: 1.2rem;
  }

  .product-typing-feature__eyebrow,
  .product-typing-feature__title {
    margin: 0;
    background: linear-gradient(90deg, #24e5ff, #d96dff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .product-typing-feature__eyebrow {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .product-typing-feature__title {
    margin-top: 0.65rem;
    font-family: var(--theme-font-display);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.08;
  }

  .product-typing-feature__text {
    max-width: 28rem;
    margin: 0.8rem 0 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.93rem;
    line-height: 1.55;
  }

  .product-typing-feature__icons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.2rem;
  }

  .product-typing-feature__icon-item {
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    max-width: 5rem;
    color: rgba(255, 255, 255, 0.84);
    font-size: 0.72rem;
    line-height: 1.2;
    text-align: center;
  }

  .product-typing-feature__icon {
    display: inline-flex;
    width: 2.45rem;
    height: 2.45rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(0, 229, 255, 0.28);
    border-radius: 0.75rem;
    color: #27efff;
    background: rgba(2, 11, 23, 0.72);
  }

  .product-typing-feature__icon svg,
  .product-typing-feature__icon-image {
    width: 1.2rem;
    height: 1.2rem;
    object-fit: contain;
  }

  .product-typing-feature__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .product-typing-feature__image,
  .product-typing-feature__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-typing-feature__placeholder {
    background: linear-gradient(135deg, rgba(0, 229, 255, 0.16), rgba(214, 101, 255, 0.1));
  }

  @media (min-width: 900px) {
    .product-typing-feature__panel {
      min-height: 24rem;
    }

    .product-typing-feature__copy {
      padding: 2rem;
    }
  }

  @media (max-width: 860px) {
    .product-typing-feature__panel::after {
      background:
        linear-gradient(
          149deg,
          rgba(0, 0, 0, 0.9) 0%,
          rgba(2, 8, 18, 0.76) 55%,
          rgba(2, 8, 18, 0.18) 72%,
          rgba(2, 8, 18, 0) 100%
        ),
        radial-gradient(circle at 18% 20%, rgba(0, 229, 255, 0.12), transparent 34%);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP Typing Feature",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Next-Gen Typing Experience" },
    { "type": "text", "id": "title", "label": "Title", "default": "Built For Speed, Accuracy, And Comfort." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Scissor-switch keys, responsive tracking pad, and smart gestures built for speed, accuracy, and comfort." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Hands typing on keyboard case" }
  ],
  "blocks": [
    {
      "type": "feature_icon",
      "name": "Feature icon",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Scissor-Switch Keys" },
        { "type": "select", "id": "icon", "label": "Fallback icon", "default": "keyboard", "options": [
          { "value": "keyboard", "label": "Keyboard" },
          { "value": "trackpad", "label": "Trackpad" },
          { "value": "tap", "label": "Tap" },
          { "value": "swipe", "label": "Swipe" }
        ] },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP Typing Feature",
      "blocks": [
        { "type": "feature_icon", "settings": { "label": "Scissor-Switch Keys", "icon": "keyboard" } },
        { "type": "feature_icon", "settings": { "label": "Large Precision Trackpad", "icon": "trackpad" } },
        { "type": "feature_icon", "settings": { "label": "Multi-Touch Gestures", "icon": "tap" } },
        { "type": "feature_icon", "settings": { "label": "Backlit Keyboard", "icon": "keyboard" } }
      ]
    }
  ]
}
{% endschema %}
