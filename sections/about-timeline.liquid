{% render 'section-layout', section: section %}
{{ 'about-noxrev.css' | asset_url | stylesheet_tag }}

<section class="about-noxrev about-noxrev--tight">
  <div class="container">
    <div class="about-noxrev__card">
      <p class="about-noxrev__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="about-noxrev__heading">{{ section.settings.heading }}</h2>
      <div class="about-noxrev__timeline">
        {% for block in section.blocks %}
          <article class="about-noxrev__timeline-item" {{ block.shopify_attributes }}>
            <p class="about-noxrev__kicker">{{ forloop.index | prepend: '0' }}</p>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About timeline",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "PROCESS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From idea to everyday tool."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_width",
      "label": "Content width",
      "options": [
        {
          "value": "inherit",
          "label": "Current width"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "layout_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "inherit",
          "label": "Current alignment"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "checkbox",
      "id": "custom_spacing",
      "label": "Use custom section spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top spacing mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom spacing mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "checkbox",
      "id": "use_section_scheme",
      "label": "Use section color scheme",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "device_visibility",
      "label": "Device visibility",
      "options": [
        {
          "value": "both",
          "label": "Both"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        }
      ],
      "default": "both"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Timeline item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Idea"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "A focused problem becomes a sharper product direction."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About timeline",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Idea"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Prototype"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Testing"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Launch"
          }
        }
      ]
    }
  ]
}
{% endschema %}

