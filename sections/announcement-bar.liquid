{% style %}#shopify-section-{{ section.id }} .announcement-bar__inner{justify-content:{% case section.settings.alignment %}{% when 'center' %}center{% when 'right' %}flex-end{% else %}space-between{% endcase %}}{% endstyle %}
{% liquid
assign announcement_text = section.settings.text
assign announcement_link = section.settings.link
if section.settings.use_shared_shipping
assign announcement_text = settings.global_shipping_trust_text
assign announcement_link = settings.global_shipping_link
if localization.country.iso_code != 'US' and settings.global_shipping_international != blank
assign announcement_text = settings.global_shipping_international
endif
endif
%}
{% if announcement_text != blank %}
  <div class="announcement-bar{% if section.settings.use_section_scheme %} color-{{ section.settings.color_scheme }}{% endif %}{% if section.settings.show_secondary_on_mobile and section.settings.secondary_text != blank %} announcement-bar--secondary-mobile{% endif %}">
    <div class="announcement-bar__inner container">
      <div class="announcement-bar__primary">
        {% if announcement_link != blank %}
          <a class="announcement-bar__link" href="{{ announcement_link }}">
            <span class="announcement-bar__dot"></span>
            <span>{{ announcement_text | escape }}</span>
          </a>
        {% else %}
          <p class="announcement-bar__text">
            <span class="announcement-bar__dot"></span>
            <span>{{ announcement_text | escape }}</span>
          </p>
        {% endif %}
      </div>

      {% if section.settings.secondary_text != blank %}
        {% if section.settings.secondary_link != blank %}
          <a class="announcement-bar__secondary" href="{{ section.settings.secondary_link }}">
            {{ section.settings.secondary_text | escape }}
          </a>
        {% else %}
          <p class="announcement-bar__secondary">{{ section.settings.secondary_text | escape }}</p>
        {% endif %}
      {% endif %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  body:not(.template-index) .announcement-bar {
    display: none;
  }

  .announcement-bar {
    --announcement-height: 2.7rem;
    position: relative;
    top: auto;
    z-index: auto;
    border-bottom: 1px solid color-mix(in srgb, var(--theme-color-text) 8%, transparent);
    background: transparent;
    color: var(--theme-color-text-muted);
    backdrop-filter: blur(0);
    -webkit-backdrop-filter: blur(0);
    transition: background-color 220ms ease, border-color 220ms ease, backdrop-filter 220ms ease,
      -webkit-backdrop-filter 220ms ease;
  }

  .site-header-shell.is-scrolled .announcement-bar {
    background: transparent;
  }

  .announcement-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--announcement-height);
    padding-block: 0.5rem;
  }

  .announcement-bar__primary {
    display: flex;
    justify-content: center;
    min-width: 0;
  }

  .announcement-bar__link,
  .announcement-bar__text {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    margin: 0;
    max-width: 100%;
    padding: 0;
    color: inherit;
    font-size: calc(0.69rem * var(--body-scale, 1));
    font-weight: 600;
    letter-spacing: 0.28em;
    line-height: 1.3;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
  }

  .announcement-bar__secondary {
    margin: 0;
    color: var(--theme-color-text-soft);
    font-size: calc(0.69rem * var(--body-scale, 1));
    font-weight: 600;
    letter-spacing: 0.28em;
    line-height: 1.3;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color var(--transition-base);
  }

  a.announcement-bar__secondary:hover {
    color: var(--theme-color-secondary);
  }

  .announcement-bar__dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--theme-color-primary);
    box-shadow: 0 0 14px color-mix(in srgb, var(--theme-color-primary) 65%, transparent);
    flex: 0 0 auto;
  }

  @media (max-width: 749px) {
    .announcement-bar__inner {
      justify-content: center;
      min-height: 0;
    }

    .announcement-bar--secondary-mobile .announcement-bar__inner {
      flex-direction: column;
      gap: 0.35rem;
    }

    .announcement-bar__link,
    .announcement-bar__text {
      letter-spacing: 0.16em;
    }

    .announcement-bar__secondary {
      display: none;
    }

    .announcement-bar--secondary-mobile .announcement-bar__secondary {
      display: block;
      white-space: normal;
      text-align: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Free standard shipping on orders over $100"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "secondary_text",
      "label": "Secondary text",
      "default": "Track order"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_on_mobile",
      "label": "Show secondary message on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "use_shared_shipping",
      "label": "Use shared shipping promise",
      "default": true
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "use_section_scheme",
      "label": "Use color scheme",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}

