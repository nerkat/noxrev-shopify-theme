{% if section.settings.text != blank %}
  <div class="announcement-bar">
    <div class="container announcement-bar__inner">
      {% if section.settings.link != blank %}
        <a class="announcement-bar__link" href="{{ section.settings.link }}">
          <span class="announcement-bar__dot"></span>
          <span>{{ section.settings.text | escape }}</span>
        </a>
      {% else %}
        <p class="announcement-bar__text">
          <span class="announcement-bar__dot"></span>
          <span>{{ section.settings.text | escape }}</span>
        </p>
      {% endif %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .announcement-bar {
    border-bottom: 1px solid var(--theme-color-border);
    background: rgba(4, 11, 24, 0.78);
    color: var(--theme-color-text-muted);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .announcement-bar__inner {
    display: flex;
    justify-content: center;
    padding-block: 0.6rem;
  }

  .announcement-bar__link,
  .announcement-bar__text {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    margin: 0;
    max-width: 100%;
    border: 1px solid var(--theme-color-border);
    border-radius: var(--theme-radius-pill);
    background: rgba(255, 255, 255, 0.04);
    padding: 0.45rem 0.9rem;
    color: inherit;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    line-height: 1.3;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .announcement-bar__dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--theme-color-primary);
    box-shadow: 0 0 14px rgba(0, 255, 176, 0.65);
    flex: 0 0 auto;
  }

  @media (max-width: 749px) {
    .announcement-bar__link,
    .announcement-bar__text {
      letter-spacing: 0.1em;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Free standard shipping on orders over $100"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ]
}
{% endschema %}
