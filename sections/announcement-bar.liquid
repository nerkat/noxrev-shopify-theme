{% if section.settings.text != blank %}
  <div class="announcement-bar">
    {% if section.settings.link != blank %}
      <a class="announcement-bar__link" href="{{ section.settings.link }}">
        {{ section.settings.text | escape }}
      </a>
    {% else %}
      <p class="announcement-bar__text">{{ section.settings.text | escape }}</p>
    {% endif %}
  </div>
{% endif %}

{% stylesheet %}
  .announcement-bar {
    background: #111111;
    color: #ffffff;
    padding: 0.75rem 0;
    text-align: center;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
  }

  .announcement-bar__link,
  .announcement-bar__text {
    color: inherit;
    text-decoration: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Free standard shipping on orders over $100"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ]
}
{% endschema %}