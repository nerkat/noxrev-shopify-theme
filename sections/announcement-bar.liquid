{% if section.settings.text != blank %}
  <div class="announcement-bar">
    <div class="announcement-bar__inner container">
      <div class="announcement-bar__primary">
        {% if section.settings.link != blank %}
          <a class="announcement-bar__link" href="{{ section.settings.link }}">
            <span class="announcement-bar__dot"></span>
            <span>{{ section.settings.text | escape }}</span>
          </a>
        {% else %}
          <p class="announcement-bar__text">
            <span class="announcement-bar__dot"></span>
            <span>{{ section.settings.text | escape }}</span>
          </p>
        {% endif %}
      </div>

      {% if section.settings.secondary_text != blank %}
        {% if section.settings.secondary_link != blank %}
          <a class="announcement-bar__secondary" href="{{ section.settings.secondary_link }}">
            {{ section.settings.secondary_text | escape }}
          </a>
        {% else %}
          <p class="announcement-bar__secondary">{{ section.settings.secondary_text | escape }}</p>
        {% endif %}
      {% endif %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .announcement-bar {
    --announcement-height: 2.7rem;
    position: relative;
    top: auto;
    z-index: auto;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: transparent;
    color: var(--theme-color-text-muted);
    backdrop-filter: blur(0);
    -webkit-backdrop-filter: blur(0);
    transition: background-color 220ms ease, border-color 220ms ease, backdrop-filter 220ms ease,
      -webkit-backdrop-filter 220ms ease;
  }

  .site-header-shell.is-scrolled .announcement-bar {
    background: transparent;
  }

  .announcement-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--announcement-height);
    padding-block: 0.5rem;
  }

  .announcement-bar__primary {
    display: flex;
    justify-content: center;
    min-width: 0;
  }

  .announcement-bar__link,
  .announcement-bar__text {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    margin: 0;
    max-width: 100%;
    padding: 0;
    color: inherit;
    font-size: 0.69rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    line-height: 1.3;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
  }

  .announcement-bar__secondary {
    margin: 0;
    color: var(--theme-color-text-soft);
    font-size: 0.69rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    line-height: 1.3;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color var(--transition-base);
  }

  a.announcement-bar__secondary:hover {
    color: var(--theme-color-secondary);
  }

  .announcement-bar__dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--theme-color-primary);
    box-shadow: 0 0 14px rgba(0, 255, 176, 0.65);
    flex: 0 0 auto;
  }

  @media (max-width: 749px) {
    .announcement-bar__inner {
      justify-content: center;
      min-height: 0;
    }

    .announcement-bar__link,
    .announcement-bar__text {
      letter-spacing: 0.16em;
    }

    .announcement-bar__secondary {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Free standard shipping on orders over $100"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "secondary_text",
      "label": "Secondary text",
      "default": "Track order"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link"
    }
  ]
}
{% endschema %}
