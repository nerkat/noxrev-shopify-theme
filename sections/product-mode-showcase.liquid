{% style %}{% unless section.settings.layout_media_fit == 'inherit' %}#shopify-section-{{ section.id }} .product-mode-showcase__media img{object-fit:{{ section.settings.layout_media_fit }}}{% endunless %}{% unless section.settings.layout_media_ratio == 'inherit' %}#shopify-section-{{ section.id }} .product-mode-showcase__media img{aspect-ratio:{{ section.settings.layout_media_ratio }};height:auto}{% endunless %}@media(min-width:750px){ {% unless section.settings.layout_media_order == 'inherit' %}#shopify-section-{{ section.id }} .product-mode-showcase__media{order:{% if section.settings.layout_media_order == 'first' %}-1{% else %}10{% endif %}}{% endunless %}}@media(max-width:749px){ {% unless section.settings.layout_media_order_mobile == 'inherit' %}#shopify-section-{{ section.id }} .product-mode-showcase__media{order:{% if section.settings.layout_media_order_mobile == 'first' %}-1{% else %}10{% endif %}}{% endunless %}}{% endstyle %}
{% render 'section-layout', section: section %}
{% liquid
  assign showcase_image = section.settings.image | default: product.featured_media.preview_image
%}

<section class="product-mode-showcase section">
  <div class="container">
    <article class="product-mode-showcase__panel">
      <div class="product-mode-showcase__copy">
        <p class="product-mode-showcase__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="product-mode-showcase__title">{{ section.settings.title }}</h2>
        <p class="product-mode-showcase__text">{{ section.settings.text }}</p>

        <div class="product-mode-showcase__chips" role="list">
          {% for block in section.blocks %}
            <div class="product-mode-showcase__chip" role="listitem" {{ block.shopify_attributes }}>
              <span class="product-mode-showcase__icon" aria-hidden="true">
                {% if block.settings.icon_image != blank %}
                  {{
                    block.settings.icon_image
                    | image_url: width: 64
                    | image_tag: loading: 'lazy', alt: '', class: 'product-mode-showcase__icon-image'
                  }}
                {% else %}
                  {% render 'product-marketing-icon', icon: block.settings.icon %}
                {% endif %}
              </span>
              <span>{{ block.settings.label }}</span>
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="product-mode-showcase__media">
        {% if showcase_image != blank %}
          {% assign showcase_image_alt = section.settings.image_alt | default: section.settings.title %}
          {% render 'responsive-image',
            image: showcase_image,
            alt: showcase_image_alt,
            class: 'product-mode-showcase__image',
            loading: 'lazy',
            sizes: '(min-width: 900px) 58vw, 55vw',
            widths: '360, 520, 720, 960, 1200'
          %}
        {% else %}
          <div class="product-mode-showcase__placeholder" aria-hidden="true"></div>
        {% endif %}
      </div>
    </article>
  </div>
</section>



{% schema %}
{
  "name": "Product Mode Showcase",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Designed For Every Mode"
