{% liquid
  assign showcase_image = section.settings.image | default: product.featured_media.preview_image
%}

<section class="product-mode-showcase section">
  <div class="container">
    <article class="product-mode-showcase__panel">
      <div class="product-mode-showcase__copy">
        <p class="product-mode-showcase__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="product-mode-showcase__title">{{ section.settings.title }}</h2>
        <p class="product-mode-showcase__text">{{ section.settings.text }}</p>

        <div class="product-mode-showcase__chips" role="list">
          {% for block in section.blocks %}
            <div class="product-mode-showcase__chip" role="listitem" {{ block.shopify_attributes }}>
              <span class="product-mode-showcase__icon" aria-hidden="true">
                {% if block.settings.icon_image != blank %}
                  {{
                    block.settings.icon_image
                    | image_url: width: 64
                    | image_tag: loading: 'lazy', alt: '', class: 'product-mode-showcase__icon-image'
                  }}
                {% else %}
                  {% render 'product-marketing-icon', icon: block.settings.icon %}
                {% endif %}
              </span>
              <span>{{ block.settings.label }}</span>
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="product-mode-showcase__media">
        {% if showcase_image != blank %}
          {% render 'responsive-image',
            image: showcase_image,
            alt: section.settings.image_alt,
            class: 'product-mode-showcase__image',
            loading: 'lazy',
            sizes: '(min-width: 900px) 58vw, 100vw',
            widths: '420, 640, 860, 1100, 1400'
          %}
        {% else %}
          <div class="product-mode-showcase__placeholder" aria-hidden="true"></div>
        {% endif %}
      </div>
    </article>
  </div>
</section>

{% stylesheet %}
  .product-mode-showcase {
    padding: 0 0 1rem;
  }

  .product-mode-showcase__panel {
    position: relative;
    min-height: 28rem;
    overflow: hidden;
    border-radius: 1.25rem;
    background: rgba(4, 13, 25, 0.94);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04), 0 18px 42px rgba(0, 0, 0, 0.18);
  }

  .product-mode-showcase__panel::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.9) 0%,
        rgba(2, 8, 18, 0.74) 38%,
        rgba(2, 8, 18, 0.14) 72%,
        rgba(2, 8, 18, 0) 100%
      ),
      radial-gradient(circle at 16% 16%, rgba(0, 229, 255, 0.13), transparent 32%);
  }

  .product-mode-showcase__copy {
    position: relative;
    z-index: 2;
    max-width: 31rem;
    padding: 1.25rem;
  }

  .product-mode-showcase__eyebrow {
    margin: 0 0 0.8rem;
    background: linear-gradient(285deg, #22e2ff, #d778ff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .product-mode-showcase__title {
    margin: 0;
    color: var(--theme-color-text);
    font-family: var(--theme-font-display);
    font-size: 2rem;
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: 0;
  }

  .product-mode-showcase__text {
    max-width: 28rem;
    margin: 0.9rem 0 0;
    color: rgba(255, 255, 255, 0.76);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .product-mode-showcase__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.95rem;
    margin-top: 1.35rem;
  }

  .product-mode-showcase__chip {
    display: grid;
    justify-items: center;
    gap: 0.45rem;
    color: var(--theme-color-text);
    font-size: 0.84rem;
    text-align: center;
  }

  .product-mode-showcase__icon {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(0, 229, 255, 0.42);
    border-radius: 999px;
    color: #27efff;
    background: rgba(3, 12, 24, 0.64);
  }

  .product-mode-showcase__icon svg,
  .product-mode-showcase__icon-image {
    width: 1.25rem;
    height: 1.25rem;
    object-fit: contain;
  }

  .product-mode-showcase__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .product-mode-showcase__image,
  .product-mode-showcase__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 0% 15%;
  }

  .product-mode-showcase__placeholder {
    background: linear-gradient(135deg, rgba(0, 229, 255, 0.16), rgba(214, 101, 255, 0.1));
  }

  @media (min-width: 900px) {
    .product-mode-showcase__panel {
      min-height: 26rem;
    }

    .product-mode-showcase__copy {
      padding: 2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product Mode Showcase",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Designed For Every Mode" },
    { "type": "text", "id": "title", "label": "Title", "default": "One Case. Every Angle. Endless Possibilities." },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Rotate, flip, and adjust with ease. Whether you're working, creating, or streaming, find the perfect angle for every task."
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Keyboard case shown in multiple modes" }
  ],
  "blocks": [
    {
      "type": "mode_chip",
      "name": "Mode chip",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Type" },
        {
          "type": "select",
          "id": "icon",
          "label": "Fallback icon",
          "default": "type",
          "options": [
            { "value": "type", "label": "Type" },
            { "value": "draw", "label": "Draw" },
            { "value": "watch", "label": "Watch" },
            { "value": "present", "label": "Present" }
          ]
        },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Mode Showcase",
      "blocks": [
        { "type": "mode_chip", "settings": { "label": "Type", "icon": "type" } },
        { "type": "mode_chip", "settings": { "label": "Draw", "icon": "draw" } },
        { "type": "mode_chip", "settings": { "label": "Watch", "icon": "watch" } },
        { "type": "mode_chip", "settings": { "label": "Present", "icon": "present" } }
      ]
    }
  ]
}
{% endschema %}
