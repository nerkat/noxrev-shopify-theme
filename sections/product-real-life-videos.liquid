{% style %}{% unless section.settings.layout_media_fit == 'inherit' %}#shopify-section-{{ section.id }} .product-real-life-videos__media img{object-fit:{{ section.settings.layout_media_fit }}}{% endunless %}{% unless section.settings.layout_media_ratio == 'inherit' %}#shopify-section-{{ section.id }} .product-real-life-videos__media img{aspect-ratio:{{ section.settings.layout_media_ratio }};height:auto}{% endunless %}@media(min-width:750px){ {% unless section.settings.layout_media_order == 'inherit' %}#shopify-section-{{ section.id }} .product-real-life-videos__media{order:{% if section.settings.layout_media_order == 'first' %}-1{% else %}10{% endif %}}{% endunless %}}@media(max-width:749px){ {% unless section.settings.layout_media_order_mobile == 'inherit' %}#shopify-section-{{ section.id }} .product-real-life-videos__media{order:{% if section.settings.layout_media_order_mobile == 'first' %}-1{% else %}10{% endif %}}{% endunless %}}{% endstyle %}
{% render 'section-layout', section: section %}
<section
  class="product-real-life-videos section"
  style="--product-real-life-video-fit: {{ section.settings.video_fit | default: 'cover' }};"
>
  <article class="product-real-life-videos__panel" data-real-life-videos data-autoplay="{{ section.settings.video_autoplay }}" data-video-layout="{{ section.settings.video_layout }}" style="--video-columns:{{ section.settings.video_columns }};--video-ratio:{{ section.settings.video_ratio }}">
    <div class="product-real-life-videos__header container">
      <div class="product-real-life-videos__copy">
        <p class="product-real-life-videos__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="product-real-life-videos__title">{{ section.settings.title }}</h2>
        <p class="product-real-life-videos__text">{{ section.settings.text }}</p>
      </div>

      {% if section.settings.stat_text != blank and section.settings.show_social_proof %}
        <div class="product-real-life-videos__stat">
          <span class="product-real-life-videos__stat-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" focusable="false">
              <path d="M16 19v-1.4a3.6 3.6 0 0 0-3.6-3.6H7.6A3.6 3.6 0 0 0 4 17.6V19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <circle cx="10" cy="7" r="3" stroke="currentColor" stroke-width="1.8"/>
              <path d="M20 19v-1.2a3.2 3.2 0 0 0-2.4-3.1M16 4.2a3 3 0 0 1 0 5.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </span>
          <span>{{ section.settings.stat_text }}</span>
          <span aria-hidden="true">-></span>
        </div>
      {% endif %}
    </div>

    <div
      class="product-real-life-videos__slider-wrap noxrev-slider"
      data-noxrev-slider
      data-noxrev-slider-step-card=".product-real-life-videos__card"
    >
      <div class="product-real-life-videos__slider" data-noxrev-slider-track>
        {% for block in section.blocks %}
          {% liquid
            assign poster_image = block.settings.poster | default: product.featured_media.preview_image
            assign video_poster_image = block.settings.poster | default: block.settings.video.preview_image
            assign video_accessible_label = block.settings.poster_alt | default: block.settings.title | default: 'Product demonstration video'
          %}
          <article class="product-real-life-videos__card" {{ block.shopify_attributes }}>
            <div class="product-real-life-videos__media">
              {% if block.settings.video != blank %}
                <div class="product-real-life-videos__video-shell" data-real-life-video-shell>
                  <video
                    class="product-real-life-videos__video"
                    aria-label="{{ video_accessible_label | escape }}"
                    {% if video_poster_image != blank %}
                      data-poster-src="{{ video_poster_image | image_url: width: 420 }}"
                    {% endif %}
                    playsinline
                    {% if section.settings.video_muted or section.settings.video_autoplay %}muted{% endif %}
                    {% if section.settings.video_loop %}loop{% endif %}
                    {% if section.settings.video_controls %}controls{% endif %}
                    preload="none"
                  >
                    {% for source in block.settings.video.sources %}
                      <source src="{{ source.url }}" type="{{ source.mime_type }}">
                    {% endfor %}
                  </video>
                  <button
                    class="product-real-life-videos__play product-real-life-videos__play--video"
                    type="button"
                    aria-label="Play video"
                    aria-pressed="false"
                    data-real-life-video-toggle
                  >
                    <svg viewBox="0 0 24 24" fill="none" focusable="false">
                      <path d="M9 7.5v9l7-4.5-7-4.5Z" fill="currentColor"/>
                    </svg>
                  </button>
                </div>
              {% elsif poster_image != blank %}
                {% assign poster_image_alt = block.settings.poster_alt | default: block.settings.title %}
                {% render 'responsive-image',
                  image: poster_image,
                  alt: poster_image_alt,
                  class: 'product-real-life-videos__image',
                  loading: 'lazy',
                  sizes: '(min-width: 900px) 18vw, 72vw',
                  widths: '260, 420, 620, 760'
                %}
              {% else %}
                <div class="product-real-life-videos__placeholder" aria-hidden="true"></div>
              {% endif %}
            </div>

            <div class="product-real-life-videos__card-copy">
              <div>
                <h3 class="product-real-life-videos__card-title">{{ block.settings.title }}</h3>
                <p class="product-real-life-videos__card-text">{{ block.settings.text }}</p>
              </div>
              {% if block.settings.duration != blank and section.settings.show_duration %}
                <span class="product-real-life-videos__duration">{{ block.settings.duration }}</span>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>

      <button
        class="product-real-life-videos__arrow noxrev-slider__arrow noxrev-slider__arrow--prev"
        type="button"
        aria-label="Previous videos"
        data-noxrev-slider-prev
        hidden
      >
        <span aria-hidden="true">&lsaquo;</span>
      </button>
      <button
        class="product-real-life-videos__arrow noxrev-slider__arrow noxrev-slider__arrow--next"
        type="button"
        aria-label="Next videos"
        data-noxrev-slider-next
        hidden
      >
        <span aria-hidden="true">&rsaquo;</span>
      </button>
    </div>

    {% if section.settings.cta_label != blank and section.settings.cta_url != blank and section.settings.cta_url != '#' %}
      <div class="product-real-life-videos__footer">
        <a class="product-real-life-videos__cta" href="{{ section.settings.cta_url }}">
          <span>{{ section.settings.cta_label }}</span>
          <span class="product-real-life-videos__cta-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" focusable="false">
              <path d="M9 7.5v9l7-4.5-7-4.5Z" fill="currentColor"/>
            </svg>
          </span>
        </a>
      </div>
    {% endif %}
  </article>
</section>

{% javascript %}
  (() => {
    const instances = new WeakMap();
    document.addEventListener('shopify:block:select',event=>{
      const card=event.target.closest?.('.product-real-life-videos__card');
      if(card){card.scrollIntoView({block:'nearest',inline:'center'});card.closest('[data-real-life-videos]')?.querySelectorAll('video').forEach(v=>v.pause());}
    });

    const initializeSection = (section) => {
      if (!section || instances.has(section)) return;
      const controller = new AbortController();

      if (section.dataset.autoplay === 'true' && !window.Shopify?.designMode && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.muted=true;entry.target.play().catch(()=>{})}else entry.target.pause()}),{threshold:.6});
        section.querySelectorAll('video').forEach(v=>observer.observe(v));
        controller.signal.addEventListener('abort',()=>observer.disconnect(),{once:true});
      }
      const videoShells = section.querySelectorAll('[data-real-life-video-shell]');
      const loadPoster = (video) => {
        const posterUrl = video.dataset.posterSrc;
        if (!posterUrl) return;

        video.poster = posterUrl;
        delete video.dataset.posterSrc;
      };
      const posterObserver = 'IntersectionObserver' in window
        ? new IntersectionObserver(
            (entries, observer) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                loadPoster(entry.target);
                observer.unobserve(entry.target);
              });
            },
            { rootMargin: '900px 500px' }
          )
        : null;

      const abortSignal = controller.signal;

      videoShells.forEach((shell) => {
        const video = shell.querySelector('video');
        const toggle = shell.querySelector('[data-real-life-video-toggle]');
        if (!video || !toggle) return;

        if (posterObserver) {
          posterObserver.observe(video);
        } else {
          loadPoster(video);
        }

        const updateState = () => {
          const isPlaying = !video.paused && !video.ended;
          toggle.classList.toggle('is-hidden', isPlaying);
          toggle.setAttribute('aria-label', isPlaying ? 'Pause video' : 'Play video');
          toggle.setAttribute('aria-pressed', isPlaying ? 'true' : 'false');
        };

        const togglePlayback = () => {
          loadPoster(video);
          if (video.paused || video.ended) {
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        };

        toggle.addEventListener('click', (event) => {
          event.preventDefault();
          togglePlayback();
        }, { signal: abortSignal });

        video.addEventListener('click', togglePlayback, { signal: abortSignal });
        video.addEventListener('play', updateState, { signal: abortSignal });
        video.addEventListener('pause', updateState, { signal: abortSignal });
        video.addEventListener('ended', updateState, { signal: abortSignal });
        updateState();
      });

      instances.set(section, {
        destroy: () => {
          posterObserver?.disconnect();
          controller.abort();
          videoShells.forEach((shell) => shell.querySelector('video')?.pause());
          instances.delete(section);
        },
      });
    };

    const forEachSection = (scope, callback) => {
      if (scope.matches?.('[data-real-life-videos]')) callback(scope);
      scope.querySelectorAll?.('[data-real-life-videos]').forEach(callback);
    };

    const initializeSections = (scope = document) => forEachSection(scope, initializeSection);
    const unloadSections = (scope) => forEachSection(scope, (section) => instances.get(section)?.destroy());

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initializeSections(), { once: true });
    } else {
      initializeSections();
    }
    document.addEventListener('shopify:section:load', (event) => initializeSections(event.target));
    document.addEventListener('shopify:section:unload', (event) => unloadSections(event.target));
  })();
{% endjavascript %}



