{% liquid
  assign rating_value = section.settings.rating_value
  assign rating_count = product.metafields.reviews.rating_count.value | default: blank
  assign judge_me_widget = product.metafields.judgeme.widget
  assign has_legacy_judgeme_widget = false

  if judge_me_widget.size > 20
    assign has_legacy_judgeme_widget = true
  endif

  if product.metafields.reviews.rating.value != blank
    assign rating_value = product.metafields.reviews.rating.value.rating | round: 1
  endif

  assign review_total = section.settings.review_total | plus: 0
  assign review_5 = section.settings.review_5 | plus: 0
  assign review_4 = section.settings.review_4 | plus: 0
  assign review_3 = section.settings.review_3 | plus: 0
  assign review_2 = section.settings.review_2 | plus: 0
  assign review_1 = section.settings.review_1 | plus: 0

  if review_total <= 0
    assign review_total = review_5 | plus: review_4 | plus: review_3 | plus: review_2 | plus: review_1
  endif

  assign p5 = 0
  assign p4 = 0
  assign p3 = 0
  assign p2 = 0
  assign p1 = 0

  if review_total > 0
    assign p5 = review_5 | times: 100.0 | divided_by: review_total
    assign p4 = review_4 | times: 100.0 | divided_by: review_total
    assign p3 = review_3 | times: 100.0 | divided_by: review_total
    assign p2 = review_2 | times: 100.0 | divided_by: review_total
    assign p1 = review_1 | times: 100.0 | divided_by: review_total
  endif

  assign review_total_label = rating_count | default: review_total
  assign subtitle = section.settings.subtitle

  if rating_count != blank
    assign subtitle = 'Based on ' | append: review_total_label | append: ' reviews'
  endif
%}

{% if section.settings.show_reviews_rating_section %}
<section class="product-reviews-rating section">
  <div class="container">
    <article class="product-reviews-rating__panel">
      <div class="product-reviews-rating__header">
        <p class="product-reviews-rating__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="product-reviews-rating__title">{{ section.settings.title }}</h2>
      </div>

      <div class="product-reviews-rating__summary">
        <div class="product-reviews-rating__score">
          <div class="product-reviews-rating__value">{{ rating_value }}</div>
          <div>
            <div class="product-reviews-rating__stars" role="img" aria-label="{{ rating_value }} out of 5 stars">
              {% for star in (1..5) %}
                <svg viewBox="0 0 20 20" fill="currentColor" focusable="false" aria-hidden="true">
                  <path d="m10 2.6 2.25 4.56 5.04.73-3.65 3.56.86 5.03L10 14.12 5.5 16.48l.86-5.03L2.7 7.89l5.04-.73L10 2.6Z"></path>
                </svg>
              {% endfor %}
            </div>
            <p class="product-reviews-rating__subtitle">{{ subtitle }}</p>
          </div>
        </div>

        <div class="product-reviews-rating__bars" aria-label="Rating distribution" data-judgeme-rating-bars>
          <div class="product-reviews-rating__row" data-rating-row="5">
            <span>5 Stars</span>
            <span class="product-reviews-rating__bar"><span style="width: {{ p5 }}%;" data-rating-bar></span></span>
            <strong data-rating-count>{{ review_5 }}</strong>
          </div>
          <div class="product-reviews-rating__row" data-rating-row="4">
            <span>4 Stars</span>
            <span class="product-reviews-rating__bar"><span style="width: {{ p4 }}%;" data-rating-bar></span></span>
            <strong data-rating-count>{{ review_4 }}</strong>
          </div>
          <div class="product-reviews-rating__row" data-rating-row="3">
            <span>3 Stars</span>
            <span class="product-reviews-rating__bar"><span style="width: {{ p3 }}%;" data-rating-bar></span></span>
            <strong data-rating-count>{{ review_3 }}</strong>
          </div>
          <div class="product-reviews-rating__row" data-rating-row="2">
            <span>2 Stars</span>
            <span class="product-reviews-rating__bar"><span style="width: {{ p2 }}%;" data-rating-bar></span></span>
            <strong data-rating-count>{{ review_2 }}</strong>
          </div>
          <div class="product-reviews-rating__row" data-rating-row="1">
            <span>1 Star</span>
            <span class="product-reviews-rating__bar"><span style="width: {{ p1 }}%;" data-rating-bar></span></span>
            <strong data-rating-count>{{ review_1 }}</strong>
          </div>
        </div>
      </div>

      {% if section.settings.button_label != blank or section.settings.write_button_label != blank %}
        <div class="product-reviews-rating__actions">
          {% if section.settings.write_button_label != blank %}
            <a class="product-reviews-rating__button product-reviews-rating__button--primary" href="{{ section.settings.write_button_link | default: '#judgeme_reviews_panel' }}" data-judgeme-write-review>
              <span>{{ section.settings.write_button_label }}</span>
              <span aria-hidden="true">+</span>
            </a>
          {% endif %}

          {% if section.settings.button_label != blank %}
            <a class="product-reviews-rating__button" href="{{ section.settings.button_link | default: '#judgeme_reviews_panel' }}" data-judgeme-view-reviews aria-controls="judgeme_reviews_panel" aria-expanded="false">
              <span data-judgeme-view-reviews-label>{{ section.settings.button_label }}</span>
              <span aria-hidden="true" data-judgeme-view-reviews-icon>&rsaquo;</span>
            </a>
          {% endif %}
        </div>
      {% endif %}

      <div id="judgeme_reviews_panel" class="product-reviews-rating__judgeme" data-judgeme-reviews-panel aria-hidden="true">
        <div class="product-reviews-rating__judgeme-header">
          <div>
            <p class="product-reviews-rating__judgeme-eyebrow">All Reviews</p>
            <h3 class="product-reviews-rating__judgeme-title">What customers are saying</h3>
          </div>
        </div>

        <div class="product-reviews-rating__judgeme-body" data-judgeme-panel-body>
          <div style="clear: both;"></div>
          <div
            id="judgeme_product_reviews"
            class="jdgm-widget jdgm-review-widget"
            data-product-title="{{ product.title | escape }}"
            data-id="{{ product.id }}"
            data-product-id="{{ product.id }}"
            data-widget="review"
            data-auto-install="false"
            data-shop-reviews-count="{{ shop.metafields.judgeme.shop_reviews_count | default: 0 | escape }}"
            data-entry-point="review_widget.js"
            data-entry-key="review-widget/main.js"
          >
            {% if has_legacy_judgeme_widget %}
              <div class="jdgm-legacy-widget-content" style="display: none;">
                {{ judge_me_widget }}
              </div>
            {% endif %}
          </div>

          {% if product.metafields.judgeme.review_widget_data %}
            <script>
              jdgm.data ||= {};
              jdgm.data.reviewWidget ||= {};
              jdgm.data.reviewWidget[{{ product.id }}] = {{ product.metafields.judgeme.review_widget_data }};
            </script>
          {% endif %}
        </div>
      </div>
    </article>
  </div>
</section>
{% endif %}

<script>
  (() => {
    const section = document.currentScript.previousElementSibling;
    const trigger = section?.querySelector('[data-judgeme-write-review]');
    const viewReviewsTrigger = section?.querySelector('[data-judgeme-view-reviews]');
    const viewReviewsLabel = section?.querySelector('[data-judgeme-view-reviews-label]');
    const viewReviewsIcon = section?.querySelector('[data-judgeme-view-reviews-icon]');
    const customRows = Array.from(section?.querySelectorAll('[data-rating-row]') || []);
    const widget = section?.querySelector('[data-judgeme-reviews-panel]');
    const panelBody = section?.querySelector('[data-judgeme-panel-body]');
    const viewReviewsOpenLabel = 'Close';
    const viewReviewsClosedLabel = viewReviewsLabel?.textContent || 'View All Reviews';
    const viewReviewsClosedIcon = viewReviewsIcon?.innerHTML || '&rsaquo;';

    const parseCount = (text) => {
      const match = text?.replace(/,/g, '').match(/\d+/);
      return match ? Number(match[0]) : 0;
    };

    const syncRatingBars = () => {
      if (!widget || !customRows.length) return false;

      const counts = {};

      widget.querySelectorAll('.jdgm-histogram__row').forEach((row) => {
        const rating = row.getAttribute('data-rating') || row.textContent?.match(/[1-5]/)?.[0];
        const count = parseCount(
          row.querySelector('.jdgm-histogram__frequency, .jdgm-histogram__count')?.textContent || row.textContent
        );

        if (rating) counts[rating] = count;
      });

      const total = Object.values(counts).reduce((sum, count) => sum + count, 0);
      if (!total) return false;

      customRows.forEach((row) => {
        const rating = row.dataset.ratingRow;
        const count = counts[rating] || 0;
        const percent = Math.round((count / total) * 1000) / 10;

        row.querySelector('[data-rating-count]').textContent = count.toLocaleString();
        row.querySelector('[data-rating-bar]').style.width = `${percent}%`;
      });

      return true;
    };

    const watchJudgeMe = () => {
      if (syncRatingBars() || !widget) return;

      const observer = new MutationObserver(() => {
        if (syncRatingBars()) observer.disconnect();
      });

      observer.observe(widget, { childList: true, subtree: true });
      window.setTimeout(() => observer.disconnect(), 10000);
    };

    const adoptExternalJudgeMeWidget = () => {
      if (!panelBody) return false;

      const externalWidget = Array.from(document.querySelectorAll('.jdgm-widget.jdgm-review-widget, .jdgm-review-widget')).find((node) => {
        return node instanceof HTMLElement && !section.contains(node) && node.querySelector('.jdgm-rev-widg, .jdgm-rev, .jdgm-widget-actions-wrapper, .jdgm-histogram');
      });

      if (!externalWidget) return false;

      const existingPanelWidget = panelBody.querySelector('.jdgm-widget.jdgm-review-widget, .jdgm-review-widget');
      const originalWrapper = externalWidget.closest('.shopify-section, .shopify-app-block, section, [id^="shopify-section"]');

      if (existingPanelWidget && existingPanelWidget !== externalWidget) {
        existingPanelWidget.remove();
      }

      panelBody.appendChild(externalWidget);

      if (originalWrapper instanceof HTMLElement && !section.contains(originalWrapper)) {
        originalWrapper.style.display = 'none';
      }

      syncRatingBars();
      return true;
    };

    const watchExternalJudgeMeWidget = () => {
      if (adoptExternalJudgeMeWidget()) return;

      const observer = new MutationObserver(() => {
        if (adoptExternalJudgeMeWidget()) observer.disconnect();
      });

      observer.observe(document.body, { childList: true, subtree: true });
      window.setTimeout(() => observer.disconnect(), 10000);
    };

    watchExternalJudgeMeWidget();
    watchJudgeMe();

    const showReviews = () => {
      if (!widget) return;

      widget.classList.add('is-open');
      widget.setAttribute('aria-hidden', 'false');
      viewReviewsTrigger?.setAttribute('aria-expanded', 'true');
      if (viewReviewsLabel) viewReviewsLabel.textContent = viewReviewsOpenLabel;
      if (viewReviewsIcon) viewReviewsIcon.textContent = '';
      window.requestAnimationFrame(() => {
        widget.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    };

    const hideReviews = () => {
      if (!widget) return;

      widget.classList.remove('is-open');
      widget.setAttribute('aria-hidden', 'true');
      viewReviewsTrigger?.setAttribute('aria-expanded', 'false');
      if (viewReviewsLabel) viewReviewsLabel.textContent = viewReviewsClosedLabel;
      if (viewReviewsIcon) viewReviewsIcon.innerHTML = viewReviewsClosedIcon;
      section.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    viewReviewsTrigger?.addEventListener('click', (event) => {
      event.preventDefault();

      if (widget?.classList.contains('is-open')) {
        hideReviews();
        return;
      }

      showReviews();
    });

    if (!trigger) return;

    trigger.addEventListener('click', (event) => {
      event.preventDefault();
      showReviews();
      window.setTimeout(() => {
        document
          .querySelector('.jm-button--primary, .jdgm-write-rev-link, .jdgm-write-rev-link a, .jdgm-write-rev-link button, [data-judgeme-open-review-form]')
          ?.click();
      }, 450);
    });

  })();
</script>



{% schema %}
{
  "name": "PDP Reviews Rating",
  "settings": [
    { "type": "checkbox", "id": "show_reviews_rating_section", "label": "Show reviews rating section", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer Reviews" },
    { "type": "text", "id": "title", "label": "Title", "default": "Trusted by real customers." },
    { "type": "text", "id": "rating_value", "label": "Rating value", "default": "4.9" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Based on 3,672 reviews" },
    { "type": "text", "id": "review_total", "label": "Review total", "default": "3672" },
    { "type": "text", "id": "review_5", "label": "5 star count", "default": "3182" },
    { "type": "text", "id": "review_4", "label": "4 star count", "default": "362" },
    { "type": "text", "id": "review_3", "label": "3 star count", "default": "74" },
    { "type": "text", "id": "review_2", "label": "2 star count", "default": "28" },
    { "type": "text", "id": "review_1", "label": "1 star count", "default": "26" },
    { "type": "text", "id": "write_button_label", "label": "Write review button label", "default": "Write A Review" },
    { "type": "url", "id": "write_button_link", "label": "Write review button link" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View All Reviews" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [
    {
      "name": "PDP Reviews Rating"
    }
  ]
}
{% endschema %}
