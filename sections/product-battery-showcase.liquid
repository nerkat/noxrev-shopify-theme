{% liquid
  assign showcase_image = section.settings.image | default: product.featured_media.preview_image
%}

<section class="product-battery-showcase section">
  <div class="container">
    <article class="product-battery-showcase__panel">
      <div class="product-battery-showcase__copy">
        <p class="product-battery-showcase__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="product-battery-showcase__title">{{ section.settings.title }}</h2>
        <p class="product-battery-showcase__text">{{ section.settings.text }}</p>

        <div class="product-battery-showcase__stats" role="list">
          <div class="product-battery-showcase__stat" role="listitem">
            <span class="product-battery-showcase__icon" aria-hidden="true">{% render 'product-marketing-icon', icon: 'bolt' %}</span>
            <span><strong>{{ section.settings.fast_charge_value }}</strong>{{ section.settings.fast_charge_label }}</span>
          </div>
          <div class="product-battery-showcase__stat" role="listitem">
            <span class="product-battery-showcase__icon" aria-hidden="true">{% render 'product-marketing-icon', icon: 'battery' %}</span>
            <span><strong>{{ section.settings.battery_life_value }}</strong>{{ section.settings.battery_life_label }}</span>
          </div>
        </div>

        <div class="product-battery-showcase__comparison" aria-label="{{ section.settings.comparison_label }}">
          <div class="product-battery-showcase__comparison-row">
            <span>{{ section.settings.primary_label }}</span>
            <span class="product-battery-showcase__bar"><span style="width: {{ section.settings.primary_percent }}%;"></span></span>
            <strong>{{ section.settings.primary_value }}</strong>
          </div>
          <div class="product-battery-showcase__comparison-row">
            <span>{{ section.settings.secondary_label }}</span>
            <span class="product-battery-showcase__bar product-battery-showcase__bar--muted"><span style="width: {{ section.settings.secondary_percent }}%;"></span></span>
            <strong>{{ section.settings.secondary_value }}</strong>
          </div>
        </div>
      </div>

      <div class="product-battery-showcase__media">
        {% if showcase_image != blank %}
          {% assign showcase_image_alt = section.settings.image_alt | default: section.settings.title %}
          {% render 'responsive-image',
            image: showcase_image,
            alt: showcase_image_alt,
            class: 'product-battery-showcase__image',
            loading: 'lazy',
            sizes: '(min-width: 900px) 58vw, 55vw',
            widths: '360, 520, 720, 960, 1200'
          %}
        {% else %}
          <div class="product-battery-showcase__placeholder" aria-hidden="true"></div>
        {% endif %}
      </div>
    </article>
  </div>
</section>



{% schema %}
{
  "name": "Product Battery Showcase",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Power That Keeps Up" },
    { "type": "text", "id": "title", "label": "Title", "default": "2-Hour Charge. 30-Day Power." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Stay productive longer with ultra-efficient power. Less charging, more creating." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Keyboard case with glowing power rings" },
    { "type": "text", "id": "fast_charge_value", "label": "Fast charge value", "default": "2-Hour" },
    { "type": "text", "id": "fast_charge_label", "label": "Fast charge label", "default": "Fast Charge" },
    { "type": "text", "id": "battery_life_value", "label": "Battery life value", "default": "30-Day" },
    { "type": "text", "id": "battery_life_label", "label": "Battery life label", "default": "Battery Life" },
    { "type": "text", "id": "comparison_label", "label": "Comparison accessible label", "default": "Battery life comparison" },
    { "type": "text", "id": "primary_label", "label": "Primary comparison label", "default": "NoxRev Keyboard Case" },
    { "type": "text", "id": "primary_value", "label": "Primary comparison value", "default": "30 Days" },
    { "type": "range", "id": "primary_percent", "label": "Primary bar percent", "min": 0, "max": 100, "step": 1, "default": 100 },
    { "type": "text", "id": "secondary_label", "label": "Secondary comparison label", "default": "Others" },
    { "type": "text", "id": "secondary_value", "label": "Secondary comparison value", "default": "7 Days" },
    { "type": "range", "id": "secondary_percent", "label": "Secondary bar percent", "min": 0, "max": 100, "step": 1, "default": 24 }
  ],
  "presets": [
    {
      "name": "Product Battery Showcase"
    }
  ]
}
{% endschema %}
