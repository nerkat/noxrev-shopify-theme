{% style %}{% if section.settings.layout_gap > 0 %}#shopify-section-{{ section.id }} .about-noxrev__grid{gap:{{ section.settings.layout_gap }}px}{% endif %}@media(min-width:750px){ {% unless section.settings.layout_columns == 'inherit' %}#shopify-section-{{ section.id }} .about-noxrev__grid{display:grid;grid-template-columns:repeat({{ section.settings.layout_columns }},minmax(0,1fr))}{% endunless %}}@media(max-width:749px){ {% unless section.settings.layout_mobile_columns == 'inherit' %}#shopify-section-{{ section.id }} .about-noxrev__grid{display:grid;grid-template-columns:repeat({{ section.settings.layout_mobile_columns }},minmax(0,1fr))}{% endunless %}}{% endstyle %}
{% render 'section-layout', section: section %}
{{ 'about-noxrev.css' | asset_url | stylesheet_tag }}

<section class="about-noxrev about-noxrev--tight">
  <div class="container">
    <div class="about-noxrev__grid about-noxrev__grid--split about-noxrev__grid--reverse">
      <div class="about-noxrev__card">
        {% if section.settings.eyebrow != blank %}
          <p class="about-noxrev__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 class="about-noxrev__heading">{{ section.settings.heading }}</h2>
        {% if section.settings.copy != blank %}
          <p class="about-noxrev__copy">{{ section.settings.copy }}</p>
        {% endif %}
      </div>

      <div class="about-noxrev__collage">
        {% for block in section.blocks %}
          <div class="about-noxrev__media-card about-noxrev__collage-item" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              {% assign story_image_alt = block.settings.image.alt %}
              {% if story_image_alt == blank %}
                {% capture story_image_alt %}{{ section.settings.heading }} — image {{ forloop.index }}{% endcapture %}
              {% endif %}
              {{ block.settings.image | image_url: width: 900 | image_tag: class: 'about-noxrev__image', loading: 'lazy', alt: story_image_alt }}
            {% else %}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'about-noxrev__placeholder' }}
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About story",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "BRAND PHILOSOPHY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for the way people actually use iPad."
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Copy",
      "default": "Whether you're writing, designing, studying, travelling, or presenting — your keyboard shouldn't get in the way."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_width",
      "label": "Content width",
      "options": [
        {
          "value": "inherit",
          "label": "Current width"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "layout_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "inherit",
          "label": "Current alignment"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "checkbox",
      "id": "custom_spacing",
      "label": "Use custom section spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top spacing mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom spacing mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "checkbox",
      "id": "use_section_scheme",
      "label": "Use section color scheme",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "device_visibility",
      "label": "Device visibility",
      "options": [
        {
          "value": "both",
          "label": "Both"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        }
      ],
      "default": "both"
    },
    {
      "type": "range",
      "id": "layout_gap",
      "label": "Grid gap (0 keeps current)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "layout_columns",
      "label": "Desktop columns",
      "options": [
        {
          "value": "inherit",
          "label": "Current columns"
        },
        {
          "value": "2",
          "label": "Two"
        },
        {
          "value": "3",
          "label": "Three"
        },
        {
          "value": "4",
          "label": "Four"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "layout_mobile_columns",
      "label": "Mobile columns",
      "options": [
        {
          "value": "inherit",
          "label": "Current columns"
        },
        {
          "value": "1",
          "label": "One"
        },
        {
          "value": "2",
          "label": "Two"
        }
      ],
      "default": "inherit"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Collage image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About story",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}

