{% style %}#shopify-section-{{ section.id }} .utility-content{max-width:{{ section.settings.content_width }}px;margin:auto}{% if section.settings.background_image != blank %}#shopify-section-{{ section.id }}{background-image:url({{ section.settings.background_image | image_url: width: 1800 }});background-size:cover}{% endif %}{% endstyle %}
<section class="container section utility-content">{% render 'section-layout', section: section %}
{% comment %}
  This section is used in the password template to render landing page shown
  when password protection is applied to a store.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

{% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 400 | image_tag: loading: 'eager', alt: shop.name }}{% endif %}<h1>{{ 'password.title' | t }}</h1>

{% if shop.password_message %}
  <p>{{ shop.password_message }}</p>
{% endif %}

{% form 'storefront_password' %}
  {% if form.errors %}
    {{ form.errors | default_errors }}
  {% endif %}

  <label for="password-input">
    {{ 'password.password' | t }}
  </label>

  <input type="password" name="password" id="password-input">

  <button type="submit">
    {{ 'password.enter' | t }}
  </button>
{% endform %}

</section>{% schema %}
{
  "name": "t:general.password",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_width",
      "label": "Content width",
      "options": [
        {
          "value": "inherit",
          "label": "Current width"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "layout_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "inherit",
          "label": "Current alignment"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "checkbox",
      "id": "custom_spacing",
      "label": "Use custom spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "checkbox",
      "id": "use_section_scheme",
      "label": "Use color scheme",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 400,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 600
    }
  ]
}
{% endschema %}

