{{ 'about-noxrev.css' | asset_url | stylesheet_tag }}

<section class="about-noxrev about-noxrev--tight">
  <div class="container">
    <div class="about-noxrev__grid about-noxrev__grid--split">
      <div class="about-noxrev__card">
        <h2 class="about-noxrev__heading">{{ section.settings.heading }}</h2>
        <div class="about-noxrev__actions">
          <a class="button button--primary" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label }}</a>
          <a class="about-noxrev__secondary" href="{{ section.settings.secondary_link | default: '/pages/find-your-ipad-model' }}">{{ section.settings.secondary_label }}</a>
        </div>
      </div>
      <div class="about-noxrev__media-card">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1200 | image_tag: class: 'about-noxrev__image', loading: 'lazy' }}
        {% else %}
          {{ 'product-2' | placeholder_svg_tag: 'about-noxrev__placeholder' }}
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About CTA",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready to upgrade your iPad?" },
    { "type": "text", "id": "primary_label", "label": "Primary CTA label", "default": "Shop NoxRev TXP1" },
    { "type": "url", "id": "primary_link", "label": "Primary CTA link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary CTA label", "default": "Find Your iPad Model" },
    { "type": "url", "id": "secondary_link", "label": "Secondary CTA link" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "presets": [{ "name": "About CTA" }]
}
{% endschema %}
