{% liquid
  assign hero_link = section.settings.button_link
  assign slide_blocks = section.blocks | where: 'type', 'slide'
  assign slide_count = 0
  assign card_count = 0
  assign review_product = section.settings.review_product | default: all_products['tpx1']
  assign review_rating = review_product.metafields.reviews.rating
  assign review_average = review_rating.value.rating | plus: 0
  assign review_scale = review_rating.value.scale_max | default: 5 | plus: 0
  assign review_count = review_product.metafields.reviews.rating_count.value | default: 0 | plus: 0
  assign review_average_rounded = review_average | round: 1
  assign has_review_data = false
  assign review_star_fill = 0

  if review_count > 0 and review_rating.value.rating != blank and review_scale > 0 and review_average > 0 and review_average <= review_scale
    assign has_review_data = true
    assign review_star_fill = review_average | times: 100.0 | divided_by: review_scale
  endif

  for block in section.blocks
    if block.type == 'card'
      if block.settings.card_style != 'reviews' or has_review_data
        assign card_count = card_count | plus: 1
      endif
    elsif block.type == 'slide'
      if block.settings.image != blank or block.settings.external_image_url != blank
        assign slide_count = slide_count | plus: 1
      endif
    endif
  endfor

  if hero_link == blank and collections.all != blank
    assign hero_link = collections.all.url
  endif

  assign has_multiple_slides = false
  if slide_count > 1
    assign has_multiple_slides = true
  endif
%}

<section class="home-hero full-width hero-shell" data-hero-slider data-autoplay="{% if has_multiple_slides %}true{% else %}false{% endif %}">
  <div class="home-hero__background">
    <div class="home-hero__slides">
      {% assign rendered_slide = 0 %}
      {% for block in slide_blocks %}
        {% if block.settings.image != blank or block.settings.external_image_url != blank %}
          {% liquid
            assign slide_image_alt = block.settings.image.alt | default: section.settings.heading
            assign slide_loading = 'lazy'
            if rendered_slide == 0
              assign slide_loading = 'eager'
            endif
          %}
          <div class="home-hero__slide{% if rendered_slide == 0 %} is-active{% endif %}" data-hero-slide {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 2200
                | image_tag: class: 'home-hero__image', loading: slide_loading, alt: slide_image_alt
              }}
            {% else %}
              <img class="home-hero__image" src="{{ block.settings.external_image_url | escape }}" alt="{{ slide_image_alt | escape }}" loading="{{ slide_loading }}" width="1800" height="1200">
            {% endif %}
          </div>
          {% assign rendered_slide = rendered_slide | plus: 1 %}
        {% endif %}
      {% endfor %}

      {% if slide_count == 0 %}
        <div class="home-hero__slide is-active" data-hero-slide>
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'home-hero__placeholder' }}
        </div>
      {% endif %}
    </div>

    <div class="hero-overlay hero-overlay--primary"></div>
    <div class="hero-overlay hero-overlay--accent"></div>
    <div class="hero-grid"></div>
  </div>

  <div class="container home-hero__inner">
    <div class="home-hero__content">
      {% if has_review_data %}
        <div class="home-hero__rating chip">
          <span class="home-hero__rating-dot" aria-hidden="true"></span>
          <span>Rated {{ review_average_rounded }} / {{ review_scale }} by {{ review_count }} {% if review_count == 1 %}review{% else %}reviews{% endif %}</span>
        </div>
      {% endif %}

      {% if section.settings.eyebrow != blank %}
        <p class="home-hero__eyebrow kicker">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="home-hero__title heading-gradient">{{ section.settings.heading | escape }}</h1>
      {% endif %}

      {% if section.settings.text != blank %}
        <p class="home-hero__text">{{ section.settings.text | escape }}</p>
      {% endif %}

      <div class="home-hero__actions">
        {% if section.settings.button_label != blank and hero_link != blank %}
          <a class="button home-hero__button" href="{{ hero_link }}">
            <span class="button__content">
              <span>{{ section.settings.button_label | escape }}</span>
              <span class="button__icon" aria-hidden="true">&rarr;</span>
            </span>
          </a>
        {% endif %}

        {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}
          <a class="button button--secondary home-hero__button home-hero__button--secondary" href="{{ section.settings.secondary_link }}">
            <span class="button__content">
              <span>{{ section.settings.secondary_label | escape }}</span>
              <span class="button__icon" aria-hidden="true">&rarr;</span>
            </span>
          </a>
        {% endif %}
      </div>

      {% if card_count > 0 %}
        <div class="home-hero__cards">
          {% for block in section.blocks %}
            {% liquid
              assign card_style = block.settings.card_style | default: 'promo'
              assign card_contact_value_1 = block.settings.contact_value_1
              assign card_contact_link_1 = block.settings.contact_link_1
              assign card_contact_label_1 = block.settings.contact_label_1 | downcase
              if card_contact_value_1 == blank and card_contact_label_1 contains 'email'
                assign card_contact_value_1 = settings.global_support_email | default: 'support@noxrev.com'
              endif
              if card_contact_link_1 == blank and card_contact_value_1 contains '@'
                assign card_contact_link_1 = 'mailto:' | append: card_contact_value_1
              endif
            %}
            {% if block.type == 'card' %}
              {% if card_style != 'reviews' or has_review_data %}
            <article class="home-hero__card home-hero__card--{{ card_style }}" {{ block.shopify_attributes }}>
              <div class="home-hero__card-top">
                <div>
                  {% if block.settings.label != blank %}
                    <p class="home-hero__card-label">{{ block.settings.label | escape }}</p>
                  {% endif %}

                  {% if card_style == 'reviews' and has_review_data %}
                    <h2 class="home-hero__card-heading">{{ review_average_rounded }} / {{ review_scale }}</h2>
                  {% elsif block.settings.heading != blank %}
                    <h2 class="home-hero__card-heading">{{ block.settings.heading | escape }}</h2>
                  {% endif %}
                </div>

                <span class="home-hero__card-icon" aria-hidden="true">
                  {% case card_style %}
                    {% when 'reviews' %}
                      <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true">
                        <path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M20 3v4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M22 5h-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <circle cx="4" cy="20" r="2" stroke="currentColor" stroke-width="2"/>
                      </svg>
                    {% when 'support' %}
                      <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true">
                        <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M8 12h.01" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M12 12h.01" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M16 12h.01" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {% else %}
                      <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true">
                        <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="m15 9-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M9 9h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M15 15h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                  {% endcase %}
                </span>
              </div>

              {% if card_style == 'reviews' and has_review_data %}
                <div class="home-hero__card-stars" role="img" aria-label="{{ review_average_rounded }} out of {{ review_scale }} stars from {{ review_count }} {% if review_count == 1 %}review{% else %}reviews{% endif %}">
                  <span class="home-hero__card-stars-base" aria-hidden="true">
                    {% for star in (1..5) %}
                      <svg viewBox="0 0 24 24" focusable="false"><path d="M12 2.85 14.91 8.74l6.5.95-4.7 4.58 1.11 6.47L12 17.69l-5.82 3.05 1.11-6.47-4.7-4.58 6.5-.95L12 2.85Z" fill="currentColor"/></svg>
                    {% endfor %}
                  </span>
                  <span class="home-hero__card-stars-fill" style="width: {{ review_star_fill }}%;" aria-hidden="true">
                    {% for star in (1..5) %}
                      <svg viewBox="0 0 24 24" focusable="false"><path d="M12 2.85 14.91 8.74l6.5.95-4.7 4.58 1.11 6.47L12 17.69l-5.82 3.05 1.11-6.47-4.7-4.58 6.5-.95L12 2.85Z" fill="currentColor"/></svg>
                    {% endfor %}
                  </span>
                </div>
              {% endif %}

              {% if card_style != 'support' and block.settings.text != blank %}
                <p class="home-hero__card-text">{{ block.settings.text | escape }}</p>
              {% endif %}

              {% if card_style == 'support' %}
                <div class="home-hero__contact-list">
                  {% if card_contact_value_1 != blank %}
                    <a class="home-hero__contact-item" href="{{ card_contact_link_1 | default: '#' | escape }}">
                      <span class="home-hero__contact-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true">
                          <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="2"/>
                          <path d="m3 7 8.29 6.22a1.2 1.2 0 0 0 1.42 0L21 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>
                      <span>
                        {% if block.settings.contact_label_1 != blank %}
                          <span class="home-hero__contact-label">{{ block.settings.contact_label_1 | escape }}</span>
                        {% endif %}
                        <span class="home-hero__contact-value">{{ card_contact_value_1 | escape }}</span>
                      </span>
                    </a>
                  {% endif %}

                  {% if block.settings.contact_value_2 != blank %}
                    <a class="home-hero__contact-item" href="{{ block.settings.contact_link_2 | default: '#' }}">
                      <span class="home-hero__contact-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true">
                          <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                          <path d="M8 12h.01" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                          <path d="M12 12h.01" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                          <path d="M16 12h.01" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>
                      <span>
                        {% if block.settings.contact_label_2 != blank %}
                          <span class="home-hero__contact-label">{{ block.settings.contact_label_2 | escape }}</span>
                        {% endif %}
                        <span class="home-hero__contact-value">{{ block.settings.contact_value_2 | escape }}</span>
                      </span>
                    </a>
                  {% endif %}
                </div>
              {% elsif block.settings.link_label != blank and block.settings.link != blank %}
                <a class="home-hero__card-link" href="{{ block.settings.link }}">
                  <span>{{ block.settings.link_label | escape }}</span>
                  <span aria-hidden="true">&rarr;</span>
                </a>
              {% endif %}
            </article>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      {% if has_multiple_slides %}
        <div class="home-hero__dots" aria-label="Hero slides">
          {% assign rendered_dot = 0 %}
          {% for block in slide_blocks %}
            {% if block.settings.image != blank or block.settings.external_image_url != blank %}
              {% assign rendered_dot = rendered_dot | plus: 1 %}
              {% assign dot_index = rendered_dot %}
              {% assign dot_state = 'false' %}
              {% if rendered_dot == 1 %}
                {% assign dot_state = 'true' %}
              {% endif %}
              <button class="home-hero__dot{% if rendered_dot == 1 %} is-active{% endif %}" type="button" aria-label="Show hero image {{ dot_index }}" aria-pressed="{{ dot_state }}" data-hero-dot></button>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .home-hero {
    min-height: clamp(40rem, 90vh, 54rem);
    border-bottom: 1px solid var(--theme-color-border);
    background: var(--theme-color-background);
  }

  .home-hero__background,
  .home-hero__slides,
  .home-hero__slide,
  .home-hero__image,
  .home-hero__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .home-hero__slide {
    opacity: 0;
    transition: opacity 700ms ease;
  }

  .home-hero__slide.is-active {
    opacity: 1;
  }

  .home-hero__image,
  .home-hero__placeholder {
    object-fit: cover;
  }

  .home-hero__inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    min-height: clamp(40rem, 90vh, 54rem);
    padding-top: clamp(8rem, 18vh, 12rem);
    padding-bottom: clamp(2rem, 8vh, 4rem);
  }

  .home-hero__content {
    width: min(100%, 64rem);
    display: grid;
    gap: 1.4rem;
  }

  .home-hero__rating {
    width: fit-content;
    min-width: 0;
  }

  .home-hero__rating-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--theme-color-secondary);
    box-shadow: 0 0 16px rgba(0, 229, 255, 0.7);
  }

  .home-hero__eyebrow {
    margin: 0;
  }

  .home-hero__title {
    margin: 0;
    font-size: clamp(3rem, 7vw, 5.8rem);
    line-height: 0.94;
  }

  .home-hero__text {
    margin: 0;
    max-width: 40rem;
    color: var(--theme-color-text-muted);
    font-size: 1rem;
    line-height: 1.8;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .home-hero__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.2rem;
    margin-top: 0.4rem;
    align-items: start;
  }

  .home-hero__card {
    display: grid;
    align-content: start;
    gap: 0.95rem;
    min-height: 100%;
    border: 0;
    border-radius: 1.55rem;
    padding: 1.45rem;
    color: var(--theme-color-text);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.26);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
  }

  .home-hero__card--promo {
    background: linear-gradient(145deg, rgba(0, 255, 176, 0.16), rgba(0, 229, 255, 0.08));
  }

  .home-hero__card--reviews {
    background: linear-gradient(160deg, rgba(255, 45, 120, 0.16), rgba(155, 0, 255, 0.09));
  }

  .home-hero__card--support {
    background: linear-gradient(155deg, rgba(0, 229, 255, 0.14), rgba(255, 255, 255, 0.05));
  }

  .home-hero__card-top {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }

  .home-hero__card-label {
    margin: 0;
    color: rgba(255, 255, 255, 0.45);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .home-hero__card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.6rem;
    height: 4.6rem;
    flex: 0 0 auto;
    border-radius: 1.5rem;
    background: rgba(0, 0, 0, 0.2);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .home-hero__card-icon svg {
    width: 1.65rem;
    height: 1.65rem;
  }

  .home-hero__card--promo .home-hero__card-icon {
    color: var(--theme-color-primary);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.08),
      0 0 24px rgba(0, 255, 176, 0.18);
  }

  .home-hero__card--reviews .home-hero__card-icon {
    color: #ff9fbe;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.08),
      0 0 24px rgba(255, 45, 120, 0.2);
  }

  .home-hero__card--support .home-hero__card-icon {
    color: var(--theme-color-secondary);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.08),
      0 0 24px rgba(0, 229, 255, 0.2);
  }

  .home-hero__card-heading {
    margin: 0.8rem 0 0;
    color: var(--theme-color-text);
    font-size: clamp(2.1rem, 3vw, 2.6rem);
    line-height: 1.06;
  }

  .home-hero__card--support .home-hero__card-heading {
    max-width: 8ch;
    font-size: clamp(2rem, 2.7vw, 2.55rem);
  }

  .home-hero__card-text {
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.92rem;
    line-height: 1.75;
  }

  .home-hero__card-stars {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    color: rgba(255, 209, 102, 0.3);
  }

  .home-hero__card-stars-base,
  .home-hero__card-stars-fill {
    display: flex;
    gap: 0.3rem;
  }

  .home-hero__card-stars-fill {
    position: absolute;
    inset: 0 auto 0 0;
    overflow: hidden;
    color: #ffd166;
    white-space: nowrap;
  }

  .home-hero__card-stars svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  .home-hero__card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    width: fit-content;
    margin-top: 0.15rem;
    padding: 0.95rem 1.35rem;
    border-radius: var(--theme-radius-pill);
    background: rgba(0, 0, 0, 0.2);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
    color: var(--theme-color-text);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      color var(--transition-base),
      box-shadow var(--transition-base),
      transform var(--transition-base);
  }

  .home-hero__card-link:hover {
    color: var(--theme-color-primary);
    transform: translateY(-1px);
    box-shadow:
      inset 0 0 0 1px rgba(0, 255, 176, 0.4),
      0 0 24px rgba(0, 255, 176, 0.14);
  }

  .home-hero__contact-list {
    display: grid;
    gap: 0.8rem;
  }

  .home-hero__contact-item {
    display: flex;
    align-items: center;
    gap: 0.95rem;
    min-height: 4.8rem;
    padding: 0.95rem 1.05rem;
    border-radius: 1.4rem;
    background: rgba(0, 0, 0, 0.2);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    transition:
      color var(--transition-base),
      box-shadow var(--transition-base),
      transform var(--transition-base);
  }

  .home-hero__contact-item:hover {
    color: var(--theme-color-text);
    transform: translateY(-1px);
    box-shadow:
      inset 0 0 0 1px rgba(0, 229, 255, 0.32),
      0 0 24px rgba(0, 229, 255, 0.1);
  }

  .home-hero__contact-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.2rem;
    height: 3.2rem;
    flex: 0 0 auto;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.06);
    color: var(--theme-color-secondary);
  }

  .home-hero__contact-icon svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .home-hero__contact-label,
  .home-hero__contact-value {
    display: block;
  }

  .home-hero__contact-label {
    color: rgba(255, 255, 255, 0.48);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .home-hero__contact-value {
    margin-top: 0.18rem;
    font-size: 1rem;
    line-height: 1.5;
  }

  .home-hero__dots {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.25rem;
  }

  .home-hero__dot {
    width: 1.05rem;
    height: 1.05rem;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.35);
    cursor: pointer;
    transition:
      width 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  .home-hero__dot.is-active {
    width: 3.5rem;
    background: var(--theme-color-secondary);
    box-shadow: 0 0 16px rgba(0, 229, 255, 0.45);
  }

  @media (max-width: 1100px) {
    .home-hero__cards {
      grid-template-columns: 1fr;
      width: min(100%, 33rem);
    }
  }

  @media (max-width: 749px) {
    .home-hero {
      min-height: 0;
    }

    .home-hero__inner {
      min-height: 0;
      align-items: flex-end;
      padding-top: 7.5rem;
      padding-bottom: 2rem;
    }

    .home-hero__content {
      width: 100%;
      gap: 1rem;
    }

    .home-hero__title {
      max-width: 100%;
      font-size: clamp(2.4rem, 12vw, 4rem);
    }

    .home-hero__text {
      font-size: 0.95rem;
      line-height: 1.7;
    }

    .home-hero__actions {
      display: grid;
    }

    .home-hero__button,
    .home-hero__card-link {
      width: 100%;
    }

    .home-hero__card {
      padding: 1.25rem;
      border-radius: 1.65rem;
    }

    .home-hero__card-heading {
      font-size: clamp(1.8rem, 9vw, 2.45rem);
    }

    .home-hero__dot.is-active {
      width: 3rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const instances = new WeakMap();

    const initializeHero = (hero) => {
      if (!hero || instances.has(hero) || hero.dataset.autoplay !== 'true') return;

      const slides = Array.from(hero.querySelectorAll('[data-hero-slide]'));
      const dots = Array.from(hero.querySelectorAll('[data-hero-dot]'));
      if (slides.length < 2 || dots.length !== slides.length) return;

      const controller = new AbortController();
      let activeIndex = 0;
      let intervalId = null;
      let pausedByEditor = false;

      const stopAutoplay = () => {
        window.clearInterval(intervalId);
        intervalId = null;
      };

      const setActiveSlide = (index) => {
        activeIndex = Math.max(0, Math.min(index, slides.length - 1));
        slides.forEach((slide, slideIndex) => {
          slide.classList.toggle('is-active', slideIndex === activeIndex);
        });
        dots.forEach((dot, dotIndex) => {
          const isActive = dotIndex === activeIndex;
          dot.classList.toggle('is-active', isActive);
          dot.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });
      };

      const startAutoplay = () => {
        stopAutoplay();
        if (pausedByEditor) return;
        intervalId = window.setInterval(() => {
          setActiveSlide(activeIndex === slides.length - 1 ? 0 : activeIndex + 1);
        }, 4500);
      };

      dots.forEach((dot, dotIndex) => {
        dot.addEventListener('click', () => {
          setActiveSlide(dotIndex);
          startAutoplay();
        }, { signal: controller.signal });
      });

      hero.addEventListener('mouseenter', stopAutoplay, { signal: controller.signal });
      hero.addEventListener('mouseleave', startAutoplay, { signal: controller.signal });
      hero.addEventListener('focusin', stopAutoplay, { signal: controller.signal });
      hero.addEventListener('focusout', (event) => {
        if (!hero.contains(event.relatedTarget)) startAutoplay();
      }, { signal: controller.signal });

      const instance = {
        selectBlock: (target) => {
          const slide = target.closest?.('[data-hero-slide]');
          const selectedIndex = slides.indexOf(slide);
          if (selectedIndex < 0) return;
          pausedByEditor = true;
          stopAutoplay();
          setActiveSlide(selectedIndex);
        },
        deselectBlock: () => {
          pausedByEditor = false;
          startAutoplay();
        },
        destroy: () => {
          stopAutoplay();
          controller.abort();
          instances.delete(hero);
        },
      };

      instances.set(hero, instance);
      setActiveSlide(0);
      startAutoplay();
    };

    const forEachHero = (scope, callback) => {
      if (scope?.matches?.('[data-hero-slider]')) callback(scope);
      scope?.querySelectorAll?.('[data-hero-slider]').forEach(callback);
    };

    const initializeHeroes = (scope = document) => forEachHero(scope, initializeHero);
    const destroyHeroes = (scope) => forEachHero(scope, (hero) => instances.get(hero)?.destroy());

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initializeHeroes(), { once: true });
    } else {
      initializeHeroes();
    }

    document.addEventListener('shopify:section:load', (event) => initializeHeroes(event.target));
    document.addEventListener('shopify:section:unload', (event) => destroyHeroes(event.target));
    document.addEventListener('shopify:block:select', (event) => {
      const hero = event.target.closest?.('[data-hero-slider]');
      if (hero) instances.get(hero)?.selectBlock(event.target);
    });
    document.addEventListener('shopify:block:deselect', (event) => {
      const hero = event.target.closest?.('[data-hero-slider]');
      if (hero) instances.get(hero)?.deselectBlock();
    });
  })();
{% endjavascript %}

