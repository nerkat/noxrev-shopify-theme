{% liquid
  assign hero_link = section.settings.button_link

  if hero_link == blank and collections.all != blank
    assign hero_link = collections.all.url
  endif
%}

<section class="home-hero full-width">
  <div class="home-hero__inner">
    <div class="home-hero__content">
      {% if section.settings.eyebrow != blank %}
        <p class="home-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="home-hero__title">{{ section.settings.heading | escape }}</h1>
      {% endif %}

      {% if section.settings.text != blank %}
        <p class="home-hero__text">{{ section.settings.text | escape }}</p>
      {% endif %}

      {% if section.settings.button_label != blank and hero_link != blank %}
        <a class="home-hero__button" href="{{ hero_link }}">{{ section.settings.button_label | escape }}</a>
      {% endif %}
    </div>

    <div class="home-hero__media">
      {% if section.settings.image %}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag: class: 'home-hero__image', loading: 'eager', alt: section.settings.heading
        }}
      {% else %}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'home-hero__placeholder' }}
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .home-hero {
    background: #f4efe8;
    padding: 2rem 0 3rem;
  }

  .home-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 42%);
    align-items: center;
    gap: 2rem;
    padding: 0 var(--page-margin);
  }

  .home-hero__content {
    max-width: 36rem;
    display: grid;
    gap: 1rem;
  }

  .home-hero__eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .home-hero__title {
    font-size: clamp(2.5rem, 6vw, 4.75rem);
    line-height: 0.95;
  }

  .home-hero__text {
    font-size: 1rem;
    line-height: 1.6;
    max-width: 34rem;
  }

  .home-hero__button {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.75rem 1.25rem;
    border: 1px solid currentcolor;
    color: inherit;
    text-decoration: none;
  }

  .home-hero__media {
    background: #e8dfd5;
    min-height: 26rem;
  }

  .home-hero__image,
  .home-hero__placeholder {
    width: 100%;
    height: 100%;
    min-height: 26rem;
    object-fit: cover;
  }

  @media (max-width: 860px) {
    .home-hero__inner {
      grid-template-columns: 1fr;
      padding: 0 var(--page-margin);
    }

    .home-hero__media {
      order: -1;
      min-height: 20rem;
    }

    .home-hero__image,
    .home-hero__placeholder {
      min-height: 20rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New season arrival"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Simple pieces for everyday shopping"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Build a clean storefront around a focused product mix with flexible sections and easy collection browsing."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop catalog"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ]
}
{% endschema %}