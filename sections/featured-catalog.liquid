    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom spacing mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "checkbox",
      "id": "use_section_scheme",
