{% liquid
  assign product_limit = section.settings.product_limit | default: 8 | at_least: 1 | at_most: 8

  if section.settings.collection != blank
    assign catalog_collection = section.settings.collection
  else
    assign catalog_collection = collections.all
  endif
%}

<section class="container section featured-catalog">
  <header class="featured-catalog__header">
    <div>
      {% if section.settings.eyebrow != blank %}
        <p class="kicker">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="featured-catalog__title heading-gradient">{{ section.settings.heading | escape }}</h2>
      {% endif %}
    </div>

    {% if section.settings.text != blank %}
      <p class="featured-catalog__text">{{ section.settings.text | escape }}</p>
    {% endif %}
  </header>

  <div class="featured-catalog__slider-wrap" data-featured-catalog>
    <div class="featured-catalog__grid grid grid--5" data-featured-catalog-slider>
      {% for product in catalog_collection.products limit: product_limit %}
        {% render 'product-card', product: product, show_vendor: section.settings.show_vendor %}
      {% endfor %}
    </div>

    <button
      class="featured-catalog__arrow featured-catalog__arrow--prev"
      type="button"
      aria-label="Previous featured products"
      data-featured-catalog-prev
      hidden
    >
      <span aria-hidden="true">&lsaquo;</span>
    </button>
    <button
      class="featured-catalog__arrow featured-catalog__arrow--next"
      type="button"
      aria-label="Next featured products"
      data-featured-catalog-next
      hidden
    >
      <span aria-hidden="true">&rsaquo;</span>
    </button>
  </div>
</section>

<script>
  (() => {
    const initFeaturedCatalogSliders = (root = document) => {
      const catalogs = root.querySelectorAll('[data-featured-catalog]');

      catalogs.forEach((catalog) => {
        if (catalog.dataset.featuredCatalogReady === 'true') return;
        catalog.dataset.featuredCatalogReady = 'true';

        const slider = catalog.querySelector('[data-featured-catalog-slider]');
        const prev = catalog.querySelector('[data-featured-catalog-prev]');
        const next = catalog.querySelector('[data-featured-catalog-next]');
        if (!slider || !prev || !next) return;

        const getStep = () => {
          const card = slider.querySelector('.product-card');
          return card ? card.getBoundingClientRect().width + 16 : slider.clientWidth * 0.82;
        };

        const updateButtons = () => {
          const maxScroll = slider.scrollWidth - slider.clientWidth;
          const hasOverflow = maxScroll > 2;
          prev.hidden = !hasOverflow || slider.scrollLeft <= 2;
          next.hidden = !hasOverflow || slider.scrollLeft >= maxScroll - 2;
        };

        const scrollByDirection = (direction) => {
          const maxScroll = slider.scrollWidth - slider.clientWidth;
          const target = Math.max(0, Math.min(maxScroll, slider.scrollLeft + getStep() * direction));
          slider.scrollTo({ left: target, behavior: 'smooth' });
          window.setTimeout(updateButtons, 260);
        };

        prev.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          scrollByDirection(-1);
        });

        next.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          scrollByDirection(1);
        });

        slider.addEventListener('scroll', updateButtons, { passive: true });
        window.addEventListener('resize', updateButtons);
        updateButtons();
      });
    };

    initFeaturedCatalogSliders();
    document.addEventListener('shopify:section:load', (event) => initFeaturedCatalogSliders(event.target));
  })();
</script>

{% stylesheet %}
  .featured-catalog__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .featured-catalog__title {
    max-width: 42rem;
    margin-top: 0.75rem;
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.04;
  }

  .featured-catalog__text {
    max-width: 34rem;
    color: var(--theme-color-text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .featured-catalog__slider-wrap {
    position: relative;
  }

  .featured-catalog__arrow {
    position: absolute;
    top: 50%;
    z-index: 3;
    display: inline-flex;
    width: 3rem;
    height: 3rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    color: var(--theme-color-text);
    background: rgba(4, 11, 24, 0.72);
    cursor: pointer;
    pointer-events: auto;
    transform: translateY(-50%);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .featured-catalog__arrow[hidden] {
    display: none;
  }

  .featured-catalog__arrow--prev {
    left: 0.4rem;
  }

  .featured-catalog__arrow--next {
    right: 0.4rem;
  }

  @media (max-width: 749px) {
    .featured-catalog__header {
      display: grid;
      gap: 1rem;
    }

    .featured-catalog__slider-wrap {
      margin-inline: calc(var(--page-margin) * -1);
    }

    .featured-catalog__grid {
      display: grid;
      grid-template-columns: none;
      grid-auto-columns: minmax(14.8rem, 76%);
      grid-auto-flow: column;
      gap: 1rem;
      overflow-x: auto;
      overflow-y: hidden;
      padding: 0 var(--page-margin) 0.75rem;
      scroll-padding-inline: var(--page-margin);
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -ms-overflow-style: none;
      -webkit-overflow-scrolling: touch;
    }

    .featured-catalog__grid::-webkit-scrollbar {
      display: none;
    }

    .featured-catalog__grid .product-card {
      scroll-snap-align: start;
    }
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Featured catalog",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Featured products"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured catalog"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "number",
      "id": "product_limit",
      "label": "Product limit",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Featured catalog"
    }
  ]
}
{% endschema %}
