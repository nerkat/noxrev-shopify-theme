{% liquid
  assign product_limit = section.settings.product_limit | default: 8 | at_least: 1 | at_most: 8

  if section.settings.collection != blank
    assign catalog_collection = section.settings.collection
  else
    assign catalog_collection = collections.all
  endif
%}

<section class="container section featured-catalog">
  <header class="featured-catalog__header">
    <div>
      {% if section.settings.eyebrow != blank %}
        <p class="kicker">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="featured-catalog__title heading-gradient">{{ section.settings.heading | escape }}</h2>
      {% endif %}
    </div>

    {% if section.settings.text != blank %}
      <p class="featured-catalog__text">{{ section.settings.text | escape }}</p>
    {% endif %}
  </header>

  <div class="featured-catalog__slider-wrap noxrev-slider" data-noxrev-slider data-noxrev-slider-step-card=".product-card">
    <div class="featured-catalog__grid grid grid--5" data-noxrev-slider-track>
      {% for product in catalog_collection.products limit: product_limit %}
        {% render 'product-card', product: product, show_vendor: section.settings.show_vendor %}
      {% endfor %}
    </div>

    <button
      class="featured-catalog__arrow noxrev-slider__arrow noxrev-slider__arrow--prev"
      type="button"
      aria-label="Previous featured products"
      data-noxrev-slider-prev
      hidden
    >
      <span aria-hidden="true">&lsaquo;</span>
    </button>
    <button
      class="featured-catalog__arrow noxrev-slider__arrow noxrev-slider__arrow--next"
      type="button"
      aria-label="Next featured products"
      data-noxrev-slider-next
      hidden
    >
      <span aria-hidden="true">&rsaquo;</span>
    </button>
  </div>
</section>

{% stylesheet %}
  .featured-catalog__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .featured-catalog__title {
    max-width: 42rem;
    margin-top: 0.75rem;
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.04;
  }

  .featured-catalog__text {
    max-width: 34rem;
    color: var(--theme-color-text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  @media (max-width: 749px) {
    .featured-catalog__header {
      display: grid;
      gap: 1rem;
    }

    .featured-catalog__slider-wrap {
      margin-inline: calc(var(--page-margin) * -1);
    }

    .featured-catalog__grid {
      display: grid;
      grid-template-columns: none;
      grid-auto-columns: minmax(14.8rem, 76%);
      grid-auto-flow: column;
      gap: 1rem;
      overflow-x: auto;
      overflow-y: hidden;
      padding: 0 var(--page-margin) 0.75rem;
      scroll-padding-inline: var(--page-margin);
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -ms-overflow-style: none;
      -webkit-overflow-scrolling: touch;
    }

    .featured-catalog__grid::-webkit-scrollbar {
      display: none;
    }

    .featured-catalog__grid .product-card {
      scroll-snap-align: start;
    }
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Featured catalog",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Featured products"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured catalog"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "number",
      "id": "product_limit",
      "label": "Product limit",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Featured catalog"
    }
  ]
}
{% endschema %}
