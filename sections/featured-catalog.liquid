{% liquid
  assign product_limit = section.settings.product_limit | default: 8 | at_least: 1 | at_most: 8

  if section.settings.collection != blank
    assign catalog_collection = section.settings.collection
  else
    assign catalog_collection = collections.all
  endif
%}

<section class="featured-catalog">
  {% if section.settings.heading != blank %}
    <header class="featured-catalog__header">
      <h2 class="featured-catalog__title">{{ section.settings.heading | escape }}</h2>
    </header>
  {% endif %}

  <div class="featured-catalog__grid">
    {% for product in catalog_collection.products limit: product_limit %}
      <article class="featured-catalog__item">
        <a class="featured-catalog__link" href="{{ product.url }}">
          {% render 'responsive-image',
            image: product.featured_image,
            alt: product.title,
            class: 'featured-catalog__image',
            loading: 'lazy',
            sizes: '(min-width: 861px) 25vw, 50vw',
            widths: '240, 360, 540, 720, 960'
          %}

          <div class="featured-catalog__content">
            <h3 class="featured-catalog__product-title">{{ product.title | escape }}</h3>
            <p class="featured-catalog__price">{% render 'price', amount: product.price %}</p>
          </div>
        </a>
      </article>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .featured-catalog {
    padding: 3rem 0;
  }

  .featured-catalog__header {
    margin-bottom: 1.25rem;
  }

  .featured-catalog__title {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .featured-catalog__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .featured-catalog__link {
    display: grid;
    gap: 0.75rem;
    color: inherit;
    text-decoration: none;
  }

  .featured-catalog__image {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: #f3f3f3;
  }

  .featured-catalog__content {
    display: grid;
    gap: 0.25rem;
  }

  .featured-catalog__product-title {
    font-size: 1rem;
  }

  @media (max-width: 860px) {
    .featured-catalog__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured catalog",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured catalog"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "number",
      "id": "product_limit",
      "label": "Product limit",
      "default": 8
    }
  ]
}
{% endschema %}