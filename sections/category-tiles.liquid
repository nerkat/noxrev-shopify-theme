{% style %}{% if section.settings.layout_gap > 0 %}#shopify-section-{{ section.id }} .category-tiles__grid{gap:{{ section.settings.layout_gap }}px}{% endif %}@media(min-width:750px){ {% unless section.settings.layout_columns == 'inherit' %}#shopify-section-{{ section.id }} .category-tiles__grid{display:grid;grid-template-columns:repeat({{ section.settings.layout_columns }},minmax(0,1fr))}{% endunless %}}@media(max-width:749px){ {% unless section.settings.layout_mobile_columns == 'inherit' %}#shopify-section-{{ section.id }} .category-tiles__grid{display:grid;grid-template-columns:repeat({{ section.settings.layout_mobile_columns }},minmax(0,1fr))}{% endunless %}}{% unless section.settings.layout_media_fit == 'inherit' %}#shopify-section-{{ section.id }} .category-tiles__media img{object-fit:{{ section.settings.layout_media_fit }}}{% endunless %}{% unless section.settings.layout_media_ratio == 'inherit' %}#shopify-section-{{ section.id }} .category-tiles__media img{aspect-ratio:{{ section.settings.layout_media_ratio }};height:auto}{% endunless %}@media(min-width:750px){ {% unless section.settings.layout_media_order == 'inherit' %}#shopify-section-{{ section.id }} .category-tiles__media{order:{% if section.settings.layout_media_order == 'first' %}-1{% else %}10{% endif %}}{% endunless %}}@media(max-width:749px){ {% unless section.settings.layout_media_order_mobile == 'inherit' %}#shopify-section-{{ section.id }} .category-tiles__media{order:{% if section.settings.layout_media_order_mobile == 'first' %}-1{% else %}10{% endif %}}{% endunless %}}{% endstyle %}
{% render 'section-layout', section: section %}
{% if section.blocks.size > 0 %}
  <section class="container section category-tiles">
    <div
      class="category-tiles__header"
      style="--category-tiles-header-spacing: {{ section.settings.header_bottom_spacing | default: 32 }}px;"
    >
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="kicker">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="category-tiles__title heading-gradient">{{ section.settings.heading | escape }}</h2>
        {% endif %}
      </div>

      {% if section.settings.text != blank %}
        <p class="category-tiles__text">{{ section.settings.text | escape }}</p>
      {% endif %}
    </div>

    <div class="category-tiles__grid grid grid--3">
      {% for block in section.blocks %}
        {% liquid
          assign tile_collection = block.settings.collection
          assign tile_image = block.settings.image | default: tile_collection.featured_image
          assign tile_alt = block.settings.image_alt | default: block.settings.title | default: tile_collection.title
          assign tile_title = block.settings.title
          assign tile_text = block.settings.text

          if tile_title == blank and tile_collection != blank
            assign tile_title = tile_collection.title
          endif

          if tile_text == blank and tile_collection != blank
            assign tile_text = tile_collection.description | strip_html | truncatewords: 18
          endif
        %}

        <article class="category-tiles__item" {{ block.shopify_attributes }}>
          {% if tile_collection != blank %}
            <a class="category-tiles__tile panel link-surface" href="{{ tile_collection.url }}">
          {% else %}
            <div class="category-tiles__tile panel">
          {% endif %}

          <div class="category-tiles__media">
            {% render 'responsive-image',
              image: tile_image,
              alt: tile_alt,
              class: 'category-tiles__image',
              loading: 'lazy',
              sizes: '(min-width: 861px) 33vw, 100vw',
              widths: '320, 480, 720, 960'
            %}
          </div>

          <div class="category-tiles__content">
            {% if block.settings.eyebrow != blank %}
              <p class="category-tiles__eyebrow">{{ block.settings.eyebrow | escape }}</p>
            {% endif %}
            <h3 class="category-tiles__item-title">{{ tile_title | default: 'Collection' | escape }}</h3>

            {% if tile_text != blank %}
              <p class="category-tiles__item-text">{{ tile_text | escape }}</p>
            {% endif %}
          </div>

          {% if tile_collection != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .category-tiles__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: var(--category-tiles-header-spacing, 2rem);
  }

  .category-tiles__title {
    max-width: 38rem;
    margin-top: 0.75rem;
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.04;
  }

  .category-tiles__text {
    max-width: 34rem;
    color: var(--theme-color-text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .category-tiles__tile {
    overflow: hidden;
    border-radius: var(--theme-radius-xl);
    display: grid;
    gap: 0;
    color: inherit;
    text-decoration: none;
  }

  .category-tiles__media {
    position: relative;
    background: rgba(0, 0, 0, 0.3);
    border-bottom: 1px solid var(--theme-color-border);
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .category-tiles__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--theme-color-background), rgba(4, 11, 24, 0.08), transparent);
    pointer-events: none;
  }

  .category-tiles__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .category-tiles__tile:hover .category-tiles__image {
    transform: scale(1.04);
  }

  .category-tiles__content {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem;
  }

  .category-tiles__eyebrow {
    margin: 0;
    color: var(--theme-color-accent);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .category-tiles__item-title {
    margin: 0;
    color: var(--theme-color-text);
    font-size: 1.15rem;
    line-height: 1.3;
  }

  .category-tiles__item-text {
    margin: 0;
    color: var(--theme-color-text-muted);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  @media (max-width: 860px) {
    .category-tiles__header {
      display: grid;
      gap: 1rem;
    }
  }
{% endstylesheet %}

