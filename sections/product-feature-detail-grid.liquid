{% style %}{% if section.settings.layout_gap > 0 %}#shopify-section-{{ section.id }} .product-feature-detail-grid__grid{gap:{{ section.settings.layout_gap }}px}{% endif %}@media(min-width:750px){ {% unless section.settings.layout_columns == 'inherit' %}#shopify-section-{{ section.id }} .product-feature-detail-grid__grid{display:grid;grid-template-columns:repeat({{ section.settings.layout_columns }},minmax(0,1fr))}{% endunless %}}@media(max-width:749px){ {% unless section.settings.layout_mobile_columns == 'inherit' %}#shopify-section-{{ section.id }} .product-feature-detail-grid__grid{display:grid;grid-template-columns:repeat({{ section.settings.layout_mobile_columns }},minmax(0,1fr))}{% endunless %}}{% unless section.settings.layout_media_fit == 'inherit' %}#shopify-section-{{ section.id }} .product-feature-detail-grid__media img{object-fit:{{ section.settings.layout_media_fit }}}{% endunless %}{% unless section.settings.layout_media_ratio == 'inherit' %}#shopify-section-{{ section.id }} .product-feature-detail-grid__media img{aspect-ratio:{{ section.settings.layout_media_ratio }};height:auto}{% endunless %}@media(min-width:750px){ {% unless section.settings.layout_media_order == 'inherit' %}#shopify-section-{{ section.id }} .product-feature-detail-grid__media{order:{% if section.settings.layout_media_order == 'first' %}-1{% else %}10{% endif %}}{% endunless %}}@media(max-width:749px){ {% unless section.settings.layout_media_order_mobile == 'inherit' %}#shopify-section-{{ section.id }} .product-feature-detail-grid__media{order:{% if section.settings.layout_media_order_mobile == 'first' %}-1{% else %}10{% endif %}}{% endunless %}}{% endstyle %}
{% render 'section-layout', section: section %}
<section class="product-feature-detail-grid section">
  <div class="container">
    <div class="product-feature-detail-grid__grid">
      {% for block in section.blocks %}
        {% liquid
          assign card_image = block.settings.image | default: product.featured_media.preview_image
        %}
        <article class="product-feature-detail-grid__card" {{ block.shopify_attributes }}>
          <div class="product-feature-detail-grid__copy">
            <span class="product-feature-detail-grid__icon" aria-hidden="true">
              {% if block.settings.icon_image != blank %}
                {{ block.settings.icon_image | image_url: width: 64 | image_tag: loading: 'lazy', alt: '', class: 'product-feature-detail-grid__icon-image' }}
              {% else %}
                {% render 'product-marketing-icon', icon: block.settings.icon %}
              {% endif %}
            </span>
            <div>
              <h2 class="product-feature-detail-grid__title">{{ block.settings.title }}</h2>
              <p class="product-feature-detail-grid__text">{{ block.settings.text }}</p>
            </div>
          </div>

          <div class="product-feature-detail-grid__media">
            {% if card_image != blank %}
              {% assign card_image_alt = block.settings.image_alt | default: block.settings.title %}
              {% render 'responsive-image',
                image: card_image,
                alt: card_image_alt,
                class: 'product-feature-detail-grid__image',
                loading: 'lazy',
                sizes: '(min-width: 900px) 25vw, 50vw',
                widths: '220, 360, 520, 720'
              %}
            {% else %}
              <div class="product-feature-detail-grid__placeholder" aria-hidden="true"></div>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>



