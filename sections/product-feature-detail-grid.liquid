<section class="product-feature-detail-grid section">
  <div class="container">
    <div class="product-feature-detail-grid__grid">
      {% for block in section.blocks %}
        {% liquid
          assign card_image = block.settings.image | default: product.featured_media.preview_image
        %}
        <article class="product-feature-detail-grid__card" {{ block.shopify_attributes }}>
          <div class="product-feature-detail-grid__copy">
            <span class="product-feature-detail-grid__icon" aria-hidden="true">
              {% if block.settings.icon_image != blank %}
                {{ block.settings.icon_image | image_url: width: 64 | image_tag: loading: 'lazy', alt: '', class: 'product-feature-detail-grid__icon-image' }}
              {% else %}
                {% render 'product-marketing-icon', icon: block.settings.icon %}
              {% endif %}
            </span>
            <div>
              <h2 class="product-feature-detail-grid__title">{{ block.settings.title }}</h2>
              <p class="product-feature-detail-grid__text">{{ block.settings.text }}</p>
            </div>
          </div>

          <div class="product-feature-detail-grid__media">
            {% if card_image != blank %}
              {% assign card_image_alt = block.settings.image_alt | default: block.settings.title %}
              {% render 'responsive-image',
                image: card_image,
                alt: card_image_alt,
                class: 'product-feature-detail-grid__image',
                loading: 'lazy',
                sizes: '(min-width: 900px) 25vw, 50vw',
                widths: '220, 360, 520, 720'
              %}
            {% else %}
              <div class="product-feature-detail-grid__placeholder" aria-hidden="true"></div>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>



{% schema %}
{
  "name": "PDP Feature Grid",
  "blocks": [
    {
      "type": "detail_card",
      "name": "Feature card",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Secure, Form-Fit Protection" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Durable and precise. Protects your iPad from everyday bumps, drops, and scratches." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        { "type": "select", "id": "icon", "label": "Fallback icon", "default": "shield", "options": [
          { "value": "shield", "label": "Shield" },
          { "value": "draw", "label": "Pencil" },
          { "value": "type", "label": "Keyboard" },
          { "value": "bolt", "label": "Bolt" },
          { "value": "magnet", "label": "Magnet" },
          { "value": "trackpad", "label": "Trackpad" }
        ] },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP Feature Grid",
      "blocks": [
        { "type": "detail_card", "settings": { "title": "Secure, Form-Fit Protection", "text": "Durable and precise. Protects your iPad from everyday bumps, drops, and scratches.", "icon": "shield" } },
        { "type": "detail_card", "settings": { "title": "Pencil Storage", "text": "Built-in drawer keeps your Apple Pencil safe and always within reach.", "icon": "draw" } },
        { "type": "detail_card", "settings": { "title": "Mute Button", "text": "Instant mute for quiet focus anytime, anywhere.", "icon": "type" } },
        { "type": "detail_card", "settings": { "title": "Fast Charging", "text": "USB-C fast charging for uninterrupted productivity.", "icon": "bolt" } }
      ]
    }
  ]
}
{% endschema %}
