{% render 'section-layout', section: section %}
<section class="product-feature-icon-strip section">
  <div class="container">
    <div class="product-feature-icon-strip__panel" role="list">
      {% for block in section.blocks %}
        <div class="product-feature-icon-strip__item" role="listitem" {{ block.shopify_attributes }}>
          <span class="product-feature-icon-strip__icon" aria-hidden="true">
            {% if block.settings.icon_image != blank %}
              {{ block.settings.icon_image | image_url: width: 72 | image_tag: loading: 'lazy', alt: '', class: 'product-feature-icon-strip__icon-image' }}
            {% else %}
              {% render 'product-marketing-icon', icon: block.settings.icon %}
            {% endif %}
          </span>
          <span>
            <strong>{{ block.settings.title }}</strong>
            <small>{{ block.settings.subtitle }}</small>
          </span>
        </div>
      {% endfor %}
    </div>
  </div>
</section>



{% schema %}
{
  "name": "PDP Feature Strip",
  "blocks": [
    {
      "type": "feature_item",
      "name": "Feature item",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "360 Degree Rotation"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Smooth and flexible"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Fallback icon",
          "default": "rotation",
          "options": [
            {
              "value": "rotation",
              "label": "Rotation"
            },
            {
              "value": "keyboard",
              "label": "Keyboard"
            },
            {
              "value": "trackpad",
              "label": "Trackpad"
            },
            {
              "value": "magnet",
              "label": "Magnet"
            },
            {
              "value": "shield",
              "label": "Shield"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP Feature Strip",
      "blocks": [
        {
          "type": "feature_item",
          "settings": {
            "title": "360 Degree Rotation",
            "subtitle": "Smooth and flexible",
            "icon": "rotation"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "title": "Backlit Keyboard",
            "subtitle": "7 colors, 3 brightness levels",
            "icon": "keyboard"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "title": "Precision Trackpad",
            "subtitle": "Multi-touch and gestures",
            "icon": "trackpad"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "title": "Magnetic Attachment",
            "subtitle": "Strong hold, easy detach",
            "icon": "magnet"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "title": "Premium Materials",
            "subtitle": "Aluminum alloy and PU leather",
            "icon": "shield"
          }
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_width",
      "label": "Content width",
      "options": [
        {
          "value": "inherit",
          "label": "Current width"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "layout_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "inherit",
          "label": "Current alignment"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "checkbox",
      "id": "custom_spacing",
      "label": "Use custom section spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top spacing mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom spacing mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "checkbox",
      "id": "use_section_scheme",
      "label": "Use section color scheme",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "device_visibility",
      "label": "Device visibility",
      "options": [
        {
          "value": "both",
          "label": "Both"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        }
      ],
      "default": "both"
    }
  ]
}
{% endschema %}

