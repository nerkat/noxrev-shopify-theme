<section class="product-feature-icon-strip section">
  <div class="container">
    <div class="product-feature-icon-strip__panel" role="list">
      {% for block in section.blocks %}
        <div class="product-feature-icon-strip__item" role="listitem" {{ block.shopify_attributes }}>
          <span class="product-feature-icon-strip__icon" aria-hidden="true">
            {% if block.settings.icon_image != blank %}
              {{ block.settings.icon_image | image_url: width: 72 | image_tag: loading: 'lazy', alt: '', class: 'product-feature-icon-strip__icon-image' }}
            {% else %}
              {% render 'product-marketing-icon', icon: block.settings.icon %}
            {% endif %}
          </span>
          <span>
            <strong>{{ block.settings.title }}</strong>
            <small>{{ block.settings.subtitle }}</small>
          </span>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .product-feature-icon-strip {
    padding: 0 0 1.5rem;
  }

  .product-feature-icon-strip__panel {
    display: grid;
    gap: 0.75rem;
    border-top: 1px solid rgba(56, 221, 255, 0.18);
    padding-top: 1rem;
  }

  .product-feature-icon-strip__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    align-items: center;
    color: rgba(255, 255, 255, 0.78);
  }

  .product-feature-icon-strip__item strong,
  .product-feature-icon-strip__item small {
    display: block;
  }

  .product-feature-icon-strip__item strong {
    color: var(--theme-color-text);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.15;
  }

  .product-feature-icon-strip__item small {
    margin-top: 0.2rem;
    font-size: 0.74rem;
    line-height: 1.25;
  }

  .product-feature-icon-strip__icon {
    display: inline-flex;
    width: 2.8rem;
    height: 2.8rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(0, 229, 255, 0.32);
    border-radius: 999px;
    color: #27efff;
    background: rgba(3, 12, 24, 0.72);
  }

  .product-feature-icon-strip__icon svg,
  .product-feature-icon-strip__icon-image {
    width: 1.35rem;
    height: 1.35rem;
    object-fit: contain;
  }

  @media (min-width: 700px) {
    .product-feature-icon-strip__panel {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .product-feature-icon-strip__panel {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .product-feature-icon-strip__item {
      padding-right: 0.9rem;
      border-right: 1px solid rgba(255, 255, 255, 0.09);
    }

    .product-feature-icon-strip__item:last-child {
      border-right: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP Feature Strip",
  "blocks": [
    {
      "type": "feature_item",
      "name": "Feature item",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "360 Degree Rotation" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Smooth and flexible" },
        { "type": "select", "id": "icon", "label": "Fallback icon", "default": "rotation", "options": [
          { "value": "rotation", "label": "Rotation" },
          { "value": "keyboard", "label": "Keyboard" },
          { "value": "trackpad", "label": "Trackpad" },
          { "value": "magnet", "label": "Magnet" },
          { "value": "shield", "label": "Shield" }
        ] },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP Feature Strip",
      "blocks": [
        { "type": "feature_item", "settings": { "title": "360 Degree Rotation", "subtitle": "Smooth and flexible", "icon": "rotation" } },
        { "type": "feature_item", "settings": { "title": "Backlit Keyboard", "subtitle": "7 colors, 3 brightness levels", "icon": "keyboard" } },
        { "type": "feature_item", "settings": { "title": "Precision Trackpad", "subtitle": "Multi-touch and gestures", "icon": "trackpad" } },
        { "type": "feature_item", "settings": { "title": "Magnetic Attachment", "subtitle": "Strong hold, easy detach", "icon": "magnet" } },
        { "type": "feature_item", "settings": { "title": "Premium Materials", "subtitle": "Aluminum alloy and PU leather", "icon": "shield" } }
      ]
    }
  ]
}
{% endschema %}
