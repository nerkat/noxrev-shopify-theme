<section class="product-accessory-bundle section">
  <article class="product-accessory-bundle__panel">
    <div class="product-accessory-bundle__header container">
      <div>
        <p class="product-accessory-bundle__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="product-accessory-bundle__title">{{ section.settings.title }}</h2>
        <p class="product-accessory-bundle__text">{{ section.settings.text }}</p>
      </div>

      {% if section.settings.pill_text != blank %}
        <div class="product-accessory-bundle__pill">
          <span class="product-accessory-bundle__pill-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" focusable="false">
              <path d="M20.6 13.2 13.2 20.6a2 2 0 0 1-2.8 0l-7-7A2 2 0 0 1 2.8 12V5a2 2 0 0 1 2-2h7a2 2 0 0 1 1.4.6l7.4 7.4a2 2 0 0 1 0 2.8Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              <circle cx="7.8" cy="7.8" r="1.2" fill="currentColor"/>
            </svg>
          </span>
          <strong>{{ section.settings.pill_label }}</strong>
          <span>{{ section.settings.pill_text }}</span>
        </div>
      {% endif %}
    </div>

      <div class="product-accessory-bundle__slider-wrap" data-accessory-bundle>
        <div class="product-accessory-bundle__grid" data-accessory-bundle-slider>
          {% for block in section.blocks %}
            {% liquid
              assign accessory_product = block.settings.product
              assign accessory_variant = blank
              assign card_title = block.settings.title
              assign card_text = block.settings.text
              assign card_image = block.settings.image
              assign card_price = block.settings.price
              assign card_compare_price = block.settings.compare_price
              assign card_url = block.settings.link
              assign can_add_accessory = false

              if accessory_product != blank
                assign accessory_variant = accessory_product.selected_or_first_available_variant
                assign card_title = accessory_product.title
                assign card_url = accessory_product.url
                if card_image == blank
                  assign card_image = accessory_product.featured_media.preview_image
                endif
                if accessory_variant != blank
                  assign card_price = accessory_variant.price | money
                  if accessory_variant.compare_at_price > accessory_variant.price
                    assign card_compare_price = accessory_variant.compare_at_price | money
                  endif
                  if accessory_variant.available
                    assign can_add_accessory = true
                  endif
                endif
              endif

              if card_image == blank
                assign card_image = product.featured_media.preview_image
              endif

              assign savings_percent = blank
              if accessory_product != blank and accessory_product.compare_at_price > accessory_product.price
                assign savings_amount = accessory_product.compare_at_price | minus: accessory_product.price
                assign savings_percent = savings_amount | times: 100 | divided_by: accessory_product.compare_at_price
              elsif block.settings.savings_label != blank
                assign savings_percent = block.settings.savings_label
              endif
            %}

            <article
              class="product-accessory-bundle__card{% unless can_add_accessory %} is-unavailable{% endunless %}"
              {% if accessory_variant != blank %}
                data-accessory-card
                data-variant-id="{{ accessory_variant.id }}"
              {% endif %}
              data-add-label="{{ block.settings.button_label | escape }}"
              data-added-label="Added"
              {{ block.shopify_attributes }}
            >
              {% if accessory_product != blank and accessory_variant != blank %}
                <form
                  class="product-accessory-bundle__form"
                  method="post"
                  action="{{ routes.cart_add_url }}"
                  data-accessory-bundle-form
                >
                  <input type="hidden" name="id" value="{{ accessory_variant.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <button
                    class="product-accessory-bundle__select"
                    type="submit"
                    data-cart-compact-submit
                    data-accessory-toggle
                    {% unless can_add_accessory %}
                      disabled
                    {% endunless %}
                    aria-label="Add {{ card_title | escape }} to cart"
                  >
                    <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true">
                      <path d="m6 12 4 4 8-8" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                </form>
              {% else %}
                <div class="product-accessory-bundle__select" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" focusable="false">
                    <path d="m6 12 4 4 8-8" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              {% endif %}

              {% if block.settings.badge != blank %}
                <span class="product-accessory-bundle__badge">{{ block.settings.badge }}</span>
              {% endif %}

              <div class="product-accessory-bundle__media">
                {% if card_image != blank %}
                  {%
                    render 'responsive-image',
                    image: card_image,
                    alt: block.settings.image_alt | default: card_title,
                    class: 'product-accessory-bundle__image',
                    loading: 'lazy',
                    sizes: '(min-width: 900px) 24vw, 78vw',
                    widths: '320, 520, 720, 900'
                  %}
                {% else %}
                  <div class="product-accessory-bundle__placeholder" aria-hidden="true"></div>
                {% endif %}
              </div>

              <div class="product-accessory-bundle__content">
                <div class="product-accessory-bundle__copy">
                  <h3 class="product-accessory-bundle__card-title">
                    {% if card_url != blank %}
                      <a href="{{ card_url }}">{{ card_title }}</a>
                    {% else %}
                      {{ card_title }}
                    {% endif %}
                  </h3>
                  <p class="product-accessory-bundle__card-text">{{ card_text }}</p>
                </div>

                <div class="product-accessory-bundle__purchase">
                  <div class="product-accessory-bundle__price-row">
                    {% if card_price != blank %}
                      <span class="product-accessory-bundle__price">{{ card_price }}</span>
                    {% endif %}
                    {% if card_compare_price != blank %}
                      <s class="product-accessory-bundle__compare">{{ card_compare_price }}</s>
                    {% endif %}
                    {% if savings_percent != blank %}
                      <span class="product-accessory-bundle__save">
                        {% if accessory_product != blank %}
                          Save {{ savings_percent }}%
                        {% else %}
                          {{ savings_percent }}
                        {% endif %}
                      </span>
                    {% endif %}
                  </div>

                  {% if accessory_product != blank and accessory_variant != blank %}
                    <form
                      class="product-accessory-bundle__form"
                      method="post"
                      action="{{ routes.cart_add_url }}"
                      data-accessory-bundle-form
                    >
                      <input type="hidden" name="id" value="{{ accessory_variant.id }}">
                      <input type="hidden" name="quantity" value="1">
                      <button
                        class="product-accessory-bundle__button"
                        type="submit"
                        {% unless can_add_accessory %}
                          disabled
                        {% endunless %}
                      >
                        <span aria-hidden="true" data-accessory-button-icon>+</span>
                        <span data-accessory-button-text>
                          {% if can_add_accessory %}
                            {{ block.settings.button_label }}
                          {% else %}
                            Sold out
                          {% endif %}
                        </span>
                      </button>
                    </form>
                  {% else %}
                    <span class="product-accessory-bundle__button product-accessory-bundle__button--disabled">
                      <span aria-hidden="true">+</span>
                      <span>Select product</span>
                    </span>
                  {% endif %}
                </div>
              </div>
            </article>
          {% endfor %}
        </div>

        <button
          class="product-accessory-bundle__arrow product-accessory-bundle__arrow--prev"
          type="button"
          aria-label="Previous accessories"
          data-accessory-bundle-prev
        >
          <span aria-hidden="true">&lsaquo;</span>
        </button>
        <button
          class="product-accessory-bundle__arrow product-accessory-bundle__arrow--next"
          type="button"
          aria-label="Next accessories"
          data-accessory-bundle-next
        >
          <span aria-hidden="true">&rsaquo;</span>
        </button>
      </div>
  </article>
</section>

<script>
  (() => {
    const initAccessoryBundleSliders = (root = document) => {
      const bundles = root.querySelectorAll('[data-accessory-bundle]');

      bundles.forEach((bundle) => {
        if (bundle.dataset.accessoryBundleReady === 'true') return;
        bundle.dataset.accessoryBundleReady = 'true';

        const slider = bundle.querySelector('[data-accessory-bundle-slider]');
        const prev = bundle.querySelector('[data-accessory-bundle-prev]');
        const next = bundle.querySelector('[data-accessory-bundle-next]');
        if (!slider || !prev || !next) return;

        const getStep = () => {
          const card = slider.querySelector('.product-accessory-bundle__card');
          return card ? card.getBoundingClientRect().width + 16 : slider.clientWidth * 0.82;
        };

        const updateButtons = () => {
          const maxScroll = slider.scrollWidth - slider.clientWidth;
          const hasOverflow = maxScroll > 2;
          prev.hidden = !hasOverflow || slider.scrollLeft <= 2;
          next.hidden = !hasOverflow || slider.scrollLeft >= maxScroll - 2;
        };

        const scrollByDirection = (direction) => {
          const maxScroll = slider.scrollWidth - slider.clientWidth;
          const target = Math.max(0, Math.min(maxScroll, slider.scrollLeft + getStep() * direction));
          slider.scrollTo({ left: target, behavior: 'smooth' });
          window.setTimeout(updateButtons, 260);
        };

        prev.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          scrollByDirection(-1);
        });

        next.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          scrollByDirection(1);
        });

        slider.addEventListener('scroll', updateButtons, { passive: true });
        window.addEventListener('resize', updateButtons);
        updateButtons();
      });
    };

    initAccessoryBundleSliders();

    if (!window.__noxrevAccessoryBundleSubmitReady) {
      window.__noxrevAccessoryBundleSubmitReady = true;

      const rootPath = () => window.Shopify?.routes?.root || '/';

      const updateHeaderCartCount = (count) => {
        document.querySelectorAll('.header__cart-count').forEach((element) => {
          element.textContent = count;
        });
      };

      const publishCartUpdate = (cart) => {
        window.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart } }));
      };

      const getDrawerSectionId = () => document.querySelector('[data-cart-drawer]')?.dataset.sectionId || 'cart-drawer';

      const replaceCartDrawer = (html) => {
        const currentDrawer = document.querySelector('[data-cart-drawer]');
        if (!currentDrawer || !html) return;

        const parsed = new DOMParser().parseFromString(html, 'text/html');
        const nextDrawer = parsed.querySelector('[data-cart-drawer]');
        if (nextDrawer) {
          currentDrawer.replaceWith(nextDrawer);
        }
      };

      const refreshCartDrawer = async (sectionHtml) => {
        if (sectionHtml) {
          replaceCartDrawer(sectionHtml);
          return;
        }

        const url = new URL(window.location.href);
        url.searchParams.set('section_id', getDrawerSectionId());
        const response = await fetch(url.toString(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        if (response.ok) {
          replaceCartDrawer(await response.text());
        }
      };

      const setCardAddedState = (card, isAdded) => {
        const button = card.querySelector('.product-accessory-bundle__button');
        const buttonText = card.querySelector('[data-accessory-button-text]');
        const buttonIcon = card.querySelector('[data-accessory-button-icon]');
        const toggle = card.querySelector('[data-accessory-toggle]');
        const label = card.dataset.addLabel || 'Add';
        const addedLabel = card.dataset.addedLabel || 'Added';

        card.classList.toggle('is-added', isAdded);
        card.toggleAttribute('data-accessory-added', isAdded);

        if (button) {
          button.disabled = isAdded || card.classList.contains('is-unavailable');
        }

        if (buttonText) {
          buttonText.textContent = isAdded ? addedLabel : label;
        }

        if (buttonIcon) {
          buttonIcon.textContent = isAdded ? '✓' : '+';
        }

        if (toggle) {
          const title = card.querySelector('.product-accessory-bundle__card-title')?.textContent?.trim() || 'accessory';
          toggle.setAttribute('aria-label', isAdded ? `Remove ${title} from cart` : `Add ${title} to cart`);
        }
      };

      const syncBundleCards = (cart) => {
        const variantIds = new Set((cart.items || []).map((item) => String(item.variant_id)));
        document.querySelectorAll('[data-accessory-card]').forEach((card) => {
          setCardAddedState(card, variantIds.has(String(card.dataset.variantId)));
        });
      };

      const setCardBusy = (card, isBusy) => {
        card.classList.toggle('is-loading', isBusy);
        card.querySelectorAll('button').forEach((button) => {
          if (!card.hasAttribute('data-accessory-added')) {
            button.disabled = isBusy || card.classList.contains('is-unavailable');
          } else if (!button.matches('[data-accessory-toggle]')) {
            button.disabled = true;
          } else {
            button.disabled = isBusy;
          }
        });
      };

      const fetchCart = async () => {
        const response = await fetch(`${rootPath()}cart.js`, { headers: { Accept: 'application/json' } });
        if (!response.ok) throw new Error('Unable to refresh cart.');
        return response.json();
      };

      const addAccessory = async (form, card) => {
        const wasAdded = card.hasAttribute('data-accessory-added');
        setCardAddedState(card, true);
        setCardBusy(card, true);

        try {
          const response = await fetch(`${rootPath()}cart/add.js`, {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: new FormData(form),
          });

          const result = await response.json();
          if (!response.ok) {
            throw new Error(result.description || result.message || 'Unable to add item to cart.');
          }

          await refreshCartDrawer();
          const cart = await fetchCart();
          updateHeaderCartCount(cart.item_count || 0);
          publishCartUpdate(cart);
          syncBundleCards(cart);
        } catch (error) {
          setCardAddedState(card, wasAdded);
          console.error(error);
        } finally {
          setCardBusy(card, false);
        }
      };

      const removeAccessory = async (card) => {
        const variantId = card.dataset.variantId;
        if (!variantId) return;

        const wasAdded = card.hasAttribute('data-accessory-added');
        setCardAddedState(card, false);
        setCardBusy(card, true);

        try {
          const currentCart = await fetchCart();
          const matchingItem = (currentCart.items || []).find((item) => String(item.variant_id) === String(variantId));

          if (!matchingItem?.key) {
            syncBundleCards(currentCart);
            return;
          }

          const response = await fetch(`${rootPath()}cart/change.js`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json',
            },
            body: JSON.stringify({
              id: matchingItem.key,
              quantity: 0,
              sections: [getDrawerSectionId()],
              sections_url: window.location.pathname,
            }),
          });

          const cart = await response.json();
          if (!response.ok) {
            throw new Error(cart.description || cart.message || 'Unable to remove item from cart.');
          }

          await refreshCartDrawer(cart.sections?.[getDrawerSectionId()]);
          updateHeaderCartCount(cart.item_count || 0);
          publishCartUpdate(cart);
          syncBundleCards(cart);
        } catch (error) {
          setCardAddedState(card, wasAdded);
          console.error(error);
        } finally {
          setCardBusy(card, false);
        }
      };

      document.addEventListener(
        'submit',
        (event) => {
          const form = event.target.closest('[data-accessory-bundle-form]');
          if (!form) return;

          const card = form.closest('[data-accessory-card]');
          if (!card) return;

          event.preventDefault();
          event.stopImmediatePropagation();

          if (card.hasAttribute('data-accessory-added')) return;

          addAccessory(form, card);
        },
        true
      );

      document.addEventListener(
        'click',
        (event) => {
          const toggle = event.target.closest('[data-accessory-toggle]');
          if (!toggle) return;

          const card = toggle.closest('[data-accessory-card]');
          if (!card || !card.hasAttribute('data-accessory-added')) return;

          event.preventDefault();
          event.stopImmediatePropagation();
          removeAccessory(card);
        },
        true
      );

      fetchCart()
        .then(syncBundleCards)
        .catch(() => {});

      window.addEventListener('cart:updated', (event) => {
        if (event.detail?.cart) {
          syncBundleCards(event.detail.cart);
        }
      });
    }

    document.addEventListener('shopify:section:load', (event) => {
      initAccessoryBundleSliders(event.target);
    });
  })();
</script>

{% stylesheet %}
  .product-accessory-bundle {
    padding: 0 0 1.5rem;
  }

  .product-accessory-bundle__panel {
    overflow: hidden;
    border-radius: 1.35rem;
    padding: 1.25rem;
    background: radial-gradient(circle at 100% 0%, rgba(0, 229, 255, 0.14), transparent 34%),
      radial-gradient(circle at 0% 5%, rgba(155, 0, 255, 0.12), transparent 34%),
      linear-gradient(180deg, rgba(7, 14, 30, 0.96), rgba(3, 10, 22, 0.98));
  }

  .product-accessory-bundle__header {
    display: grid;
    gap: 1rem;
    align-items: start;
  }

  .product-accessory-bundle__eyebrow {
    margin: 0 0 0.7rem;
    background: linear-gradient(90deg, #d96dff, #24e5ff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .product-accessory-bundle__title {
    max-width: 48rem;
    margin: 0;
    color: var(--theme-color-text);
    font-family: var(--theme-font-display);
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .product-accessory-bundle__text {
    max-width: 38rem;
    margin: 0.8rem 0 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 1rem;
    line-height: 1.55;
  }

  .product-accessory-bundle__pill {
    display: inline-flex;
    max-width: 100%;
    align-items: center;
    gap: 0.7rem;
    border: 1px solid rgba(217, 109, 255, 0.32);
    border-radius: 999px;
    padding: 0.7rem 1rem;
    color: rgba(255, 255, 255, 0.76);
    background: linear-gradient(90deg, rgba(12, 24, 44, 0.82), rgba(255, 45, 120, 0.16));
    font-size: 0.84rem;
  }

  .product-accessory-bundle__pill strong {
    background: linear-gradient(90deg, #2eefff, #d96dff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .product-accessory-bundle__pill-icon {
    color: #22e7ff;
  }

  .product-accessory-bundle__pill-icon svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .product-accessory-bundle__slider-wrap {
    position: relative;
    margin-top: 1.5rem;
    margin-inline: -1.25rem;
  }

  .product-accessory-bundle__grid {
    display: grid;
    grid-auto-columns: minmax(15.5rem, 82%);
    grid-auto-flow: column;
    gap: 1rem;
    overflow-x: auto;
    padding: 0 1.25rem 0.4rem;
    scroll-padding-inline: 1.25rem;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .product-accessory-bundle__grid::-webkit-scrollbar {
    display: none;
  }

  .product-accessory-bundle__card {
    position: relative;
    text-shadow: #000000d9 2px 2px 2px;
    display: grid;
    min-height: 31rem;
    overflow: hidden;
    border: 1px solid rgba(0, 229, 255, 0.18);
    border-radius: 1rem;
    background: rgba(4, 13, 25, 0.94);
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
    scroll-snap-align: start;
  }

  .product-accessory-bundle__card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(2, 8, 18, 0.12) 0%, rgba(2, 8, 18, 0.02) 42%, rgba(2, 8, 18, 0.88) 100%),
      radial-gradient(circle at 50% 50%, rgba(155, 0, 255, 0.16), transparent 42%);
  }

  .product-accessory-bundle__card.is-added {
    border-color: rgba(255, 76, 218, 0.9);
    box-shadow: 0 0 0 1px rgba(0, 229, 255, 0.4), 0 0 34px rgba(255, 45, 180, 0.26);
  }

  .product-accessory-bundle__select,
  .product-accessory-bundle__badge,
  .product-accessory-bundle__content {
    position: relative;
    z-index: 3;
  }

  .product-accessory-bundle__select {
    position: absolute;
    top: 1rem;
    left: 1rem;
    display: inline-flex;
    width: 2.1rem;
    height: 2.1rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 0.35rem;
    color: #02111d;
    background: rgba(2, 10, 20, 0.58);
    cursor: pointer;
    transition: border-color 180ms ease, background 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .product-accessory-bundle__card.is-added .product-accessory-bundle__select {
    border-color: rgba(0, 255, 213, 0.6);
    background: linear-gradient(135deg, #00ffb0, #25dfff);
    box-shadow: 0 0 18px rgba(0, 229, 255, 0.28);
  }

  .product-accessory-bundle__select svg {
    width: 1.25rem;
    height: 1.25rem;
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .product-accessory-bundle__card.is-added .product-accessory-bundle__select svg {
    opacity: 1;
  }

  .product-accessory-bundle__badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    border: 1px solid rgba(217, 109, 255, 0.34);
    border-radius: 0.35rem;
    padding: 0.42rem 0.6rem;
    color: #ff7adf;
    background: rgba(255, 45, 120, 0.13);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product-accessory-bundle__media {
    position: absolute;
    inset: 0;
  }

  .product-accessory-bundle__image,
  .product-accessory-bundle__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-accessory-bundle__placeholder {
    background: radial-gradient(circle at 50% 42%, rgba(0, 229, 255, 0.16), transparent 36%),
      linear-gradient(135deg, rgba(255, 45, 120, 0.11), rgba(3, 10, 22, 0.98));
  }

  .product-accessory-bundle__content {
    align-self: end;
    display: flex;
    min-height: 13.8rem;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem;
  }

  .product-accessory-bundle__copy,
  .product-accessory-bundle__purchase {
    display: grid;
  }

  .product-accessory-bundle__copy {
    align-content: start;
  }

  .product-accessory-bundle__purchase {
    align-content: end;
  }

  .product-accessory-bundle__card-title {
    margin: 0;
    color: var(--theme-color-text);
    font-size: 1.12rem;
    font-weight: 800;
    line-height: 1.16;
  }

  .product-accessory-bundle__card-title a {
    color: inherit;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .product-accessory-bundle__card-title a:hover,
  .product-accessory-bundle__card-title a:focus-visible {
    color: #24e5ff;
  }

  .product-accessory-bundle__card-text {
    margin: 0.45rem 0 0;
    color: rgba(255, 255, 255, 0.66);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .product-accessory-bundle__price-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: center;
    margin-top: 0;
  }

  .product-accessory-bundle__price {
    color: var(--theme-color-text);
    font-family: var(--theme-font-display);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1;
  }

  .product-accessory-bundle__compare {
    color: rgba(255, 255, 255, 0.36);
    font-size: 0.9rem;
  }

  .product-accessory-bundle__save {
    border-radius: 0.35rem;
    padding: 0.34rem 0.55rem;
    color: #ff8de3;
    background: rgba(255, 45, 120, 0.18);
    font-size: 0.72rem;
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }

  .product-accessory-bundle__button {
    position: relative;
    z-index: 5;
    display: inline-flex;
    width: 100%;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.1rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 0.9rem;
    color: var(--theme-color-text);
    background: rgba(4, 11, 24, 0.5);
    font-family: var(--theme-font-display);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    appearance: none;
    cursor: pointer;
    text-decoration: none;
    transition: border-color 180ms ease, background 180ms ease, box-shadow 180ms ease, color 180ms ease,
      transform 180ms ease, opacity 180ms ease;
  }

  .product-accessory-bundle__card.is-added .product-accessory-bundle__button {
    border-color: transparent;
    color: #02111d;
    background: linear-gradient(135deg, #00ffb0, #25dfff);
    box-shadow: 0 0 28px rgba(0, 229, 255, 0.18);
  }

  .product-accessory-bundle__button:hover,
  .product-accessory-bundle__button:focus-visible,
  .product-accessory-bundle__select:hover,
  .product-accessory-bundle__select:focus-visible {
    transform: translateY(-1px);
  }

  .product-accessory-bundle__button[disabled],
  .product-accessory-bundle__button--disabled,
  .product-accessory-bundle__select[disabled] {
    cursor: not-allowed;
    opacity: 0.58;
    transform: none;
  }

  .product-accessory-bundle__card.is-added .product-accessory-bundle__button[disabled] {
    opacity: 1;
  }

  .product-accessory-bundle__form {
    margin: 0;
  }

  .product-accessory-bundle__arrow {
    position: absolute;
    top: 50%;
    z-index: 20;
    display: inline-flex;
    width: 3rem;
    height: 3rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    color: var(--theme-color-text);
    background: rgba(4, 11, 24, 0.72);
    cursor: pointer;
    pointer-events: auto;
    transform: translateY(-50%);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .product-accessory-bundle__arrow[hidden] {
    display: none;
  }

  .product-accessory-bundle__arrow--prev {
    left: 0.4rem;
  }

  .product-accessory-bundle__arrow--next {
    right: 0.4rem;
  }

  @media (min-width: 760px) {
    .product-accessory-bundle__slider-wrap {
      margin-inline: -1.25rem;
    }

    .product-accessory-bundle__grid {
      grid-auto-columns: minmax(17rem, 42%);
      overflow-x: auto;
      padding-inline: 1.25rem;
      scroll-padding-inline: 1.25rem;
    }
  }

  @media (min-width: 1100px) {
    .product-accessory-bundle__panel {
      padding: 2rem;
    }

    .product-accessory-bundle__header {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }

    .product-accessory-bundle__pill {
      justify-self: end;
    }

    .product-accessory-bundle__grid {
      grid-auto-columns: minmax(17rem, 24%);
      padding-inline: 2rem;
      scroll-padding-inline: 2rem;
    }

    .product-accessory-bundle__slider-wrap {
      margin-inline: -2rem;
    }

    .product-accessory-bundle__content {
      min-height: 14.8rem;
    }
  }
{% endstylesheet %}

