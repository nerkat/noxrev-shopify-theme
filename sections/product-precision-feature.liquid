{% liquid
  assign feature_image = section.settings.image | default: product.featured_media.preview_image
%}

<section class="product-precision-feature section">
  <div class="container">
    <article class="product-precision-feature__panel">
      <div class="product-precision-feature__copy">
        <p class="product-precision-feature__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="product-precision-feature__title">{{ section.settings.title }}</h2>
        <p class="product-precision-feature__text">{{ section.settings.text }}</p>

        <div class="product-precision-feature__icons" role="list">
          {% for block in section.blocks %}
            <div class="product-precision-feature__icon-item" role="listitem" {{ block.shopify_attributes }}>
              <span class="product-precision-feature__icon" aria-hidden="true">
                {% if block.settings.icon_image != blank %}
                  {{
                    block.settings.icon_image
                    | image_url: width: 64
                    | image_tag: loading: 'lazy', alt: '', class: 'product-precision-feature__icon-image'
                  }}
                {% else %}
                  {% render 'product-marketing-icon', icon: block.settings.icon %}
                {% endif %}
              </span>
              <span>{{ block.settings.label }}</span>
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="product-precision-feature__media">
        {% if feature_image != blank %}
          {% assign feature_image_alt = section.settings.image_alt | default: section.settings.title %}
          {% render 'responsive-image',
            image: feature_image,
            alt: feature_image_alt,
            class: 'product-precision-feature__image',
            loading: 'lazy',
            sizes: '(min-width: 900px) 45vw, 100vw',
            widths: '420, 640, 860, 1100'
          %}
        {% else %}
          <div class="product-precision-feature__placeholder" aria-hidden="true"></div>
        {% endif %}
      </div>
    </article>
  </div>
</section>



{% schema %}
{
  "name": "PDP Precision Feature",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Stunning Precision And Control" },
    { "type": "text", "id": "title", "label": "Title", "default": "Trackpad Gestures That Feel Natural." },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "The precision trackpad supports all the multi-touch gestures you already know."
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Close-up of precision trackpad and keyboard"
    }
  ],
  "blocks": [
    {
      "type": "feature_icon",
      "name": "Gesture icon",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Tap" },
        {
          "type": "select",
          "id": "icon",
          "label": "Fallback icon",
          "default": "tap",
          "options": [
            { "value": "tap", "label": "Tap" },
            { "value": "swipe", "label": "Swipe" },
            { "value": "zoom", "label": "Zoom" },
            { "value": "apps", "label": "Apps" }
          ]
        },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP Precision Feature",
      "blocks": [
        { "type": "feature_icon", "settings": { "label": "Tap", "icon": "tap" } },
        { "type": "feature_icon", "settings": { "label": "Swipe", "icon": "swipe" } },
        { "type": "feature_icon", "settings": { "label": "Scroll", "icon": "swipe" } },
        { "type": "feature_icon", "settings": { "label": "Zoom", "icon": "zoom" } },
        { "type": "feature_icon", "settings": { "label": "Switch Apps", "icon": "apps" } }
      ]
    }
  ]
}
{% endschema %}
