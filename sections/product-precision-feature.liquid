{% style %}{% unless section.settings.layout_media_fit == 'inherit' %}#shopify-section-{{ section.id }} .product-precision-feature__media img{object-fit:{{ section.settings.layout_media_fit }}}{% endunless %}{% unless section.settings.layout_media_ratio == 'inherit' %}#shopify-section-{{ section.id }} .product-precision-feature__media img{aspect-ratio:{{ section.settings.layout_media_ratio }};height:auto}{% endunless %}@media(min-width:750px){ {% unless section.settings.layout_media_order == 'inherit' %}#shopify-section-{{ section.id }} .product-precision-feature__media{order:{% if section.settings.layout_media_order == 'first' %}-1{% else %}10{% endif %}}{% endunless %}}@media(max-width:749px){ {% unless section.settings.layout_media_order_mobile == 'inherit' %}#shopify-section-{{ section.id }} .product-precision-feature__media{order:{% if section.settings.layout_media_order_mobile == 'first' %}-1{% else %}10{% endif %}}{% endunless %}}{% endstyle %}
{% render 'section-layout', section: section %}
{% liquid
  assign feature_image = section.settings.image | default: product.featured_media.preview_image
%}

<section data-paired-feature="{{ section.settings.paired_feature }}" class="product-precision-feature section">
  <div class="container">
    <article class="product-precision-feature__panel">
      <div class="product-precision-feature__copy">
        <p class="product-precision-feature__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="product-precision-feature__title">{{ section.settings.title }}</h2>
        <p class="product-precision-feature__text">{{ section.settings.text }}</p>

        <div class="product-precision-feature__icons" role="list">
          {% for block in section.blocks %}
            <div class="product-precision-feature__icon-item" role="listitem" {{ block.shopify_attributes }}>
              <span class="product-precision-feature__icon" aria-hidden="true">
                {% if block.settings.icon_image != blank %}
                  {{
                    block.settings.icon_image
                    | image_url: width: 64
                    | image_tag: loading: 'lazy', alt: '', class: 'product-precision-feature__icon-image'
                  }}
                {% else %}
                  {% render 'product-marketing-icon', icon: block.settings.icon %}
                {% endif %}
              </span>
              <span>{{ block.settings.label }}</span>
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="product-precision-feature__media">
        {% if feature_image != blank %}
          {% assign feature_image_alt = section.settings.image_alt | default: section.settings.title %}
          {% render 'responsive-image',
            image: feature_image,
            alt: feature_image_alt,
            class: 'product-precision-feature__image',
            loading: 'lazy',
            sizes: '(min-width: 900px) 45vw, 100vw',
            widths: '420, 640, 860, 1100'
          %}
        {% else %}
          <div class="product-precision-feature__placeholder" aria-hidden="true"></div>
        {% endif %}
      </div>
    </article>
  </div>
</section>



{% schema %}
{
