{% liquid
  assign feature_image = section.settings.image | default: product.featured_media.preview_image
%}

<section class="product-precision-feature section">
  <div class="container">
    <article class="product-precision-feature__panel">
      <div class="product-precision-feature__copy">
        <p class="product-precision-feature__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="product-precision-feature__title">{{ section.settings.title }}</h2>
        <p class="product-precision-feature__text">{{ section.settings.text }}</p>

        <div class="product-precision-feature__icons" role="list">
          {% for block in section.blocks %}
            <div class="product-precision-feature__icon-item" role="listitem" {{ block.shopify_attributes }}>
              <span class="product-precision-feature__icon" aria-hidden="true">
                {% if block.settings.icon_image != blank %}
                  {{ block.settings.icon_image | image_url: width: 64 | image_tag: loading: 'lazy', alt: '', class: 'product-precision-feature__icon-image' }}
                {% else %}
                  {% render 'product-marketing-icon', icon: block.settings.icon %}
                {% endif %}
              </span>
              <span>{{ block.settings.label }}</span>
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="product-precision-feature__media">
        {% if feature_image != blank %}
          {% render 'responsive-image',
            image: feature_image,
            alt: section.settings.image_alt,
            class: 'product-precision-feature__image',
            loading: 'lazy',
            sizes: '(min-width: 900px) 45vw, 100vw',
            widths: '420, 640, 860, 1100'
          %}
        {% else %}
          <div class="product-precision-feature__placeholder" aria-hidden="true"></div>
        {% endif %}
      </div>
    </article>
  </div>
</section>

{% stylesheet %}
  .product-precision-feature {
    padding: 0 0 1rem;
  }

  .product-precision-feature__panel {
    display: grid;
    gap: 1rem;
    overflow: hidden;
    border: 1px solid rgba(56, 221, 255, 0.22);
    border-radius: 1rem;
    background:
      radial-gradient(circle at 80% 10%, rgba(0, 229, 255, 0.13), transparent 38%),
      linear-gradient(180deg, rgba(7, 14, 30, 0.94), rgba(3, 10, 22, 0.98));
  }

  .product-precision-feature__copy {
    padding: 1.2rem 1.2rem 0;
  }

  .product-precision-feature__eyebrow,
  .product-precision-feature__title {
    margin: 0;
    background: linear-gradient(90deg, #24e5ff, #d96dff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .product-precision-feature__eyebrow {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .product-precision-feature__title {
    margin-top: 0.65rem;
    font-family: var(--theme-font-display);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.08;
  }

  .product-precision-feature__text {
    max-width: 28rem;
    margin: 0.8rem 0 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.93rem;
    line-height: 1.55;
  }

  .product-precision-feature__icons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.2rem;
  }

  .product-precision-feature__icon-item {
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    max-width: 5rem;
    color: rgba(255, 255, 255, 0.84);
    font-size: 0.72rem;
    line-height: 1.2;
    text-align: center;
  }

  .product-precision-feature__icon {
    display: inline-flex;
    width: 2.45rem;
    height: 2.45rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(0, 229, 255, 0.28);
    border-radius: 0.75rem;
    color: #27efff;
    background: rgba(2, 11, 23, 0.72);
  }

  .product-precision-feature__icon svg,
  .product-precision-feature__icon-image {
    width: 1.2rem;
    height: 1.2rem;
    object-fit: contain;
  }

  .product-precision-feature__media {
    min-height: 13rem;
    overflow: hidden;
  }

  .product-precision-feature__image,
  .product-precision-feature__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 13rem;
    object-fit: cover;
  }

  .product-precision-feature__placeholder {
    background: linear-gradient(135deg, rgba(0, 229, 255, 0.16), rgba(214, 101, 255, 0.1));
  }

  @media (min-width: 900px) {
    .product-precision-feature__panel {
      grid-template-columns: minmax(18rem, 0.9fr) minmax(0, 1fr);
      align-items: center;
    }

    .product-precision-feature__copy {
      padding: 2rem;
    }

    .product-precision-feature__media,
    .product-precision-feature__image,
    .product-precision-feature__placeholder {
      min-height: 20rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP Precision Feature",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Stunning Precision And Control" },
    { "type": "text", "id": "title", "label": "Title", "default": "Trackpad Gestures That Feel Natural." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The precision trackpad supports all the multi-touch gestures you already know." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Close-up of precision trackpad and keyboard" }
  ],
  "blocks": [
    {
      "type": "feature_icon",
      "name": "Gesture icon",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Tap" },
        { "type": "select", "id": "icon", "label": "Fallback icon", "default": "tap", "options": [
          { "value": "tap", "label": "Tap" },
          { "value": "swipe", "label": "Swipe" },
          { "value": "zoom", "label": "Zoom" },
          { "value": "apps", "label": "Apps" }
        ] },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP Precision Feature",
      "blocks": [
        { "type": "feature_icon", "settings": { "label": "Tap", "icon": "tap" } },
        { "type": "feature_icon", "settings": { "label": "Swipe", "icon": "swipe" } },
        { "type": "feature_icon", "settings": { "label": "Scroll", "icon": "swipe" } },
        { "type": "feature_icon", "settings": { "label": "Zoom", "icon": "zoom" } },
        { "type": "feature_icon", "settings": { "label": "Switch Apps", "icon": "apps" } }
      ]
    }
  ]
}
{% endschema %}
