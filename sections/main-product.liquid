              "label": "Shipping"
            },
            {
              "value": "guarantee",
              "label": "Guarantee"
            },
            {
              "value": "returns",
              "label": "Returns"
            }
          ],
          "default": "shipping"
        },
        {
          "type": "select",
          "id": "benefit_2",
          "label": "Benefit 2",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "shipping",
              "label": "Shipping"
            },
            {
              "value": "guarantee",
              "label": "Guarantee"
            },
            {
              "value": "returns",
              "label": "Returns"
            }
          ],
          "default": "guarantee"
        },
        {
          "type": "select",
          "id": "benefit_3",
          "label": "Benefit 3",
          "options": [
