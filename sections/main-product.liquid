    },
    {
      "type": "paragraph",
      "content": "Upload, sort, label and assign media to variants in Shopify Products. These settings change presentation only."
    },
    {
      "type": "range",
      "id": "gallery_width",
      "label": "Media column width",
      "min": 35,
      "max": 65,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "select",
      "id": "gallery_ratio",
      "label": "Media aspect ratio",
      "options": [
        {
          "value": "auto",
          "label": "Original"
        },
        {
          "value": "1",
          "label": "Square"
        },
        {
          "value": "0.8",
          "label": "Portrait"
        },
        {
          "value": "1.333",
          "label": "Landscape"
        }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "gallery_desktop_navigation",
      "label": "Desktop navigation",
      "options": [
        {
          "value": "dots",
          "label": "Dots"
        },
        {
          "value": "thumbnails",
          "label": "Thumbnails"
        },
        {
          "value": "arrows",
          "label": "Arrows only"
        }
      ],
      "default": "dots"
    },
    {
      "type": "select",
      "id": "gallery_mobile_navigation",
      "label": "Mobile navigation",
      "options": [
        {
          "value": "dots",
          "label": "Dots"
        },
        {
          "value": "arrows",
          "label": "Arrows only"
        }
      ],
