{{ 'main-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'main-product.js' | asset_url }}" defer></script>
{% liquid
assign current_variant = product.selected_variant | default: product.selected_or_first_available_variant
assign current_media = product.featured_media | default: product.media.first
if section.settings.variant_media
assign current_media = current_variant.featured_media | default: current_media
endif
assign current_media_index = 0
for media in product.media
if media.id == current_media.id
assign current_media_index = forloop.index0
break
endif
endfor
assign has_picker = false
assign has_buttons = false
%}
<div class="page-width main-product" data-main-product-section data-section-id="{{ section.id }}" data-product-handle="{{ product.handle }}" data-variant-media="{{ section.settings.variant_media }}" style="--main-product-gallery-image-fit: {{ section.settings.gallery_image_fit }}; --gallery-ratio: {{ section.settings.gallery_ratio }}; --gallery-column-width: {{ section.settings.gallery_width }}%;">
<div class="main-product__main">
    <div class="main-product__media-column" data-desktop-nav="{{ section.settings.gallery_desktop_navigation }}" data-mobile-nav="{{ section.settings.gallery_mobile_navigation }}" data-product-gallery-region>
      <div
        class="main-product__gallery"
        data-product-gallery data-zoom="{{ section.settings.gallery_zoom }}"
        {% if current_media %}
          data-active-media-id="{{ current_media.id }}"
        {% endif %}
        style="--gallery-index: {{ current_media_index }};"
      >
        <div class="main-product__gallery-frame" data-gallery-frame>
          <div class="main-product__gallery-track" data-gallery-track>
            {% if product.media.size > 0 %}
              {% for media in product.media %}
                {% liquid
                  assign slide_image = media.preview_image | default: media
                  assign slide_alt = media.alt | default: product.title
                  assign is_active_media = false
                  if current_media and media.id == current_media.id
                    assign is_active_media = true
                  endif
                %}
                <div
                  class="main-product__gallery-slide{% if is_active_media %} is-active{% endif %}"
                  data-gallery-slide
                  data-media-id="{{ media.id }}"
                  aria-hidden="{% if is_active_media %}false{% else %}true{% endif %}"
                >
                  {% render 'main-product-media', media: media, slide_image: slide_image, slide_alt: slide_alt, is_active_media: is_active_media %}
                </div>
              {% endfor %}
            {% else %}
              <div class="main-product__gallery-slide is-active" data-gallery-slide aria-hidden="false">
                {{ 'image' | placeholder_svg_tag: 'main-product__gallery-placeholder' }}
              </div>
            {% endif %}
          </div>

          {% if product.media.size > 1 %}
            <button
              class="main-product__gallery-nav main-product__gallery-nav--prev"
              type="button"
              data-gallery-prev
              aria-label="Show previous product media"
            >
              <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true">
                <path d="m15 6-6 6 6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
            <button
              class="main-product__gallery-nav main-product__gallery-nav--next"
              type="button"
              data-gallery-next
              aria-label="Show next product media"
            >
              <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true">
                <path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>

            <div class="main-product__gallery-dots" data-gallery-dots aria-label="Product media navigation">
              {% for media in product.media %}
                {% assign is_active_media = false %}
                {% if current_media and media.id == current_media.id %}
                  {% assign is_active_media = true %}
                {% endif %}
                <button
                  class="main-product__gallery-dot{% if is_active_media %} is-active{% endif %}"
                  type="button"
                  data-gallery-dot
                  data-gallery-index="{{ forloop.index0 }}"
                  aria-label="Go to media {{ forloop.index }}"
                  aria-current="{% if is_active_media %}true{% else %}false{% endif %}"
                >{% if section.settings.gallery_desktop_navigation == 'thumbnails' %}{{ media.preview_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: slide_alt }}{% endif %}</button>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>


<div class="main-product__content" data-product-form-region>
{% for block in section.blocks %}
<div class="main-product__block main-product__block--{{ block.type }}" {{ block.shopify_attributes }}>
{% case block.type %}
{% when '@app' %}{% render block %}
{% when 'title' %}<h1 class="main-product__title heading-gradient">{{ product.title | escape }}</h1>
{% when 'variant_picker' %}{% assign has_picker = true %}{% render 'product-option-picker', product: product, current_variant: current_variant, section: section %}
{% when 'price' %}
            <div data-product-price-region>
              {% if current_variant %}
                {% liquid
                  assign compare_at_price = current_variant.compare_at_price
                  assign has_compare_price = false
                  assign discount_amount = 0
                  assign discount_percentage = 0

                  if compare_at_price > current_variant.price
                    assign has_compare_price = true
                    assign discount_amount = compare_at_price | minus: current_variant.price
                    assign discount_percentage = discount_amount | times: 100.0 | divided_by: compare_at_price | round
                  endif
                %}
                <div class="main-product__price-row">
                  <p class="main-product__price heading-gradient">
                    {% render 'price', amount: current_variant.price %}
                  </p>

                  {% if has_compare_price %}
                    <p class="main-product__price-compare">{% render 'price', amount: compare_at_price %}</p>
                    <p class="main-product__price-discount-badge">{{ 'editor.save_percent' | t: percent: discount_percentage }}</p>
                  {% endif %}
                </div>
              {% endif %}
            </div>

{% when 'quantity' %}
            <div class="main-product__quantity-control" data-quantity-control>
              <label class="visually-hidden" for="Quantity-{{ section.id }}">Quantity</label>
              <button
                class="main-product__quantity-button"
                type="button"
                data-quantity-decrease
                aria-label="Decrease quantity"
              >
                <span aria-hidden="true">-</span>
              </button>
              <input
                id="Quantity-{{ section.id }}"
                class="main-product__quantity-input"
                type="number"
                name="quantity" form="ProductForm-{{ section.id }}"
                min="1"
                value="1"
                inputmode="numeric"
              >
              <button
                class="main-product__quantity-button"
                type="button"
                data-quantity-increase
                aria-label="Increase quantity"
              >
                <span aria-hidden="true">+</span>
              </button>
            </div>

{% when 'purchase_buttons' %}{% assign has_buttons = true %}{% render 'product-purchase-buttons', product: product, current_variant: current_variant, section: section, block: block %}
{% when 'trust' %}
{% if section.settings.show_trust_cues %}<div class="main-product__trust-cues">{% for i in (1..3) %}{% assign key = 'benefit_' | append: i %}{% render 'store-benefit', record: block.settings[key], section: section %}{% endfor %}</div>{% endif %}
{% when 'short_description' %}{% assign excerpt = block.settings.content | default: product.description %}{% if excerpt != blank %}<div class="main-product__excerpt">{{ excerpt | strip_html | truncatewords: block.settings.word_limit }}</div>{% endif %}
{% when 'full_description' %}<div class="rte">{{ block.settings.content | default: product.description }}</div>
{% when 'detail' %}
{% liquid
assign detail = blank
case block.settings.source
when 'description'
assign detail = product.description
when 'custom'
assign detail = block.settings.content
else
assign field = product.metafields.custom[block.settings.source]
if field != blank
assign detail = field | metafield_tag
endif
endcase
%}
{% if detail != blank or block.settings.link != blank %}<details {% if block.settings.open %}open{% endif %}><summary>{{ block.settings.heading | escape }}</summary><div class="rte">{{ detail }}{% if block.settings.link != blank %}<p><a href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a></p>{% endif %}</div></details>{% endif %}
{% endcase %}
</div>
{% endfor %}
{% unless has_picker %}{% render 'product-option-picker', product: product, current_variant: current_variant, section: section %}{% endunless %}
{% unless has_buttons %}{% render 'product-purchase-buttons', product: product, current_variant: current_variant, section: section %}{% endunless %}
</div></div>
{% if section.settings.show_product_description and product.description != blank %}<div class="main-product__details rte">{{ product.description }}</div>{% endif %}
</div>
{% schema %}
{
  "name": "t:general.product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_product_description",
      "label": "Show product description",
      "default": false
    },
    {
      "type": "select",
      "id": "gallery_image_fit",
      "label": "Product gallery image fit",
      "options": [
        {
          "value": "cover",
          "label": "Fill frame (crop)"
        },
        {
          "value": "contain",
          "label": "Fit entire image"
        }
      ],
      "default": "cover"
    },
    {
      "type": "checkbox",
      "id": "show_trust_cues",
      "label": "Show shipping and service messages",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "inherit_global_trust_cues",
      "label": "Inherit unchanged service messages from global settings",
      "default": true,
      "info": "Original default messages inherit the global values. Edited messages remain local overrides, and selected local icons take precedence over global icons. Turn off to keep the original default messages local."
    },
    {
      "type": "text",
      "id": "shipping_trust_text",
      "label": "Shipping message"
    },
    {
      "type": "image_picker",
      "id": "shipping_trust_icon",
      "label": "Shipping message icon"
    },
    {
      "type": "text",
      "id": "guarantee_trust_text",
      "label": "Guarantee message"
    },
    {
      "type": "image_picker",
      "id": "guarantee_trust_icon",
      "label": "Guarantee message icon"
    },
    {
      "type": "text",
      "id": "returns_trust_text",
      "label": "Returns message"
    },
    {
      "type": "image_picker",
      "id": "returns_trust_icon",
      "label": "Returns message icon"
    },
    {
      "type": "header",
      "content": "Model selector"
    },
    {
      "type": "select",
      "id": "selector_style",
      "label": "Model selector style",
      "options": [
        {
          "value": "tabs",
          "label": "Family tabs"
        },
        {
          "value": "columns",
          "label": "All families in columns"
        }
