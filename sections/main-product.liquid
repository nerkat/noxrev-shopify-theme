{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign current_media = current_variant.featured_media | default: product.featured_media | default: product.media.first
  assign current_preview = current_media.preview_image | default: current_media
  assign current_alt = current_media.alt | default: product.title
  assign excerpt = product.description | strip_html | truncatewords: 28
%}

<div
  class="page-width main-product"
  data-main-product-section
  data-section-id="{{ section.id }}"
  data-product-handle="{{ product.handle }}"
>
  <div class="main-product__main">
    <h1 class="main-product__title heading-gradient">{{ product.title }}</h1>

    <div class="main-product__media-column" data-product-gallery-region>
      <div
        class="main-product__gallery"
        data-product-gallery
        {% if current_media %}
          data-active-media-id="{{ current_media.id }}"
        {% endif %}
      >
        <div class="main-product__gallery-main">
          <div class="main-product__gallery-frame">
            {% comment %}
              <span class="main-product__gallery-zoom" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true">
                  <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="2"></circle>
                  <path d="M16 16 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                  <path d="M11 8.5v5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                  <path d="M8.5 11h5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                </svg>
              </span>
            {% endcomment %}

            {% if current_preview != blank %}
              <img
                class="main-product__gallery-image"
                data-gallery-main-image
                src="{{ current_preview | image_url: width: 1400 }}"
                srcset="
                  {{ current_preview | image_url: width: 400 }} 400w,
                  {{ current_preview | image_url: width: 640 }} 640w,
                  {{ current_preview | image_url: width: 900 }} 900w,
                  {{ current_preview | image_url: width: 1200 }} 1200w,
                  {{ current_preview | image_url: width: 1400 }} 1400w
                "
                sizes="(min-width: 861px) 55vw, 100vw"
                alt="{{ current_alt | escape }}"
                width="{{ current_preview.width }}"
                height="{{ current_preview.height }}"
                loading="eager"
              >
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'main-product__gallery-placeholder' }}
            {% endif %}
          </div>
        </div>

        {% if product.media.size > 1 %}
          <div class="main-product__gallery-thumbnails">
            <span
              class="main-product__gallery-rail-indicator main-product__gallery-rail-indicator--top"
              aria-hidden="true"
            >
              <span class="main-product__gallery-rail-indicator-fade"></span>
              <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true">
                <path d="M7 14 12 9l5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
            <span
              class="main-product__gallery-rail-indicator main-product__gallery-rail-indicator--bottom"
              aria-hidden="true"
            >
              <span class="main-product__gallery-rail-indicator-fade"></span>
              <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true">
                <path d="m7 10 5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
            <div class="main-product__gallery-thumbnails-scroll" role="list" aria-label="Product media thumbnails">
              {% for media in product.media %}
                {% assign thumbnail_image = media.preview_image | default: media %}
                {% assign thumbnail_alt = media.alt | default: product.title %}
                <button
                  class="main-product__gallery-thumb{% if current_media and media.id == current_media.id %} is-active{% endif %}"
                  type="button"
                  data-gallery-thumb
                  data-media-id="{{ media.id }}"
                  data-image-src="{{ thumbnail_image | image_url: width: 1400 }}"
                  data-image-srcset="{{ thumbnail_image | image_url: width: 400 }} 400w, {{ thumbnail_image | image_url: width: 640 }} 640w, {{ thumbnail_image | image_url: width: 900 }} 900w, {{ thumbnail_image | image_url: width: 1200 }} 1200w, {{ thumbnail_image | image_url: width: 1400 }} 1400w"
                  data-image-width="{{ thumbnail_image.width }}"
                  data-image-height="{{ thumbnail_image.height }}"
                  data-image-alt="{{ thumbnail_alt | escape }}"
                  aria-label="Show media {{ forloop.index }}"
                  aria-pressed="{% if current_media and media.id == current_media.id %}true{% else %}false{% endif %}"
                >
                  <span class="main-product__gallery-thumb-media">
                    {% render 'responsive-image',
                      image: thumbnail_image,
                      alt: thumbnail_alt,
                      class: 'main-product__gallery-thumb-image',
                      loading: 'lazy',
                      sizes: '88px',
                      widths: '88, 120, 176'
                    %}
                  </span>
                </button>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="main-product__content">
      <div data-product-price-region>
        {% if current_variant %}
          {% liquid
            assign compare_at_price = current_variant.compare_at_price
            assign has_compare_price = false
            assign discount_amount = 0
            assign discount_percentage = 0

            if compare_at_price > current_variant.price
              assign has_compare_price = true
              assign discount_amount = compare_at_price | minus: current_variant.price
              assign discount_percentage = discount_amount | times: 100.0 | divided_by: compare_at_price | round
            endif
          %}
          <div class="main-product__price-row">
            <p class="main-product__price">{% render 'price', amount: current_variant.price %}</p>

            {% if has_compare_price %}
              <p class="main-product__price-compare">{% render 'price', amount: compare_at_price %}</p>
              <p class="main-product__price-discount-badge">SAVE {{ discount_percentage }}%</p>
            {% endif %}
          </div>
        {% endif %}
      </div>

      {% comment %}
        {% if excerpt != blank %}
          <p class="main-product__excerpt">{{ excerpt }}</p>
        {% endif %}
      {% endcomment %}

      {% unless product.has_only_default_variant %}
        <div class="main-product__options" data-product-options-region>
          {% for option in product.options_with_values %}
            {% liquid
              assign option_name_downcase = option.name | downcase
              assign is_color_option = false
              assign is_model_option = false
              if option_name_downcase == 'color' or option_name_downcase == 'colour'
                assign is_color_option = true
              endif
              if option_name_downcase contains 'model'
                assign is_model_option = true
              endif
            %}
            <fieldset class="main-product__option">
              <legend class="main-product__option-label{% if is_color_option or is_model_option %} main-product__step-label{% endif %}">
                {{ forloop.index }}. Choose {{ option.name }}
              </legend>

              {% if is_model_option %}
                {% liquid
                  assign selected_model_family = 'ipad'
                  assign pro_items = ''
                  assign air_items = ''
                  assign ipad_items = ''
                  assign pro_selected_label = ''
                  assign air_selected_label = ''
                  assign ipad_selected_label = ''
                  assign pro_count = 0
                  assign air_count = 0
                  assign ipad_count = 0
                %}

                {% for value in option.values %}
                  {% liquid
                    assign option_variant = null

                    for variant in product.variants
                      assign matches_option = false

                      case option.position
                        when 1
                          if variant.option1 == value.name
                            assign matches_option = true
                          endif
                        when 2
                          if variant.option2 == value.name
                            assign matches_option = true
                          endif
                        when 3
                          if variant.option3 == value.name
                            assign matches_option = true
                          endif
                      endcase

                      if matches_option
                        assign matches_other_options = true

                        for product_option in product.options_with_values
                          if product_option.position != option.position
                            assign selected_value = product_option.selected_value

                            case product_option.position
                              when 1
                                if variant.option1 != selected_value
                                  assign matches_other_options = false
                                  break
                                endif
                              when 2
                                if variant.option2 != selected_value
                                  assign matches_other_options = false
                                  break
                                endif
                              when 3
                                if variant.option3 != selected_value
                                  assign matches_other_options = false
                                  break
                                endif
                            endcase
                          endif
                        endfor

                        if matches_other_options
                          assign option_variant = variant
                          break
                        elsif option_variant == null
                          assign option_variant = variant
                        endif
                      endif
                    endfor
                  %}
                  {% if option_variant %}
                    {% liquid
                      assign value_name_downcase = value.name | downcase
                      assign family_key = 'ipad'

                      if value_name_downcase contains 'ipad pro'
                        assign family_key = 'pro'
                      elsif value_name_downcase contains 'ipad air'
                        assign family_key = 'air'
                      endif
                    %}

                    {% capture model_item %}
                      <li class="main-product__model-item">
                        {% liquid
                          assign option_url = value.url
                          if option_url == blank and option_variant
                            assign option_url = product.url | append: '?variant=' | append: option_variant.id
                          endif
                        %}
                        <a
                          class="main-product__model-link{% unless option_variant.available %} is-unavailable{% endunless %}"
                          href="{{ option_url }}"
                          data-variant-link
                          data-variant-id="{{ option_variant.id }}"
                          aria-label="Choose {{ option.name | escape }}: {{ value.name | escape }}{% unless option_variant.available %} unavailable{% endunless %}"
                          {% if value.selected %}
                            aria-current="true"
                          {% endif %}
                        >
                          <span class="main-product__model-radio" aria-hidden="true">
                            <span class="main-product__model-radio-dot"></span>
                          </span>
                          <span class="main-product__model-name">{{ value.name }}</span>
                        </a>
                      </li>
                    {% endcapture %}

                    {% if family_key == 'pro' %}
                      {% assign pro_items = pro_items | append: model_item %}
                      {% assign pro_count = pro_count | plus: 1 %}
                      {% if value.selected %}
                        {% assign selected_model_family = 'pro' %}
                        {% assign pro_selected_label = value.name %}
                      {% endif %}
                    {% elsif family_key == 'air' %}
                      {% assign air_items = air_items | append: model_item %}
                      {% assign air_count = air_count | plus: 1 %}
                      {% if value.selected %}
                        {% assign selected_model_family = 'air' %}
                        {% assign air_selected_label = value.name %}
                      {% endif %}
                    {% else %}
                      {% assign ipad_items = ipad_items | append: model_item %}
                      {% assign ipad_count = ipad_count | plus: 1 %}
                      {% if value.selected %}
                        {% assign selected_model_family = 'ipad' %}
                        {% assign ipad_selected_label = value.name %}
                      {% endif %}
                    {% endif %}
                  {% endif %}
                {% endfor %}

                <div
                  class="main-product__model-selector"
                  data-model-tabs
                  data-selected-family="{{ selected_model_family }}"
                >
                  <div class="main-product__model-tablist" role="tablist" aria-label="Choose iPad model family">
                    {% if pro_count > 0 %}
                      <button
                        class="main-product__model-tab"
                        type="button"
                        role="tab"
                        id="ModelTab-Pro-{{ section.id }}"
                        aria-selected="false"
                        aria-controls="ModelPanel-Pro-{{ section.id }}"
                        data-model-tab="pro"
                      >
                        <span class="main-product__model-tab-title">iPad Pro</span>
                        <span
                          class="main-product__model-tab-media main-product__model-tab-media--pro"
                          aria-hidden="true"
                        >
                          <img
                            class="main-product__model-tab-image"
                            src="{{ 'ipad-pro-space-black.png' | asset_url }}"
                            alt=""
                            loading="lazy"
                            width="320"
                            height="320"
                          >
                        </span>
                      </button>
                    {% endif %}

                    {% if air_count > 0 %}
                      <button
                        class="main-product__model-tab"
                        type="button"
                        role="tab"
                        id="ModelTab-Air-{{ section.id }}"
                        aria-selected="false"
                        aria-controls="ModelPanel-Air-{{ section.id }}"
                        data-model-tab="air"
                      >
                        <span class="main-product__model-tab-title">iPad Air</span>
                        <span
                          class="main-product__model-tab-media main-product__model-tab-media--air"
                          aria-hidden="true"
                        >
                          <img
                            class="main-product__model-tab-image"
                            src="{{ 'ipad-air-style-fill.png' | asset_url }}"
                            alt=""
                            loading="lazy"
                            width="320"
                            height="320"
                          >
                        </span>
                      </button>
                    {% endif %}

                    {% if ipad_count > 0 %}
                      <button
                        class="main-product__model-tab"
                        type="button"
                        role="tab"
                        id="ModelTab-Ipad-{{ section.id }}"
                        aria-selected="false"
                        aria-controls="ModelPanel-Ipad-{{ section.id }}"
                        data-model-tab="ipad"
                      >
                        <span class="main-product__model-tab-title">iPad</span>
                        <span
                          class="main-product__model-tab-media main-product__model-tab-media--ipad"
                          aria-hidden="true"
                        >
                          <img
                            class="main-product__model-tab-image"
                            src="{{ 'ipad-purple.png' | asset_url }}"
                            alt=""
                            loading="lazy"
                            width="320"
                            height="320"
                          >
                        </span>
                      </button>
                    {% endif %}
                  </div>

                  {% if pro_count > 0 %}
                    <div
                      class="main-product__model-panel panel"
                      id="ModelPanel-Pro-{{ section.id }}"
                      role="tabpanel"
                      aria-labelledby="ModelTab-Pro-{{ section.id }}"
                      data-model-panel="pro"
                      hidden
                    >
                      <div class="main-product__model-panel-inner">
                        <ul class="main-product__model-list" role="list">
                          {{ pro_items }}
                        </ul>
                      </div>
                    </div>
                  {% endif %}

                  {% if air_count > 0 %}
                    <div
                      class="main-product__model-panel panel"
                      id="ModelPanel-Air-{{ section.id }}"
                      role="tabpanel"
                      aria-labelledby="ModelTab-Air-{{ section.id }}"
                      data-model-panel="air"
                      hidden
                    >
                      <div class="main-product__model-panel-inner">
                        <ul class="main-product__model-list" role="list">
                          {{ air_items }}
                        </ul>
                      </div>
                    </div>
                  {% endif %}

                  {% if ipad_count > 0 %}
                    <div
                      class="main-product__model-panel panel"
                      id="ModelPanel-Ipad-{{ section.id }}"
                      role="tabpanel"
                      aria-labelledby="ModelTab-Ipad-{{ section.id }}"
                      data-model-panel="ipad"
                      hidden
                    >
                      <div class="main-product__model-panel-inner">
                        <ul class="main-product__model-list" role="list">
                          {{ ipad_items }}
                        </ul>
                      </div>
                    </div>
                  {% endif %}
                </div>
              {% else %}
                <div class="main-product__option-values{% if is_color_option %} main-product__option-values--swatches{% endif %}">
                  {% for value in option.values %}
                    {% assign option_variant = value.variant %}

                    {% if option_variant %}
                      {% liquid
                        assign swatch_image = value.swatch.image
                        assign swatch_color = value.swatch.color
                      %}

                      {% if is_color_option %}
                        {% liquid
                          assign option_url = value.url
                          if option_url == blank and option_variant
                            assign option_url = product.url | append: '?variant=' | append: option_variant.id
                          endif
                        %}
                        {% capture swatch_style %}
                          {% if swatch_color != blank %}--swatch-color: {{ swatch_color }};{% endif %}
                          {% if swatch_image != blank %}--swatch-image: url('{{ swatch_image | image_url: width: 128 }}');{% endif %}
                          {% if swatch_color != blank %}--swatch-ring-color: {{ swatch_color }};{% endif %}
                        {% endcapture %}
                        {% assign has_native_swatch = false %}
                        {% if swatch_color != blank or swatch_image != blank %}
                          {% assign has_native_swatch = true %}
                        {% endif %}

                        {% if value.available %}
                          <a
                            class="main-product__option-value main-product__swatch{% unless has_native_swatch %} main-product__swatch--fallback{% endunless %}"
                            href="{{ option_url }}"
                            data-variant-link
                            data-variant-id="{{ option_variant.id }}"
                            aria-label="Choose color: {{ value.name | escape }}"
                            style="{{ swatch_style | strip }}"
                            {% if value.selected %}
                              aria-current="true"
                            {% endif %}
                          >
                            <span class="main-product__swatch-fill" aria-hidden="true">
                              {% unless has_native_swatch %}{{ value.name | slice: 0, 2 }}{% endunless %}
                            </span>
                            <span class="visually-hidden">
                              {{ value.name }}
                              {% if value.selected %} selected{% endif %}
                            </span>
                          </a>
                        {% else %}
                          <span
                            class="main-product__option-value main-product__swatch{% unless has_native_swatch %} main-product__swatch--fallback{% endunless %}"
                            aria-disabled="true"
                            aria-label="Choose color: {{ value.name | escape }} unavailable"
                            style="{{ swatch_style | strip }}"
                            {% if value.selected %}
                              aria-current="true"
                            {% endif %}
                          >
                            <span class="main-product__swatch-fill" aria-hidden="true">
                              {% unless has_native_swatch %}{{ value.name | slice: 0, 2 }}{% endunless %}
                            </span>
                            <span class="visually-hidden">{{ value.name }} unavailable</span>
                          </span>
                        {% endif %}
                      {% else %}
                        {% if value.available %}
                          <a
                            class="main-product__option-value"
                            href="{{ product.url }}?variant={{ option_variant.id }}"
                            {% if value.selected %}
                              aria-current="true"
                            {% endif %}
                          >
                            {{ value.name }}
                          </a>
                        {% else %}
                          <span
                            class="main-product__option-value"
                            aria-disabled="true"
                            {% if value.selected %}
                              aria-current="true"
                            {% endif %}
                          >
                            {{ value.name }}
                          </span>
                        {% endif %}
                      {% endif %}
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}
            </fieldset>
          {% endfor %}
        </div>
      {% endunless %}

      <div data-product-form-region>
        {% form 'product', product %}
          {% if current_variant %}
            <input type="hidden" name="id" value="{{ current_variant.id }}">
          {% endif %}

          <div class="main-product__quantity">
            <label class="main-product__quantity-label main-product__step-label" for="Quantity-{{ section.id }}">
              {{- forloop.index | default: 3 }}. {{ 'product.quantity' | t -}}
            </label>
            <div class="main-product__quantity-control" data-quantity-control>
              <button
                class="main-product__quantity-button"
                type="button"
                data-quantity-decrease
                aria-label="Decrease quantity"
              >
                <span aria-hidden="true">-</span>
              </button>
              <input
                id="Quantity-{{ section.id }}"
                class="main-product__quantity-input"
                type="number"
                name="quantity"
                min="1"
                value="1"
                inputmode="numeric"
              >
              <button
                class="main-product__quantity-button"
                type="button"
                data-quantity-increase
                aria-label="Increase quantity"
              >
                <span aria-hidden="true">+</span>
              </button>
            </div>
          </div>

          <button
            class="main-product__submit btn btn--primary"
            type="submit"
            {% if current_variant == null or current_variant.available == false %}
              disabled
            {% endif %}
          >
            {% if current_variant and current_variant.available %}
              {{ 'product.add_to_cart' | t }}
            {% else %}
              {{ 'product.sold_out' | t }}
            {% endif %}
          </button>

          {% comment %} <p class="main-product__help-text">{{ 'product.help_text' | t }}</p> {% endcomment %}
        {% endform %}
      </div>
    </div>
  </div>

  {% comment %}
    {% if product.description != blank %}
      <div class="main-product__details">
        <h2 class="main-product__details-title">{{ 'product.details' | t }}</h2>
        <div class="main-product__details-content">{{ product.description }}</div>
      </div>
    {% endif %}
  {% endcomment %}
</div>

{% stylesheet %}
  .page-width.main-product {
    padding: 2rem 0 3rem;
  }

  .main-product__main {
    display: grid;
    gap: 0.7rem;
    align-items: start;
  }

  .main-product__title {
    margin: 0;
    font-family: var(--theme-font-display);
    font-size: clamp(2.1rem, 8vw, 4.75rem);
    font-weight: 600;
    line-height: 0.96;
    letter-spacing: -0.035em;
  }

  .main-product__media-column {
    display: grid;
    gap: 1rem;
  }

  .main-product__gallery {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 5.4rem;
    gap: 0.9rem;
    align-items: start;
  }

  .main-product__gallery-main {
    display: grid;
    min-width: 0;
  }

  .main-product__gallery-frame {
    position: relative;
    overflow: hidden;
    border-radius: 1.5rem;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
    aspect-ratio: 4/3;
  }

  .main-product__gallery-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: none;
    pointer-events: none;
  }

  .main-product__gallery-image,
  .main-product__gallery-placeholder {
    width: 100%;
    object-fit: cover;
    height: 100%;
  }

  .main-product__gallery-zoom {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    background: rgba(4, 11, 24, 0.72);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12), 0 0 24px rgba(0, 0, 0, 0.24);
    color: var(--theme-color-text);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    pointer-events: none;
  }

  .main-product__gallery-zoom svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  .main-product__gallery-thumbnails {
    position: relative;
    height: var(--gallery-thumb-rail-height, auto);
    max-height: var(--gallery-thumb-rail-height, none);
  }

  .main-product__gallery-thumbnails-scroll {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    max-height: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 0.15rem;
    border-radius: 16px;
  }

  .main-product__gallery-thumbnails-scroll::-webkit-scrollbar {
    width: 0.42rem;
  }

  .main-product__gallery-thumbnails-scroll::-webkit-scrollbar-track {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.02));
    border-radius: 999px;
    -webkit-border-radius: 999px;
  }

  .main-product__gallery-thumbnails-scroll::-webkit-scrollbar-thumb {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    background: linear-gradient(180deg, rgba(255, 77, 166, 0.78), rgba(110, 200, 255, 0.58));
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08), 0 0 10px rgba(255, 77, 166, 0.12);
  }

  .main-product__gallery-thumbnails-scroll::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(180deg, rgba(255, 77, 166, 0.86), rgba(110, 200, 255, 0.68));
  }

  .main-product__gallery-rail-indicator {
    position: absolute;
    left: 0;
    right: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2.35rem;
    color: rgba(255, 255, 255, 0.52);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--transition-base);
    border-radius: 15px;
    overflow: hidden;
    margin: 0 3px;
  }

  .main-product__gallery-rail-indicator.is-visible {
    opacity: 1;
    visibility: visible;
  }

  .main-product__gallery-rail-indicator--top {
