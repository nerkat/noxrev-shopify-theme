    },
    {
      "type": "checkbox",
      "id": "gallery_zoom",
      "label": "Enable image zoom",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "variant_media",
      "label": "Show selected variant media",
      "default": true
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "title",
