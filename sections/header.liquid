{% liquid
  assign brand_text = section.settings.brand_text | default: shop.name
  assign has_primary_nav = false
  assign has_mobile_nav = false
  assign utility_text = section.settings.utility_text
  assign utility_link = section.settings.utility_link
  assign has_utility = false
  assign mobile_drawer_brand_text = section.settings.mobile_drawer_brand_text | default: brand_text
  assign has_mobile_drawer_social_links = false
  assign has_mobile_drawer_help_menu = false

  if section.settings.menu != blank
    for link in section.settings.menu.links
      assign has_primary_nav = true
      assign has_mobile_nav = true
      break
    endfor
  endif

  if utility_text != blank
    assign has_utility = true
  endif

  if section.settings.mobile_drawer_social_tiktok != blank
    assign has_mobile_drawer_social_links = true
  endif

  if section.settings.mobile_drawer_social_instagram != blank
    assign has_mobile_drawer_social_links = true
  endif

  if section.settings.mobile_drawer_social_facebook != blank
    assign has_mobile_drawer_social_links = true
  endif

  if section.settings.mobile_drawer_social_youtube != blank
    assign has_mobile_drawer_social_links = true
  endif

  if section.settings.mobile_drawer_help_menu != blank
    for link in section.settings.mobile_drawer_help_menu.links
      assign has_mobile_drawer_help_menu = true
      break
    endfor
  endif
-%}

<header class="header" data-site-header>
  <div class="header__inner container">
    {% if has_mobile_nav %}
      <details class="header__mobile hidden-desktop">
        <summary class="header__mobile-toggle" aria-label="Menu">
          <span></span>
          <span></span>
          <span></span>
        </summary>
        <button class="header__mobile-overlay" type="button" data-mobile-menu-close aria-label="Close menu"></button>
        <div class="header__mobile-panel">
          <button class="header__mobile-close" type="button" data-mobile-menu-close aria-label="Close menu">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
            </svg>
          </button>

          <nav class="header__mobile-nav" aria-label="Mobile">
            {% for link in section.settings.menu.links %}
              <a
                class="header__mobile-link{% if link.current or link.child_active %} is-active{% endif %}"
                href="{{ link.url }}"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                {{ link.title }}
              </a>
            {% endfor %}
          </nav>

          {% if has_utility %}
            {% if utility_link != blank %}
              <a class="header__mobile-utility" href="{{ utility_link }}">{{ utility_text | escape }}</a>
            {% else %}
              <p class="header__mobile-utility">{{ utility_text | escape }}</p>
            {% endif %}
          {% endif %}

          {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
            <a class="button" href="{{ section.settings.cta_link }}">
              <span class="button__content">
                <span>{{ section.settings.cta_label | escape }}</span>
                <span class="button__icon" aria-hidden="true">&rarr;</span>
              </span>
            </a>
          {% endif %}

          {% if section.settings.show_mobile_drawer_footer %}
            <div class="header__mobile-footer">
              <a
                class="header__mobile-footer-brand"
                href="{{ routes.root_url }}"
                aria-label="{{ mobile_drawer_brand_text | escape }}"
              >
                {% if section.settings.mobile_drawer_logo != blank %}
                  {{
                    section.settings.mobile_drawer_logo
                    | image_url: width: 360
                    | image_tag: class: 'header__mobile-footer-logo', loading: 'lazy', alt: mobile_drawer_brand_text
                  }}
                {% elsif section.settings.logo != blank %}
                  {{
                    section.settings.logo
                    | image_url: width: 360
                    | image_tag: class: 'header__mobile-footer-logo', loading: 'lazy', alt: mobile_drawer_brand_text
                  }}
                {% else %}
                  <span class="header__mobile-footer-brand-text">{{ mobile_drawer_brand_text | escape }}</span>
                {% endif %}
              </a>

              {% if section.settings.mobile_drawer_text != blank %}
                <p class="header__mobile-footer-text">{{ section.settings.mobile_drawer_text | escape }}</p>
              {% endif %}

              <div class="header__mobile-footer-contact">
                {% if section.settings.mobile_drawer_contact_email != blank %}
                  <a href="mailto:{{ section.settings.mobile_drawer_contact_email }}">
                    {{- section.settings.mobile_drawer_contact_email -}}
                  </a>
                {% endif %}
                {% if section.settings.mobile_drawer_contact_phone != blank %}
                  <a href="tel:{{ section.settings.mobile_drawer_contact_phone | replace: ' ', '' }}">
                    {{- section.settings.mobile_drawer_contact_phone -}}
                  </a>
                {% endif %}
              </div>

              {% if section.settings.mobile_drawer_show_social_links and has_mobile_drawer_social_links %}
                <div class="header__mobile-footer-social" aria-label="Social links">
                  {% if section.settings.mobile_drawer_social_tiktok != blank %}
                    <a
                      class="header__mobile-footer-social-link"
                      href="{{ section.settings.mobile_drawer_social_tiktok }}"
                      aria-label="TikTok"
                    >
                      <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true">
                        <path d="M14 4v9.1a4.2 4.2 0 1 1-3.2-4.1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
                        <path d="M14 4c.5 2.6 2.1 4.2 4.8 4.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
                      </svg>
                    </a>
                  {% endif %}
                  {% if section.settings.mobile_drawer_social_instagram != blank %}
                    <a
                      class="header__mobile-footer-social-link"
                      href="{{ section.settings.mobile_drawer_social_instagram }}"
                      aria-label="Instagram"
                    >
                      <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true">
                        <rect x="5" y="5" width="14" height="14" rx="4" stroke="currentColor" stroke-width="1.7"></rect>
                        <circle cx="12" cy="12" r="3.2" stroke="currentColor" stroke-width="1.7"></circle>
                        <path d="M16.3 7.8h.01" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
                      </svg>
                    </a>
                  {% endif %}
                  {% if section.settings.mobile_drawer_social_facebook != blank %}
                    <a
                      class="header__mobile-footer-social-link"
                      href="{{ section.settings.mobile_drawer_social_facebook }}"
                      aria-label="Facebook"
                    >
                      <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true">
                        <path d="M14 8.6h2.3V5.2A10 10 0 0 0 13.1 5c-3.1 0-5 1.8-5 5.2v2.2H5v3.8h3.1V22h3.8v-5.8h3.1l.5-3.8h-3.6v-1.8c0-1.1.3-2 2.1-2Z" stroke="currentColor" stroke-width="1.45" stroke-linejoin="round"></path>
                      </svg>
                    </a>
                  {% endif %}
                  {% if section.settings.mobile_drawer_social_youtube != blank %}
                    <a
                      class="header__mobile-footer-social-link"
                      href="{{ section.settings.mobile_drawer_social_youtube }}"
                      aria-label="YouTube"
                    >
                      <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true">
                        <path d="M21 12s0-3.2-.4-4.4c-.2-.7-.8-1.3-1.5-1.5C17.8 5.8 12 5.8 12 5.8s-5.8 0-7.1.3c-.7.2-1.3.8-1.5 1.5C3 8.8 3 12 3 12s0 3.2.4 4.4c.2.7.8 1.3 1.5 1.5 1.3.3 7.1.3 7.1.3s5.8 0 7.1-.3c.7-.2 1.3-.8 1.5-1.5.4-1.2.4-4.4.4-4.4Z" stroke="currentColor" stroke-width="1.55" stroke-linejoin="round"></path>
                        <path d="m10.4 9.4 4.2 2.6-4.2 2.6V9.4Z" fill="currentColor"></path>
                      </svg>
                    </a>
                  {% endif %}
                </div>
              {% endif %}

              {% if has_mobile_drawer_help_menu %}
                <nav class="header__mobile-footer-menu" aria-label="Mobile drawer help">
                  <h2 class="header__mobile-footer-heading">Help</h2>
                  <div class="header__mobile-footer-links">
                    {% for link in section.settings.mobile_drawer_help_menu.links %}
                      <a class="header__mobile-footer-link" href="{{ link.url }}">{{ link.title }}</a>
                    {% endfor %}
                  </div>
                </nav>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </details>
    {% endif %}

    <div class="header__brand">
      <a class="header__brand-link" href="{{ routes.root_url }}">
        {% if section.settings.logo != blank %}
          {{
            section.settings.logo
            | image_url: width: 400
            | image_tag: class: 'header__logo', loading: 'eager', alt: brand_text
          }}
        {% else %}
          <span class="header__brand-text">{{ brand_text | escape }}</span>
        {% endif %}
      </a>
    </div>

    {% if has_primary_nav %}
      <nav class="header__nav hidden-mobile" aria-label="Primary">
        {% for link in section.settings.menu.links %}
          <a
            class="header__nav-link{% if link.current or link.child_active %} is-active{% endif %}"
            href="{{ link.url }}"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            {{ link.title }}
          </a>
        {% endfor %}
      </nav>
    {% endif %}

    <div class="header__actions">
      {% if has_utility %}
        {% if utility_link != blank %}
          <a class="header__utility hidden-mobile" href="{{ utility_link }}">{{ utility_text | escape }}</a>
        {% else %}
          <p class="header__utility hidden-mobile">{{ utility_text | escape }}</p>
        {% endif %}
      {% endif %}

      {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
        <a class="button hidden-mobile" href="{{ section.settings.cta_link }}">
          <span class="button__content">
            <span>{{ section.settings.cta_label | escape }}</span>
            <span class="button__icon" aria-hidden="true">&rarr;</span>
          </span>
        </a>
      {% endif %}

      {% comment %}
        {% if shop.customer_accounts_enabled %}
          <shopify-account class="header__account" menu="{{ section.settings.customer_account_menu }}">
            <span class="visually-hidden">Account</span>
            {{ 'icon-account.svg' | inline_asset_content }}
          </shopify-account>
        {% endif %}
      {% endcomment %}

      <a class="header__cart" href="{{ routes.cart_url }}">
        <span class="header__cart-icon">{{ 'icon-cart.svg' | inline_asset_content }}</span>
        <span class="header__cart-label visually-hidden">Cart</span>
        <span class="header__cart-count" aria-live="polite">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .header {
    position: relative;
    top: auto;
    z-index: auto;
    border-bottom: 1px solid transparent;
    background: transparent;
    box-shadow: none;
    backdrop-filter: blur(0);
    -webkit-backdrop-filter: blur(0);
    transition: background-color 220ms ease, border-color 220ms ease, box-shadow 220ms ease, backdrop-filter 220ms ease,
      -webkit-backdrop-filter 220ms ease;
  }

  .site-header-shell.is-scrolled .header {
    border-bottom-color: transparent;
    background: transparent;
  }

  .header__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.25rem;
    padding-block: 0.9rem;
  }

  .header__brand-link,
  .header__nav-link,
  .header__cart,
  .header__account,
  .header__mobile-link {
    color: inherit;
    text-decoration: none;
  }

  .header__brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
  }

  .header__brand-text {
    font-family: var(--theme-font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: color var(--transition-base);
  }

  .header__brand-link:hover .header__brand-text {
    color: var(--theme-color-primary);
  }

  .header__logo {
    display: block;
    max-width: 196px;
    width: auto;
    height: auto;
  }

  .header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .header__nav-link,
  .header__mobile-link,
  .header__mobile-toggle {
    font-size: 0.9rem;
  }

  .header__nav-link {
    border-radius: var(--theme-radius-pill);
    padding: 0.6rem 1rem;
    color: var(--theme-color-text-muted);
    transition: color var(--transition-base), border-color var(--transition-base),
      background-color var(--transition-base), box-shadow var(--transition-base);
  }

  .header__nav-link:hover {
    border-color: rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.05);
    color: var(--theme-color-secondary);
    box-shadow: 0 0 22px rgba(0, 229, 255, 0.08);
  }

  .header__nav-link.is-active {
    border-color: var(--theme-color-border);
    background: linear-gradient(135deg, rgba(255, 45, 120, 0.16), rgba(155, 0, 255, 0.12), rgba(0, 229, 255, 0.12));
    color: var(--theme-color-text);
    box-shadow: 0 0 22px rgba(255, 45, 120, 0.12);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    justify-self: end;
  }

  .header__utility {
    margin: 0;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.86rem;
    letter-spacing: 0;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--transition-base);
  }

  a.header__utility:hover {
    color: var(--theme-color-secondary);
  }

  .header__account svg,
  .header__cart-icon svg {
    width: 1.5rem;
    color: currentcolor;
  }

  .header__account,
  .header__cart {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    min-height: 2.5rem;
    border-radius: var(--theme-radius-pill);
    background: rgba(255, 255, 255, 0.04);
    color: var(--theme-color-text);
    transition: color var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .header__cart {
    padding-inline: 0.7rem;
    position: relative;
  }

  .header__account:hover,
  .header__cart:hover {
    border-color: rgba(0, 229, 255, 0.42);
    color: var(--theme-color-secondary);
    box-shadow: 0 0 22px rgba(0, 229, 255, 0.1);
  }

  .header__cart-count {
    padding: 0.2rem;
    line-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    text-align: center;
    font-size: 0.6rem;
    color: white;
    background-color: var(--theme-color-secondary);
    aspect-ratio: 1 / 1;
    position: absolute;
    top: 4px;
    right: 2px;
  }

  .header__mobile {
    position: relative;
  }

  .header__mobile-overlay {
    display: none;
  }

  .header__mobile-toggle {
    display: inline-grid;
    gap: 0.25rem;
    place-items: left;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgba(0, 229, 255, 0.3);
    border-radius: var(--theme-radius-pill);
    background: rgba(255, 255, 255, 0.04);
    cursor: pointer;
    list-style: none;
  }

  .header__mobile-toggle::-webkit-details-marker {
    display: none;
  }

  .header__mobile-toggle span {
    display: block;
    width: 1rem;
    height: 0.1rem;
    background: currentcolor;
    border-radius: 999px;

    &:nth-of-type(2) {
      width: 1rem;
      height: 0.08rem;
    }
    &:last-of-type {
      width: 0.7rem;
      height: 0.05rem;
    }
  }

  .header__mobile-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.75rem);
    z-index: var(--z-menu);
    display: grid;
    gap: 0.75rem;
    min-width: min(18rem, calc(100vw - 2rem));
    padding: 1rem;
    border: 1px solid var(--theme-color-border);
    border-radius: var(--theme-radius-lg);
    background: rgba(4, 11, 24, 0.96);
    box-shadow: var(--theme-shadow-lg);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
  }

  .header__mobile-close {
    display: none;
    place-self: end;
    width: 2.4rem;
    height: 2.4rem;
    place-items: center;
    border: none;
    border-radius: 999px;
    color: var(--theme-color-text);
    background: rgba(255, 255, 255, 0.04);
    cursor: pointer;
    transition: color var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
    -webkit-tap-highlight-color: transparent;
  }

  .header__mobile-close:hover,
  .header__mobile-close:focus-visible {
    border-color: rgba(0, 229, 255, 0.48);
    color: var(--theme-color-secondary);
    box-shadow: 0 0 22px rgba(0, 229, 255, 0.1);
  }

  .header__mobile-close svg {
    width: 1.05rem;
  }

  .header__mobile-nav {
    display: grid;
    gap: 0.35rem;
  }

  .header__mobile-link {
    border-radius: var(--theme-radius-md);
    padding: 0.85rem 0.9rem;
    color: var(--theme-color-text);
    height: fit-content;
  }

  .header__mobile-link:hover {
    background: rgba(255, 255, 255, 0.05);
    color: var(--theme-color-secondary);
  }

  .header__mobile-link.is-active {
    background: linear-gradient(135deg, rgba(255, 45, 120, 0.16), rgba(155, 0, 255, 0.12), rgba(0, 229, 255, 0.12));
    color: var(--theme-color-text);
  }

  .header__mobile-utility {
    margin: 0;
    border-top: 1px solid var(--theme-color-border);
    padding-top: 0.85rem;
    color: var(--theme-color-text-soft);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .header__mobile-footer {
    display: grid;
    gap: 1rem;
    margin-top: auto;
    padding: 0.85rem 0.9rem;
  }

  .header__mobile-footer-brand,
  .header__mobile-footer-contact a,
  .header__mobile-footer-link,
  .header__mobile-footer-social-link {
    color: inherit;
    text-decoration: none;
  }

  .header__mobile-footer-brand {
    display: inline-flex;
    width: fit-content;
    align-items: center;
  }

  .header__mobile-footer-logo {
    display: block;
    max-width: 12.5rem;
    width: auto;
    height: auto;
  }

  .header__mobile-footer-brand-text {
    color: var(--theme-color-text);
    font-family: var(--theme-font-display);
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .header__mobile-footer-text {
    max-width: 22rem;
    margin: 0;
    color: var(--theme-color-text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .header__mobile-footer-contact {
    display: grid;
    gap: 0.55rem;
  }

  .header__mobile-footer-contact,
  .header__mobile-footer-contact a {
    color: var(--theme-color-text-muted);
    font-size: 1rem;
    line-height: 1.35;
  }

  .header__mobile-footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .header__mobile-footer-social-link {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(0, 229, 255, 0.24);
    border-radius: 12px;
    color: var(--theme-color-secondary);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.018));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
    transition: border-color var(--transition-base), color var(--transition-base), box-shadow var(--transition-base),
      transform var(--transition-base);
  }

  .header__mobile-footer-social-link svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  .header__mobile-footer-social-link:hover,
  .header__mobile-footer-social-link:focus-visible,
  .header__mobile-footer-link:hover,
  .header__mobile-footer-link:focus-visible,
  .header__mobile-footer-contact a:hover,
  .header__mobile-footer-contact a:focus-visible {
    color: var(--theme-color-secondary);
  }

  .header__mobile-footer-social-link:hover,
  .header__mobile-footer-social-link:focus-visible {
    border-color: rgba(0, 229, 255, 0.68);
    color: var(--theme-color-accent);
    box-shadow: 0 0 24px rgba(0, 229, 255, 0.18), 0 0 18px rgba(255, 77, 166, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    transform: translateY(-1px) scale(1.05);
  }

  .header__mobile-footer-heading {
    margin: 0 0 0.8rem;
    color: var(--theme-color-secondary);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .header__mobile-footer-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem 1.5rem;
  }

  .header__mobile-footer-link {
    color: var(--theme-color-text-muted);
    font-size: 1rem;
    line-height: 1.2;
  }

  @media (max-width: 989px) {
    .header__inner {
      grid-template-columns: auto 1fr auto;
      gap: 0.75rem;
    }

    .header__nav {
      display: none;
    }

    .header__brand {
      display: flex;
    }

    .header__brand-link {
      gap: 0.7rem;
      justify-content: flex-start;
    }

    .header__brand-text {
      font-size: 1.05rem;
      letter-spacing: 0.03em;
    }

    .header__logo {
      max-height: 16px;
    }

    .header__actions {
      justify-self: end;
      gap: 0.55rem;
    }

    .header__mobile {
      position: relative;
      justify-self: start;
      display: flex;
    }

    .header__mobile[open] {
      z-index: 130;
    }

    .header__mobile-toggle {
      width: fit-content;
      height: 1rem;
      border: 0;
      background: transparent;
      box-shadow: none;
      padding: 0;
    }

    .header__mobile-toggle span {
      width: 1rem;
      background: rgba(255, 255, 255, 0.75);
    }

    .header__account,
    .header__cart {
      min-width: 2.45rem;
      min-height: 2.45rem;
    }

    .header__mobile-overlay {
      position: fixed;
      inset: 0;
      z-index: 128;
      display: block;
      border: 0;
      padding: 0;
      background: rgba(2, 7, 18, 0.58);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      backdrop-filter: blur(3px);
      -webkit-backdrop-filter: blur(3px);
      transition: opacity 220ms ease, visibility 220ms ease;
    }

    .header__mobile[open] .header__mobile-overlay {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .header__mobile-panel {
      position: fixed;
      top: 0;
      left: 0;
      right: auto;
      z-index: 129;
      min-width: 0;
      bottom: 0;
      width: min(88vw, 24rem);
      height: 100svh;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
      padding: 1.15rem;
      border: 1px solid rgba(0, 229, 255, 0.18);
      border-left: 0;
      border-radius: 0 1.25rem 1.25rem 0;
      background: radial-gradient(circle at 0% 0%, rgba(0, 229, 255, 0.16), transparent 34%),
        radial-gradient(circle at 100% 20%, rgba(255, 45, 120, 0.12), transparent 34%), rgba(4, 13, 25, 0.97);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05), 0 24px 80px rgba(0, 0, 0, 0.48);
      transform: translateX(-100%);
      visibility: hidden;
      pointer-events: none;
      transition: transform 280ms ease, visibility 280ms ease;
      overflow-y: auto;
      overscroll-behavior: contain;
      backdrop-filter: blur(22px);
      -webkit-backdrop-filter: blur(22px);
    }

    .header__mobile[open] .header__mobile-panel {
      transform: translateX(0);
      visibility: visible;
      pointer-events: auto;
    }

    .header__mobile.is-closing .header__mobile-overlay {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .header__mobile.is-closing .header__mobile-panel {
      transform: translateX(-100%);
      visibility: visible;
      pointer-events: none;
    }

    .header__mobile-close {
      display: grid;
    }

    .header__mobile-nav {
      display: grid;
      gap: 0.4rem;
    }

    .header__mobile-footer {
      padding-bottom: 0.35rem;
    }

    body.mobile-menu-open {
      overflow: hidden;
    }
  }

  @media (max-width: 749px) {
    .header__mobile-panel {
      inset: 0;
      width: 100%;
      border-radius: 0;
      border-left: 0;
      border-right: 0;
    }

    .header__cart {
      padding-inline: 0.4rem;
      min-width: 2rem;
      min-height: 2rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const shell = document.querySelector('[data-site-header-shell]');

    const updateScrolledState = () => {
      const isScrolled = window.scrollY > 20;

      document.body.classList.toggle('is-scrolled', isScrolled);

      if (shell) {
        shell.classList.toggle('is-scrolled', isScrolled);
      }
    };

    updateScrolledState();
    window.addEventListener('scroll', updateScrolledState, { passive: true });
    document.addEventListener('shopify:section:load', updateScrolledState);

    const closeMobileMenu = (mobileMenu) => {
      if (!mobileMenu) {
        return;
      }

      if (!mobileMenu.open || mobileMenu.classList.contains('is-closing')) {
        return;
      }

      mobileMenu.classList.add('is-closing');
      document.body.classList.remove('mobile-menu-open');

      window.setTimeout(() => {
        mobileMenu.open = false;
        mobileMenu.classList.remove('is-closing');
      }, 280);
    };

    const syncMobileMenuState = (mobileMenu) => {
      if (!mobileMenu) {
        return;
      }

      if (mobileMenu.open && !mobileMenu.classList.contains('is-closing')) {
        document.body.classList.add('mobile-menu-open');
      } else if (!mobileMenu.open) {
        document.body.classList.remove('mobile-menu-open');
      }
    };

    document.querySelectorAll('.header__mobile').forEach((mobileMenu) => {
      mobileMenu.addEventListener('toggle', () => syncMobileMenuState(mobileMenu));
    });

    document.addEventListener('click', (event) => {
      const toggle = event.target.closest('.header__mobile-toggle');

      if (!toggle) {
        return;
      }

      const mobileMenu = toggle.closest('details');

      if (!mobileMenu?.open) {
        return;
      }

      event.preventDefault();
      closeMobileMenu(mobileMenu);
    });

    document.addEventListener('click', (event) => {
      const closeTrigger = event.target.closest('[data-mobile-menu-close]');
      const mobileLink = event.target.closest(
        '.header__mobile-link, .header__mobile-utility, .header__mobile-panel .button, .header__mobile-footer a'
      );

      if (!closeTrigger && !mobileLink) {
        return;
      }

      const mobileMenu = (closeTrigger || mobileLink).closest('details');

      closeMobileMenu(mobileMenu);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') {
        return;
      }

      document.querySelectorAll('.header__mobile[open]').forEach(closeMobileMenu);
    });
  })();
{% endjavascript %}

