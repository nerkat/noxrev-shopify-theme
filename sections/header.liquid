{% liquid
  assign brand_text = section.settings.brand_text | default: shop.name
  assign has_primary_nav = false
  assign has_mobile_nav = false
  assign utility_text = section.settings.utility_text
  assign utility_link = section.settings.utility_link
  assign has_utility = false

  if section.settings.menu != blank
    for link in section.settings.menu.links
      assign has_primary_nav = true
      assign has_mobile_nav = true
      break
    endfor
  endif

  if utility_text != blank
    assign has_utility = true
  endif
-%}

<header class="header" data-site-header>
  <div class="header__inner container">
    {% if has_mobile_nav %}
      <details class="header__mobile hidden-desktop">
        <summary class="header__mobile-toggle" aria-label="Menu">
          <span></span>
          <span></span>
          <span></span>
        </summary>
        <div class="header__mobile-panel">
          <nav class="header__mobile-nav" aria-label="Mobile">
            {% for link in section.settings.menu.links %}
              <a
                class="header__mobile-link{% if link.current or link.child_active %} is-active{% endif %}"
                href="{{ link.url }}"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                {{ link.title }}
              </a>
            {% endfor %}
          </nav>

          {% if has_utility %}
            {% if utility_link != blank %}
              <a class="header__mobile-utility" href="{{ utility_link }}">{{ utility_text | escape }}</a>
            {% else %}
              <p class="header__mobile-utility">{{ utility_text | escape }}</p>
            {% endif %}
          {% endif %}

          {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
            <a class="button" href="{{ section.settings.cta_link }}">
              <span class="button__content">
                <span>{{ section.settings.cta_label | escape }}</span>
                <span class="button__icon" aria-hidden="true">&rarr;</span>
              </span>
            </a>
          {% endif %}
        </div>
      </details>
    {% endif %}

    <div class="header__brand">
      <a class="header__brand-link" href="{{ routes.root_url }}">
        {% if section.settings.logo != blank %}
          {{
            section.settings.logo
            | image_url: width: 400
            | image_tag: class: 'header__logo', loading: 'eager', alt: brand_text
          }}
        {% else %}
          <span class="header__brand-text">{{ brand_text | escape }}</span>
        {% endif %}
      </a>
    </div>

    {% if has_primary_nav %}
      <nav class="header__nav hidden-mobile" aria-label="Primary">
        {% for link in section.settings.menu.links %}
          <a
            class="header__nav-link{% if link.current or link.child_active %} is-active{% endif %}"
            href="{{ link.url }}"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            {{ link.title }}
          </a>
        {% endfor %}
      </nav>
    {% endif %}

    <div class="header__actions">
      {% if has_utility %}
        {% if utility_link != blank %}
          <a class="header__utility hidden-mobile" href="{{ utility_link }}">{{ utility_text | escape }}</a>
        {% else %}
          <p class="header__utility hidden-mobile">{{ utility_text | escape }}</p>
        {% endif %}
      {% endif %}

      {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
        <a class="button hidden-mobile" href="{{ section.settings.cta_link }}">
          <span class="button__content">
            <span>{{ section.settings.cta_label | escape }}</span>
            <span class="button__icon" aria-hidden="true">&rarr;</span>
          </span>
        </a>
      {% endif %}

      {% comment %}
        {% if shop.customer_accounts_enabled %}
          <shopify-account class="header__account" menu="{{ section.settings.customer_account_menu }}">
            <span class="visually-hidden">Account</span>
            {{ 'icon-account.svg' | inline_asset_content }}
          </shopify-account>
        {% endif %}
      {% endcomment %}

      <a class="header__cart" href="{{ routes.cart_url }}">
        <span class="header__cart-icon">{{ 'icon-cart.svg' | inline_asset_content }}</span>
        <span class="header__cart-label visually-hidden">Cart</span>
        <span class="header__cart-count" aria-live="polite">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .header {
    position: relative;
    top: auto;
    z-index: auto;
    border-bottom: 1px solid transparent;
    background: transparent;
    box-shadow: none;
    backdrop-filter: blur(0);
    -webkit-backdrop-filter: blur(0);
    transition: background-color 220ms ease, border-color 220ms ease, box-shadow 220ms ease, backdrop-filter 220ms ease,
      -webkit-backdrop-filter 220ms ease;
  }

  .site-header-shell.is-scrolled .header {
    border-bottom-color: transparent;
    background: transparent;
  }

  .header__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.25rem;
    padding-block: 0.9rem;
  }

  .header__brand-link,
  .header__nav-link,
  .header__cart,
  .header__account,
  .header__mobile-link {
    color: inherit;
    text-decoration: none;
  }

  .header__brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
  }

  .header__brand-text {
    font-family: var(--theme-font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: color var(--transition-base);
  }

  .header__brand-link:hover .header__brand-text {
    color: var(--theme-color-primary);
  }

  .header__logo {
    display: block;
    max-width: 196px;
    width: auto;
    height: auto;
  }

  .header__nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .header__nav-link,
  .header__mobile-link,
  .header__mobile-toggle {
    font-size: 0.9rem;
  }

  .header__nav-link {
    border: 1px solid transparent;
    border-radius: var(--theme-radius-pill);
    padding: 0.6rem 1rem;
    color: var(--theme-color-text-muted);
    transition: color var(--transition-base), border-color var(--transition-base),
      background-color var(--transition-base), box-shadow var(--transition-base);
  }

  .header__nav-link:hover {
    border-color: rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.05);
    color: var(--theme-color-secondary);
    box-shadow: 0 0 22px rgba(0, 229, 255, 0.08);
  }

  .header__nav-link.is-active {
    border-color: var(--theme-color-border);
    background: linear-gradient(135deg, rgba(255, 45, 120, 0.16), rgba(155, 0, 255, 0.12), rgba(0, 229, 255, 0.12));
    color: var(--theme-color-text);
    box-shadow: 0 0 22px rgba(255, 45, 120, 0.12);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    justify-self: end;
  }

  .header__utility {
    margin: 0;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.86rem;
    letter-spacing: 0;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--transition-base);
  }

  a.header__utility:hover {
    color: var(--theme-color-secondary);
  }

  .header__account svg,
  .header__cart-icon svg {
    width: 1.25rem;
    color: currentcolor;
  }

  .header__account,
  .header__cart {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    min-height: 2.5rem;
    border: 1px solid var(--theme-color-border);
    border-radius: var(--theme-radius-pill);
    background: rgba(255, 255, 255, 0.04);
    color: var(--theme-color-text);
    transition: color var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .header__cart {
    padding-inline: 0.7rem;
  }

  .header__account:hover,
  .header__cart:hover {
    border-color: rgba(0, 229, 255, 0.42);
    color: var(--theme-color-secondary);
    box-shadow: 0 0 22px rgba(0, 229, 255, 0.1);
  }

  .header__cart-count {
    min-width: 1rem;
    text-align: center;
    font-size: 0.8rem;
    color: var(--theme-color-secondary);
  }

  .header__mobile {
    position: relative;
  }

  .header__mobile-toggle {
    display: inline-grid;
    gap: 0.25rem;
    place-items: left;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgba(0, 229, 255, 0.3);
    border-radius: var(--theme-radius-pill);
    background: rgba(255, 255, 255, 0.04);
    cursor: pointer;
    list-style: none;
  }

  .header__mobile-toggle::-webkit-details-marker {
    display: none;
  }

  .header__mobile-toggle span {
    display: block;
    width: 1rem;
    height: 1px;
    background: currentcolor;
  }

  .header__mobile-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.75rem);
    z-index: var(--z-menu);
    display: grid;
    gap: 0.75rem;
    min-width: min(18rem, calc(100vw - 2rem));
    padding: 1rem;
    border: 1px solid var(--theme-color-border);
    border-radius: var(--theme-radius-lg);
    background: rgba(4, 11, 24, 0.96);
    box-shadow: var(--theme-shadow-lg);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
  }

  .header__mobile-nav {
    display: grid;
    gap: 0.35rem;
  }

  .header__mobile-link {
    border-radius: var(--theme-radius-md);
    padding: 0.85rem 0.9rem;
    color: var(--theme-color-text);
  }

  .header__mobile-link:hover {
    background: rgba(255, 255, 255, 0.05);
    color: var(--theme-color-secondary);
  }

  .header__mobile-link.is-active {
    background: linear-gradient(135deg, rgba(255, 45, 120, 0.16), rgba(155, 0, 255, 0.12), rgba(0, 229, 255, 0.12));
    color: var(--theme-color-text);
  }

  .header__mobile-utility {
    margin: 0;
    border-top: 1px solid var(--theme-color-border);
    padding-top: 0.85rem;
    color: var(--theme-color-text-soft);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
  }

  @media (max-width: 989px) {
    .header__inner {
      grid-template-columns: auto 1fr auto;
      gap: 0.75rem;
    }

    .header__nav {
      display: none;
    }

    .header__brand {
      min-width: 0;
      justify-self: start;
    }

    .header__brand-link {
      gap: 0.7rem;
      justify-content: flex-start;
    }

    .header__brand-text {
      font-size: 1.05rem;
      letter-spacing: 0.03em;
    }

    .header__logo {
      max-width: 160px;
    }

    .header__actions {
      justify-self: end;
      gap: 0.55rem;
    }

    .header__mobile {
      position: relative;
      justify-self: start;
      display: flex;
    }

    .header__mobile-toggle {
      width: fit-content;
      height: 0.8rem;
      border: 0;
      background: transparent;
      box-shadow: none;
      padding: 0;
    }

    .header__mobile-toggle span {
      width: 1rem;
      background: rgba(255, 255, 255, 0.75);
    }

    .header__account,
    .header__cart {
      min-width: 2.45rem;
      min-height: 2.45rem;
    }

    .header__mobile-panel {
      position: fixed;
      top: calc(var(--announcement-height, 2.7rem) + 4.5rem);
      left: 1rem;
      right: 1rem;
      min-width: 0;
      padding: 1rem;
    }

    .header__mobile-nav {
      display: grid;
      gap: 0.4rem;
    }
  }

  @media (max-width: 749px) {
    .header__cart {
      padding-inline: 0.4rem;
      min-width: 2rem;
      min-height: 2rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const shell = document.querySelector('[data-site-header-shell]');

    const updateScrolledState = () => {
      const isScrolled = window.scrollY > 20;

      document.body.classList.toggle('is-scrolled', isScrolled);

      if (shell) {
        shell.classList.toggle('is-scrolled', isScrolled);
      }
    };

    updateScrolledState();
    window.addEventListener('scroll', updateScrolledState, { passive: true });
    document.addEventListener('shopify:section:load', updateScrolledState);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand text",
      "default": "Store name"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Primary menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "Customer account menu",
      "default": "customer-account-main-menu"
    },
    {
      "type": "text",
      "id": "utility_text",
      "label": "Utility text"
    },
    {
      "type": "url",
      "id": "utility_link",
      "label": "Utility link"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    }
  ]
}
{% endschema %}
