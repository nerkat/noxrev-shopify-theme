{% liquid
  assign brand_text = section.settings.brand_text | default: shop.name
  assign has_primary_nav = false
  assign has_mobile_nav = false

  if section.settings.menu != blank
    for link in section.settings.menu.links
      assign has_primary_nav = true
      assign has_mobile_nav = true
      break
    endfor
  endif
-%}

<header class="header">
  <div class="container">
    <div class="header__inner">
      <div class="header__brand">
        <a class="header__brand-link" href="{{ routes.root_url }}">
          {% if section.settings.logo != blank %}
            {{
              section.settings.logo
              | image_url: width: 400
              | image_tag: class: 'header__logo', loading: 'eager', alt: brand_text
            }}
          {% else %}
            <span class="header__brand-text">{{ brand_text | escape }}</span>
          {% endif %}
        </a>
      </div>

      {% if has_primary_nav %}
        <nav class="header__nav hidden-mobile" aria-label="Primary">
          {% for link in section.settings.menu.links %}
            <a class="header__nav-link" href="{{ link.url }}">{{ link.title }}</a>
          {% endfor %}
        </nav>
      {% endif %}

      <div class="header__actions">
        {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
          <a class="button button--secondary hidden-mobile" href="{{ section.settings.cta_link }}">
            {{ section.settings.cta_label | escape }}
          </a>
        {% endif %}

        {% if shop.customer_accounts_enabled %}
          <shopify-account class="header__account" menu="{{ section.settings.customer_account_menu }}">
            <span class="visually-hidden">Account</span>
            {{ 'icon-account.svg' | inline_asset_content }}
          </shopify-account>
        {% endif %}

        <a class="header__cart" href="{{ routes.cart_url }}">
          <span class="header__cart-icon">{{ 'icon-cart.svg' | inline_asset_content }}</span>
          <span class="header__cart-label visually-hidden">Cart</span>
          <span class="header__cart-count" aria-live="polite">{{ cart.item_count }}</span>
        </a>

        {% if has_mobile_nav %}
          <details class="header__mobile hidden-desktop">
            <summary class="header__mobile-toggle" aria-label="Menu">
              <span></span>
              <span></span>
              <span></span>
            </summary>
            <div class="header__mobile-panel">
              <nav class="header__mobile-nav" aria-label="Mobile">
                {% for link in section.settings.menu.links %}
                  <a class="header__mobile-link" href="{{ link.url }}">{{ link.title }}</a>
                {% endfor %}
              </nav>

              {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
                <a class="button" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label | escape }}</a>
              {% endif %}
            </div>
          </details>
        {% endif %}
      </div>
    </div>
  </div>
</header>

{% stylesheet %}
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    border-bottom: 1px solid var(--theme-color-border);
    background: rgba(4, 11, 24, 0.78);
    box-shadow:
      0 18px 60px rgba(0, 0, 0, 0.42),
      0 0 24px rgba(0, 229, 255, 0.06);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
  }

  .header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding-block: 0.85rem;
  }

  .header__brand-link,
  .header__nav-link,
  .header__cart,
  .header__account,
  .header__mobile-link {
    color: inherit;
    text-decoration: none;
  }

  .header__brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .header__brand-text {
    font-family: var(--theme-font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: color var(--transition-base);
  }

  .header__brand-link:hover .header__brand-text {
    color: var(--theme-color-primary);
  }

  .header__logo {
    display: block;
    max-width: 180px;
    width: auto;
    height: auto;
  }

  .header__nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .header__nav-link,
  .header__mobile-link,
  .header__mobile-toggle {
    font-size: 0.9rem;
  }

  .header__nav-link {
    border: 1px solid transparent;
    border-radius: var(--theme-radius-pill);
    padding: 0.55rem 0.9rem;
    color: var(--theme-color-text-muted);
    transition:
      color var(--transition-base),
      border-color var(--transition-base),
      background-color var(--transition-base),
      box-shadow var(--transition-base);
  }

  .header__nav-link:hover {
    border-color: var(--theme-color-border);
    background: rgba(255, 255, 255, 0.05);
    color: var(--theme-color-secondary);
    box-shadow: 0 0 22px rgba(0, 229, 255, 0.08);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    justify-self: end;
  }

  .header__account svg,
  .header__cart-icon svg {
    width: 1.25rem;
    color: currentcolor;
  }

  .header__account,
  .header__cart {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    min-height: 2.5rem;
    border: 1px solid var(--theme-color-border);
    border-radius: var(--theme-radius-pill);
    background: rgba(255, 255, 255, 0.04);
    color: var(--theme-color-text);
    transition:
      color var(--transition-base),
      border-color var(--transition-base),
      box-shadow var(--transition-base);
  }

  .header__cart {
    gap: 0.35rem;
    padding-inline: 0.7rem;
  }

  .header__account:hover,
  .header__cart:hover {
    border-color: rgba(0, 229, 255, 0.42);
    color: var(--theme-color-secondary);
    box-shadow: 0 0 22px rgba(0, 229, 255, 0.1);
  }

  .header__cart-count {
    min-width: 1rem;
    text-align: center;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .header__mobile {
    position: relative;
  }

  .header__mobile-toggle {
    display: inline-grid;
    gap: 0.25rem;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgba(0, 229, 255, 0.3);
    border-radius: var(--theme-radius-pill);
    background: rgba(255, 255, 255, 0.04);
    cursor: pointer;
    list-style: none;
  }

  .header__mobile-toggle::-webkit-details-marker {
    display: none;
  }

  .header__mobile-toggle span {
    display: block;
    width: 1rem;
    height: 1px;
    background: currentcolor;
  }

  .header__mobile-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.75rem);
    z-index: var(--z-menu);
    display: grid;
    gap: 0.75rem;
    min-width: min(18rem, calc(100vw - 2rem));
    padding: 1rem;
    border: 1px solid var(--theme-color-border);
    border-radius: var(--theme-radius-lg);
    background: rgba(4, 11, 24, 0.96);
    box-shadow: var(--theme-shadow-lg);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
  }

  .header__mobile-nav {
    display: grid;
    gap: 0.35rem;
  }

  .header__mobile-link {
    border-radius: var(--theme-radius-md);
    padding: 0.85rem 0.9rem;
    color: var(--theme-color-text);
  }

  .header__mobile-link:hover {
    background: rgba(255, 255, 255, 0.05);
    color: var(--theme-color-secondary);
  }

  @media (max-width: 989px) {
    .header__inner {
      grid-template-columns: auto 1fr auto;
    }
  }

  @media (max-width: 749px) {
    .header__inner {
      grid-template-columns: 1fr auto;
      gap: 0.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand text",
      "default": "Store name"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Primary menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "Customer account menu",
      "default": "customer-account-main-menu"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    }
  ]
}
{% endschema %}
