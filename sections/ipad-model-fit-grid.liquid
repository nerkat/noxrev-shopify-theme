{% style %}{% if section.settings.layout_gap > 0 %}#shopify-section-{{ section.id }} .ipad-fit-grid__cards{gap:{{ section.settings.layout_gap }}px}{% endif %}@media(min-width:750px){ {% unless section.settings.layout_columns == 'inherit' %}#shopify-section-{{ section.id }} .ipad-fit-grid__cards{display:grid;grid-template-columns:repeat({{ section.settings.layout_columns }},minmax(0,1fr))}{% endunless %}}@media(max-width:749px){ {% unless section.settings.layout_mobile_columns == 'inherit' %}#shopify-section-{{ section.id }} .ipad-fit-grid__cards{display:grid;grid-template-columns:repeat({{ section.settings.layout_mobile_columns }},minmax(0,1fr))}{% endunless %}}{% unless section.settings.layout_media_fit == 'inherit' %}#shopify-section-{{ section.id }} .ipad-fit-grid__media img{object-fit:{{ section.settings.layout_media_fit }}}{% endunless %}{% unless section.settings.layout_media_ratio == 'inherit' %}#shopify-section-{{ section.id }} .ipad-fit-grid__media img{aspect-ratio:{{ section.settings.layout_media_ratio }};height:auto}{% endunless %}{% endstyle %}
{% render 'section-layout', section: section %}
<section class="ipad-fit-grid section" id="model-fit-grid">
  <div class="container">
    <div class="ipad-fit-grid__header">
      <p class="ipad-fit-grid__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="ipad-fit-grid__title">{{ section.settings.title }}</h2>
      <p class="ipad-fit-grid__text">{{ section.settings.text }}</p>
    </div>

    <div class="ipad-fit-grid__cards" role="list">
      {% for block in section.blocks %}
        {% if block.type == 'model_card' %}
          {% liquid
assign fit_product = block.settings.product | default: settings.catalog_search_keyboard_product
assign fit_url = block.settings.link
assign fit_variant = blank
if fit_product != blank
for variant in fit_product.variants
if variant.options contains block.settings.model_value
assign fit_variant = variant
break
endif
endfor
if fit_variant != blank
assign fit_url = fit_product.url | append: '?variant=' | append: fit_variant.id
elsif fit_url == blank
assign fit_url = fit_product.url
endif
endif
%}
          <a class="ipad-fit-grid__card" {% if fit_url != blank %}href="{{ fit_url }}"{% endif %} role="listitem" {{ block.shopify_attributes }}>
            <span class="ipad-fit-grid__number">{{ forloop.index }}</span>
            <div class="ipad-fit-grid__media">
              {% if block.settings.image != blank %}
                {% assign model_image_alt = block.settings.image_alt | default: block.settings.title %}
                {% render 'responsive-image',
                  image: block.settings.image,
                  alt: model_image_alt,
                  class: 'ipad-fit-grid__image',
                  loading: 'lazy',
                  sizes: '(min-width: 1100px) 22vw, (min-width: 720px) 40vw, 88vw',
                  widths: '260, 420, 640, 820'
                %}
              {% else %}
                <div class="ipad-fit-grid__placeholder" aria-hidden="true">
                  <span></span>
                </div>
              {% endif %}
            </div>
            <div class="ipad-fit-grid__card-copy">
              <h3>{{ block.settings.title }}</h3>
              {% if block.settings.subtitle != blank %}
                <p>{{ block.settings.subtitle }}</p>
              {% endif %}
              <span class="ipad-fit-grid__cta">
                {{ block.settings.cta_label }}
                <span aria-hidden="true">-&gt;</span>
              </span>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .ipad-fit-grid {
    padding: 1rem 0;
  }

  .ipad-fit-grid__header {
    max-width: 46rem;
    margin-bottom: 1.2rem;
  }

  .ipad-fit-grid__eyebrow {
    margin: 0 0 0.65rem;
    background: linear-gradient(90deg, #24e5ff, #d96dff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ipad-fit-grid__title {
    margin: 0;
    color: var(--theme-color-text);
    font-family: var(--theme-font-display);
    font-size: clamp(2rem, 8vw, 4.2rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .ipad-fit-grid__text {
    max-width: 38rem;
    margin: 0.85rem 0 0;
    color: color-mix(in srgb, var(--theme-color-text) 72%, transparent);
    font-size: 1rem;
    line-height: 1.55;
  }

  .ipad-fit-grid__cards {
    display: grid;
    gap: 0.85rem;
  }

  .ipad-fit-grid__card {
    position: relative;
    display: grid;
    min-height: 21rem;
    overflow: hidden;
    border-radius: 1.15rem;
    color: inherit;
    text-decoration: none;
    background: rgba(4, 13, 25, 0.92);
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--theme-color-text) 4%, transparent);
    isolation: isolate;
    transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .ipad-fit-grid__card:hover {
    border-color: rgba(255, 77, 166, 0.72);
    box-shadow: 0 0 28px rgba(255, 77, 166, 0.13), inset 0 1px 0 color-mix(in srgb, var(--theme-color-text) 8%, transparent);
    transform: translateY(-2px);
  }

  .ipad-fit-grid__card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.48) 0%, rgba(0, 0, 0, 0.08) 36%, rgba(0, 0, 0, 0.84) 100%),
      radial-gradient(circle at 20% 10%, color-mix(in srgb, var(--theme-color-secondary) 12%, transparent), transparent 36%),
      radial-gradient(circle at 88% 88%, rgba(255, 77, 166, 0.16), transparent 34%);
  }

  .ipad-fit-grid__number {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    z-index: 2;
    display: inline-flex;
    width: 2.35rem;
    height: 2.35rem;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--theme-color-secondary) 36%, transparent);
    border-radius: 999px;
    color: #27efff;
    background: rgba(3, 12, 24, 0.76);
    font-weight: 800;
  }

  .ipad-fit-grid__media {
    position: absolute;
    inset: 0;
  }

  .ipad-fit-grid__image,
  .ipad-fit-grid__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ipad-fit-grid__placeholder {
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 50% 34%, color-mix(in srgb, var(--theme-color-secondary) 20%, transparent), transparent 28%),
      radial-gradient(circle at 62% 68%, rgba(214, 101, 255, 0.18), transparent 34%),
      rgba(3, 12, 24, 0.96);
  }

  .ipad-fit-grid__placeholder span {
    width: 8rem;
    height: 11rem;
    border: 0.55rem solid color-mix(in srgb, var(--theme-color-text) 18%, transparent);
    border-radius: 1.1rem;
    box-shadow: 0 0 36px rgba(39, 214, 255, 0.14);
  }

  .ipad-fit-grid__card-copy {
    position: relative;
    z-index: 2;
    align-self: end;
    padding: 4.8rem 1rem 1rem;
  }

  .ipad-fit-grid__card-copy h3 {
    margin: 0;
    color: var(--theme-color-text);
    font-family: var(--theme-font-display);
    font-size: 1.35rem;
    line-height: 1.08;
  }

  .ipad-fit-grid__card-copy p {
    margin: 0.45rem 0 0;
    color: color-mix(in srgb, var(--theme-color-text) 70%, transparent);
    font-size: 0.88rem;
    line-height: 1.4;
  }

  .ipad-fit-grid__cta {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    margin-top: 0.9rem;
    color: #24e5ff;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media (min-width: 640px) {
    .ipad-fit-grid__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1020px) {
    .ipad-fit-grid__cards {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-auto-flow: dense;
    }

    .ipad-fit-grid__card {
      grid-column: span 2;
      min-height: 24rem;
    }

    .ipad-fit-grid__card:nth-child(1),
    .ipad-fit-grid__card:nth-child(2) {
      grid-column: span 3;
    }

    .ipad-fit-grid__card:nth-child(6),
    .ipad-fit-grid__card:nth-child(7) {
      grid-column: span 3;
    }
  }
{% endstylesheet %}

