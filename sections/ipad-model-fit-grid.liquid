<section class="ipad-fit-grid section" id="model-fit-grid">
  <div class="container">
    <div class="ipad-fit-grid__header">
      <p class="ipad-fit-grid__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="ipad-fit-grid__title">{{ section.settings.title }}</h2>
      <p class="ipad-fit-grid__text">{{ section.settings.text }}</p>
    </div>

    <div class="ipad-fit-grid__cards" role="list">
      {% for block in section.blocks %}
        {% if block.type == 'model_card' %}
          <a class="ipad-fit-grid__card" href="{{ block.settings.link | default: '#' }}" role="listitem" {{ block.shopify_attributes }}>
            <span class="ipad-fit-grid__number">{{ forloop.index }}</span>
            <div class="ipad-fit-grid__media">
              {% if block.settings.image != blank %}
                {% render 'responsive-image',
                  image: block.settings.image,
                  alt: block.settings.image_alt,
                  class: 'ipad-fit-grid__image',
                  loading: 'lazy',
                  sizes: '(min-width: 1100px) 22vw, (min-width: 720px) 40vw, 88vw',
                  widths: '260, 420, 640, 820'
                %}
              {% else %}
                <div class="ipad-fit-grid__placeholder" aria-hidden="true">
                  <span></span>
                </div>
              {% endif %}
            </div>
            <div class="ipad-fit-grid__card-copy">
              <h3>{{ block.settings.title }}</h3>
              {% if block.settings.subtitle != blank %}
                <p>{{ block.settings.subtitle }}</p>
              {% endif %}
              <span class="ipad-fit-grid__cta">
                {{ block.settings.cta_label }}
                <span aria-hidden="true">-&gt;</span>
              </span>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .ipad-fit-grid {
    padding: 1rem 0;
  }

  .ipad-fit-grid__header {
    max-width: 46rem;
    margin-bottom: 1.2rem;
  }

  .ipad-fit-grid__eyebrow {
    margin: 0 0 0.65rem;
    background: linear-gradient(90deg, #24e5ff, #d96dff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ipad-fit-grid__title {
    margin: 0;
    color: var(--theme-color-text);
    font-family: var(--theme-font-display);
    font-size: clamp(2rem, 8vw, 4.2rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .ipad-fit-grid__text {
    max-width: 38rem;
    margin: 0.85rem 0 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 1rem;
    line-height: 1.55;
  }

  .ipad-fit-grid__cards {
    display: grid;
    gap: 0.85rem;
  }

  .ipad-fit-grid__card {
    position: relative;
    display: grid;
    min-height: 21rem;
    overflow: hidden;
    border: 1px solid rgba(56, 221, 255, 0.2);
    border-radius: 1.15rem;
    color: inherit;
    text-decoration: none;
    background: rgba(4, 13, 25, 0.92);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
    isolation: isolate;
    transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .ipad-fit-grid__card:hover {
    border-color: rgba(255, 77, 166, 0.72);
    box-shadow: 0 0 28px rgba(255, 77, 166, 0.13), inset 0 1px 0 rgba(255, 255, 255, 0.08);
    transform: translateY(-2px);
  }

  .ipad-fit-grid__card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.48) 0%, rgba(0, 0, 0, 0.08) 36%, rgba(0, 0, 0, 0.84) 100%),
      radial-gradient(circle at 20% 10%, rgba(0, 229, 255, 0.12), transparent 36%),
      radial-gradient(circle at 88% 88%, rgba(255, 77, 166, 0.16), transparent 34%);
  }

  .ipad-fit-grid__number {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    z-index: 2;
    display: inline-flex;
    width: 2.35rem;
    height: 2.35rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(0, 229, 255, 0.36);
    border-radius: 999px;
    color: #27efff;
    background: rgba(3, 12, 24, 0.76);
    font-weight: 800;
  }

  .ipad-fit-grid__media {
    position: absolute;
    inset: 0;
  }

  .ipad-fit-grid__image,
  .ipad-fit-grid__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ipad-fit-grid__placeholder {
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 50% 34%, rgba(0, 229, 255, 0.2), transparent 28%),
      radial-gradient(circle at 62% 68%, rgba(214, 101, 255, 0.18), transparent 34%),
      rgba(3, 12, 24, 0.96);
  }

  .ipad-fit-grid__placeholder span {
    width: 8rem;
    height: 11rem;
    border: 0.55rem solid rgba(255, 255, 255, 0.18);
    border-radius: 1.1rem;
    box-shadow: 0 0 36px rgba(39, 214, 255, 0.14);
  }

  .ipad-fit-grid__card-copy {
    position: relative;
    z-index: 2;
    align-self: end;
    padding: 4.8rem 1rem 1rem;
  }

  .ipad-fit-grid__card-copy h3 {
    margin: 0;
    color: var(--theme-color-text);
    font-family: var(--theme-font-display);
    font-size: 1.35rem;
    line-height: 1.08;
  }

  .ipad-fit-grid__card-copy p {
    margin: 0.45rem 0 0;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.88rem;
    line-height: 1.4;
  }

  .ipad-fit-grid__cta {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    margin-top: 0.9rem;
    color: #24e5ff;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media (min-width: 640px) {
    .ipad-fit-grid__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1020px) {
    .ipad-fit-grid__cards {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-auto-flow: dense;
    }

    .ipad-fit-grid__card {
      grid-column: span 2;
      min-height: 24rem;
    }

    .ipad-fit-grid__card:nth-child(1),
    .ipad-fit-grid__card:nth-child(2) {
      grid-column: span 3;
    }

    .ipad-fit-grid__card:nth-child(7) {
      grid-column: 3 / span 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "iPad Model Fit Grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Compatible Fits" },
    { "type": "text", "id": "title", "label": "Title", "default": "7 Perfect Fits. Zero Guesswork." },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Select your iPad model to ensure the NoxRev TXP1 is built for your device."
    }
  ],
  "blocks": [
    {
      "type": "model_card",
      "name": "Model card",
      "limit": 7,
      "settings": [
        { "type": "text", "id": "title", "label": "Model title", "default": "iPad Pro 13 inch" },
        { "type": "text", "id": "subtitle", "label": "Subtitle / generation", "default": "M4/M5" },
        { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop This Fit" },
        { "type": "url", "id": "link", "label": "Variant/product link" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Compatible iPad model" }
      ]
    }
  ],
  "presets": [
    {
      "name": "iPad Model Fit Grid",
      "blocks": [
        { "type": "model_card", "settings": { "title": "iPad Pro 13 inch", "subtitle": "M4/M5" } },
        { "type": "model_card", "settings": { "title": "iPad Pro 11 inch", "subtitle": "M4/M5" } },
        { "type": "model_card", "settings": { "title": "iPad Air 13 inch / Pro 12.9 inch", "subtitle": "Air M2/M3/M4 / Pro 3rd-6th Gen" } },
        { "type": "model_card", "settings": { "title": "iPad Air 11 inch / Pro 11 inch", "subtitle": "Air 4th/5th/M2/M3/M4 / Pro 1st-4th Gen" } },
        { "type": "model_card", "settings": { "title": "iPad 10.9 inch", "subtitle": "10th/A16/11th" } },
        { "type": "model_card", "settings": { "title": "iPad 10.2 inch", "subtitle": "7th/8th/9th Gen" } },
        { "type": "model_card", "settings": { "title": "iPad MINI 8.3 inch", "subtitle": "6th/7th Gen" } }
      ]
    }
  ]
}
{% endschema %}
