<section class="find-model-hero section">
  <div class="container">
    <div class="find-model-hero__panel">
      <div class="find-model-hero__copy">
        {% if section.settings.eyebrow != blank %}
          <p class="find-model-hero__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        <h1 class="find-model-hero__title">{{ section.settings.title }}</h1>

        {% if section.settings.text != blank %}
          <p class="find-model-hero__text">{{ section.settings.text }}</p>
        {% endif %}

        {% if section.settings.benefit_text != blank %}
          <p class="find-model-hero__benefit">{{ section.settings.benefit_text }}</p>
        {% endif %}

        {% if section.settings.cta_label != blank %}
          <a class="button button--primary find-model-hero__button" href="{{ section.settings.cta_link | default: '#model-fit-grid' }}">
            <span>{{ section.settings.cta_label }}</span>
            <span aria-hidden="true">-&gt;</span>
          </a>
        {% endif %}
      </div>

      <div class="find-model-hero__guide" role="list" aria-label="Ways to identify your iPad">
        {% for block in section.blocks %}
          {% if block.type == 'guide_card' %}
            <article class="find-model-hero__guide-card" role="listitem" {{ block.shopify_attributes }}>
              <span class="find-model-hero__guide-icon" aria-hidden="true">
                {% if block.settings.icon_image != blank %}
                  {{ block.settings.icon_image | image_url: width: 72 | image_tag: loading: 'lazy', alt: '', class: 'find-model-hero__icon-image' }}
                {% else %}
                  {% render 'product-marketing-icon', icon: block.settings.icon %}
                {% endif %}
              </span>
              <h2>{{ block.settings.title }}</h2>
              <p>{{ block.settings.text }}</p>
            </article>
          {% endif %}
        {% endfor %}
      </div>

      <a class="find-model-hero__video" href="{{ section.settings.video_link | default: '#' }}" aria-label="{{ section.settings.video_title | escape }}">
        <div class="find-model-hero__video-media">
          {% if section.settings.video != blank %}
            {{
              section.settings.video
              | video_tag:
                class: 'find-model-hero__video-element',
                image_size: '1100x',
                autoplay: true,
                loop: true,
                muted: true,
                controls: false,
                playsinline: true
            }}
          {% elsif section.settings.video_image != blank %}
            {% render 'responsive-image',
              image: section.settings.video_image,
              alt: section.settings.video_image_alt,
              class: 'find-model-hero__video-image',
              loading: 'lazy',
              sizes: '(min-width: 900px) 38vw, 100vw',
              widths: '420, 640, 860, 1100'
            %}
          {% else %}
            <div class="find-model-hero__video-placeholder" aria-hidden="true"></div>
          {% endif %}
          {% unless section.settings.video != blank %}
            <span class="find-model-hero__play" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" focusable="false"><path d="m9 7 8 5-8 5V7Z" fill="currentColor"/></svg>
            </span>
          {% endunless %}
        </div>

        <div class="find-model-hero__video-copy">
          <p>{{ section.settings.video_eyebrow }}</p>
          <h2>{{ section.settings.video_title }}</h2>
          <span class="find-model-hero__progress" aria-hidden="true"><span></span></span>
        </div>
      </a>
    </div>
  </div>
</section>

{% stylesheet %}
  .find-model-hero {
    padding: 2rem 0 1rem;
  }

  .find-model-hero__panel {
    display: grid;
    gap: 1rem;
    position: relative;
    overflow: hidden;
    border-radius: 1.35rem;
    padding: 1rem;
    background:
      radial-gradient(circle at 10% 10%, rgba(0, 229, 255, 0.14), transparent 32%),
      radial-gradient(circle at 90% 18%, rgba(255, 77, 166, 0.14), transparent 34%),
      linear-gradient(135deg, rgba(8, 18, 36, 0.96), rgba(2, 8, 18, 0.98));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04), 0 24px 60px rgba(0, 0, 0, 0.28);
  }

  .find-model-hero__copy,
  .find-model-hero__guide,
  .find-model-hero__video {
    position: relative;
    z-index: 1;
  }

  .find-model-hero__eyebrow,
  .find-model-hero__video-copy p {
    margin: 0 0 0.75rem;
    background: linear-gradient(90deg, #24e5ff, #d96dff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .find-model-hero__title {
    max-width: 12ch;
    margin: 0;
    background: linear-gradient(100deg, #ff4da6 8%, #c98bff 48%, #6ec8ff 92%);
    -webkit-background-clip: text;
    background-clip: text;
    color: #ff4da6;
    -webkit-text-fill-color: transparent;
    font-family: var(--theme-font-display);
    font-size: clamp(3rem, 16vw, 5.6rem);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.055em;
  }

  .find-model-hero__text,
  .find-model-hero__benefit {
    max-width: 37rem;
    margin: 1rem 0 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: 1rem;
    line-height: 1.55;
  }

  .find-model-hero__benefit {
    color: var(--theme-color-text);
    font-weight: 700;
  }

  .find-model-hero__button {
    width: fit-content;
    margin-top: 1.25rem;
  }

  .find-model-hero__guide {
    display: grid;
    gap: 0.75rem;
  }

  .find-model-hero__guide-card,
  .find-model-hero__video {
    border: 1px solid rgba(56, 221, 255, 0.18);
    border-radius: 1rem;
    background: rgba(3, 12, 24, 0.68);
  }

  .find-model-hero__guide-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
    padding: 0.9rem;
  }

  .find-model-hero__guide-icon {
    display: inline-flex;
    width: 2.65rem;
    height: 2.65rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(0, 229, 255, 0.36);
    border-radius: 999px;
    color: #27efff;
    background: rgba(3, 12, 24, 0.78);
  }

  .find-model-hero__guide-icon svg,
  .find-model-hero__icon-image {
    width: 1.25rem;
    height: 1.25rem;
    object-fit: contain;
  }

  .find-model-hero__guide-card h2 {
    min-width: 0;
    margin: 0;
    color: var(--theme-color-text);
    font-size: 0.95rem;
    line-height: 1.2;
    overflow-wrap: normal;
    word-break: normal;
  }

  .find-model-hero__guide-card p {
    grid-column: 1 / -1;
    margin: 0.25rem 0 0;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .find-model-hero__video {
    display: grid;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
  }

  .find-model-hero__video-media {
    position: relative;
    min-height: 15rem;
    overflow: hidden;
  }

  .find-model-hero__video-element,
  .find-model-hero__video-image,
  .find-model-hero__video-placeholder {
    width: 100%;
    height: 100%;
    min-height: 15rem;
    object-fit: cover;
  }

  .find-model-hero__video-element {
    display: block;
  }

  .find-model-hero__video-placeholder {
    background:
      linear-gradient(135deg, rgba(0, 229, 255, 0.18), rgba(214, 101, 255, 0.12)),
      radial-gradient(circle at 60% 38%, rgba(255, 255, 255, 0.14), transparent 24%),
      rgba(4, 13, 25, 0.9);
  }

  .find-model-hero__video-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 36%, rgba(2, 8, 18, 0.74));
  }

  .find-model-hero__play {
    position: absolute;
    inset: 50% auto auto 50%;
    z-index: 1;
    display: inline-flex;
    width: 4.6rem;
    height: 4.6rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    color: #101927;
    background: linear-gradient(135deg, #00f5c8, #27d6ff);
    box-shadow: 0 0 30px rgba(39, 214, 255, 0.28);
    transform: translate(-50%, -50%);
  }

  .find-model-hero__play svg {
    width: 1.7rem;
    height: 1.7rem;
  }

  .find-model-hero__video-copy {
    padding: 1rem;
  }

  .find-model-hero__video-copy h2 {
    margin: 0;
    color: var(--theme-color-text);
    font-family: var(--theme-font-display);
    font-size: 1.4rem;
    line-height: 1.08;
  }

  .find-model-hero__progress {
    display: block;
    height: 0.35rem;
    margin-top: 1rem;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
  }

  .find-model-hero__progress span {
    display: block;
    width: 42%;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #00f5c8, #27d6ff);
  }

  @media (min-width: 860px) {
    .find-model-hero {
      padding-top: 3rem;
    }

    .find-model-hero__panel {
      grid-template-columns: minmax(0, 1fr) minmax(21rem, 0.76fr);
      gap: 1.35rem;
      padding: 1.35rem;
    }

    .find-model-hero__copy {
      align-self: center;
      padding: 1rem 0 1rem 0.75rem;
    }

    .find-model-hero__guide {
      grid-column: 1 / -1;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      order: 3;
    }

    .find-model-hero__video {
      min-height: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Find Model Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "NoxRev Fit Guide" },
    { "type": "text", "id": "title", "label": "Title", "default": "Find Your iPad Model" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Identify your iPad in seconds and choose the exact compatible fit for the NoxRev TXP1 Keyboard Case."
    },
    { "type": "text", "id": "benefit_text", "label": "Benefit line", "default": "Perfect alignment. Full access. Zero guesswork." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Browse All Compatible Models" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "text", "id": "video_eyebrow", "label": "Video eyebrow", "default": "Quick Guide" },
    { "type": "text", "id": "video_title", "label": "Video title", "default": "How to identify your iPad in 30 seconds" },
    { "type": "video", "id": "video", "label": "Shopify-hosted video" },
    { "type": "image_picker", "id": "video_image", "label": "Video thumbnail image" },
    { "type": "text", "id": "video_image_alt", "label": "Video image alt text", "default": "iPad model identification guide" },
    { "type": "url", "id": "video_link", "label": "Video or guide link" }
  ],
  "blocks": [
    {
      "type": "guide_card",
      "name": "Guide card",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Check the back model number" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Look for the small model number printed near the bottom of your iPad." },
        {
          "type": "select",
          "id": "icon",
          "label": "Fallback icon",
          "default": "apps",
          "options": [
            { "value": "apps", "label": "Grid" },
            { "value": "zoom", "label": "Search" },
            { "value": "shield", "label": "Shield" }
          ]
        },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Find Model Hero",
      "blocks": [
        { "type": "guide_card", "settings": { "title": "Check the back model number", "text": "Look for the small model number printed near the bottom of your iPad.", "icon": "zoom" } },
        { "type": "guide_card", "settings": { "title": "Check in Settings", "text": "Open Settings > General > About and look for Model Name.", "icon": "apps" } },
        { "type": "guide_card", "settings": { "title": "Match size and generation", "text": "Compare your iPad size and generation with the exact fit cards below.", "icon": "shield" } }
      ]
    }
  ]
}
{% endschema %}
