<section class="product-unique-modes-strip section">
  <div class="container">
    <article class="product-unique-modes-strip__panel">
      <div class="product-unique-modes-strip__header">
        <h2 class="product-unique-modes-strip__title">{{ section.settings.title }}</h2>
        <p class="product-unique-modes-strip__text">{{ section.settings.text }}</p>
      </div>

      <div class="product-unique-modes-strip__items" role="list">
        {% for block in section.blocks %}
          {% liquid
            assign mode_image = block.settings.image | default: product.featured_media.preview_image
          %}
          <div class="product-unique-modes-strip__item" role="listitem" {{ block.shopify_attributes }}>
            <div class="product-unique-modes-strip__media">
              {% if mode_image != blank %}
                {% assign mode_image_alt = block.settings.image_alt | default: block.settings.label %}
                {% render 'responsive-image',
                  image: mode_image,
                  alt: mode_image_alt,
                  class: 'product-unique-modes-strip__image',
                  loading: 'lazy',
                  sizes: '(min-width: 900px) 14vw, 34vw',
                  widths: '160, 240, 360, 520'
                %}
              {% else %}
                <div class="product-unique-modes-strip__placeholder" aria-hidden="true"></div>
              {% endif %}
            </div>
            <span>{{ block.settings.label }}</span>
          </div>
        {% endfor %}
      </div>
    </article>
  </div>
</section>



{% schema %}
{
  "name": "PDP Modes Strip",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "7 Unique Modes" },
    { "type": "text", "id": "text", "label": "Text", "default": "360 swivel. 180 flip. Infinite possibilities." }
  ],
  "blocks": [
    {
      "type": "mode",
      "name": "Mode",
      "limit": 12,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Laptop Mode" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP Modes Strip",
      "blocks": [
        { "type": "mode", "settings": { "label": "Laptop Mode" } },
        { "type": "mode", "settings": { "label": "Stand Mode" } },
        { "type": "mode", "settings": { "label": "Tent Mode" } },
        { "type": "mode", "settings": { "label": "Tablet Mode" } },
        { "type": "mode", "settings": { "label": "Drawing Mode" } },
        { "type": "mode", "settings": { "label": "Viewing Mode" } },
        { "type": "mode", "settings": { "label": "Presentation Mode" } }
      ]
    }
  ]
}
{% endschema %}
