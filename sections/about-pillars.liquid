{% render 'section-layout', section: section %}
{{ 'about-noxrev.css' | asset_url | stylesheet_tag }}

<section class="about-noxrev about-noxrev--tight">
  <div class="container">
    <div class="about-noxrev__card">
      {% if section.settings.eyebrow != blank %}
        <p class="about-noxrev__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="about-noxrev__heading">{{ section.settings.heading }}</h2>

      <div class="about-noxrev__pillars">
        {% for block in section.blocks %}
          <article class="about-noxrev__pillar" {{ block.shopify_attributes }}>
            <span class="about-noxrev__icon" aria-hidden="true">
              {% if block.settings.icon != blank %}
                {{ block.settings.icon | image_url: width: 96 | image_tag: loading: 'lazy' }}
              {% else %}
                <svg viewBox="0 0 24 24" fill="none" focusable="false"><path d="M12 3 20 8v8l-8 5-8-5V8l8-5Z" stroke="currentColor" stroke-width="1.6"/><path d="M8.5 12h7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              {% endif %}
            </span>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About pillars",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WHY WE BUILT IT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed around what matters."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_width",
      "label": "Content width",
      "options": [
        {
          "value": "inherit",
          "label": "Current width"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "layout_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "inherit",
          "label": "Current alignment"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "checkbox",
      "id": "custom_spacing",
      "label": "Use custom section spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top spacing mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom spacing mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "checkbox",
      "id": "use_section_scheme",
      "label": "Use section color scheme",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "device_visibility",
      "label": "Device visibility",
      "options": [
        {
          "value": "both",
          "label": "Both"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        }
      ],
      "default": "both"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Precision"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Every detail exists for a reason."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About pillars",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "title": "Precision",
            "text": "Every detail exists for a reason."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "Versatility",
            "text": "One keyboard. Multiple ways to work, create, and relax."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "Premium Materials",
            "text": "Built to feel solid, look sharp, and last."
          }
        }
      ]
    }
  ]
}
{% endschema %}

