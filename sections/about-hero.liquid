{% style %}{% if section.settings.layout_gap > 0 %}#shopify-section-{{ section.id }} .about-noxrev__grid{gap:{{ section.settings.layout_gap }}px}{% endif %}@media(min-width:750px){ {% unless section.settings.layout_columns == 'inherit' %}#shopify-section-{{ section.id }} .about-noxrev__grid{display:grid;grid-template-columns:repeat({{ section.settings.layout_columns }},minmax(0,1fr))}{% endunless %}}@media(max-width:749px){ {% unless section.settings.layout_mobile_columns == 'inherit' %}#shopify-section-{{ section.id }} .about-noxrev__grid{display:grid;grid-template-columns:repeat({{ section.settings.layout_mobile_columns }},minmax(0,1fr))}{% endunless %}}{% endstyle %}
{% render 'section-layout', section: section %}
{{ 'about-noxrev.css' | asset_url | stylesheet_tag }}

<section class="about-noxrev about-noxrev--hero">
  <div class="container">
    <div class="about-noxrev__grid about-noxrev__grid--split">
      <div class="about-noxrev__card">
        {% if section.settings.eyebrow != blank %}
          <p class="about-noxrev__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h1 class="about-noxrev__title">{{ section.settings.title }}</h1>
        {% if section.settings.intro != blank %}
          <p class="about-noxrev__text">{{ section.settings.intro }}</p>
        {% endif %}
      </div>

      <div class="about-noxrev__media-card">
        {% if section.settings.image != blank %}
          {% assign hero_image_alt = section.settings.image.alt | default: section.settings.title %}
          {{ section.settings.image | image_url: width: 1400 | image_tag: class: 'about-noxrev__image', loading: 'eager', alt: hero_image_alt, sizes: '(min-width: 860px) 52vw, 100vw' }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'about-noxrev__placeholder' }}
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ABOUT NOXREV"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Designed to unlock the full potential of your iPad."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro copy",
      "default": "We believe the iPad deserves accessories that are as versatile as the device itself. NoxRev creates premium keyboard cases engineered for work, creativity, and everyday life."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_width",
      "label": "Content width",
      "options": [
        {
          "value": "inherit",
          "label": "Current width"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "layout_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "inherit",
          "label": "Current alignment"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "checkbox",
      "id": "custom_spacing",
      "label": "Use custom section spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top spacing mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom spacing mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "checkbox",
      "id": "use_section_scheme",
      "label": "Use section color scheme",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "device_visibility",
      "label": "Device visibility",
      "options": [
        {
          "value": "both",
          "label": "Both"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        }
      ],
      "default": "both"
    },
    {
      "type": "range",
      "id": "layout_gap",
      "label": "Grid gap (0 keeps current)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "layout_columns",
      "label": "Desktop columns",
      "options": [
        {
          "value": "inherit",
          "label": "Current columns"
        },
        {
          "value": "2",
          "label": "Two"
        },
        {
          "value": "3",
          "label": "Three"
        },
        {
          "value": "4",
          "label": "Four"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "layout_mobile_columns",
      "label": "Mobile columns",
      "options": [
        {
          "value": "inherit",
          "label": "Current columns"
        },
        {
          "value": "1",
          "label": "One"
        },
        {
          "value": "2",
          "label": "Two"
        }
      ],
      "default": "inherit"
    }
  ],
  "presets": [
    {
      "name": "About hero"
    }
  ]
}
{% endschema %}

