        "type": "select",
        "id": "global_shipping_icon_type",
        "label": "Shipping icon",
        "options": [
          {
            "value": "shipping",
            "label": "Shipping"
          },
          {
            "value": "shield",
            "label": "Shield"
          },
          {
            "value": "return",
            "label": "Return"
          },
          {
            "value": "check",
            "label": "Check"
          }
