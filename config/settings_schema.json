[
  {
    "name": "theme_info",
    "theme_name": "NOXREV",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "SEO and social sharing",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "image_picker",
        "id": "social_share_image",
        "label": "Default social sharing image",
        "info": "Used when a page has no featured image. Recommended size: 1200 x 630 px."
      }
    ]
  },
  {
    "name": "Shared NOXREV content",
    "settings": [
      {
        "type": "text",
        "id": "global_support_email",
        "label": "Support email",
        "default": "support@noxrev.com",
        "info": "Shared by the header drawer, footer, contact page, and homepage support card when global contact is enabled. Sections can keep their own contact details."
      },
      {
        "type": "text",
        "id": "global_support_phone",
        "label": "Support phone",
        "info": "Optional shared phone number for the header drawer and footer. Leave blank if you do not offer phone support."
      },
      {
        "type": "url",
        "id": "global_model_guide_url",
        "label": "Find your iPad model guide",
        "info": "Shared fallback for the homepage feature, About CTA, contact page, cart, and cart drawer. A section-specific link takes priority."
      },
      {
        "type": "url",
        "id": "global_social_tiktok_url",
        "label": "TikTok profile"
      },
      {
        "type": "url",
        "id": "global_social_instagram_url",
        "label": "Instagram profile"
      },
      {
        "type": "url",
        "id": "global_social_facebook_url",
        "label": "Facebook profile"
      },
      {
        "type": "url",
        "id": "global_social_youtube_url",
        "label": "YouTube profile"
      },
      {
        "type": "header",
        "content": "Product service benefit defaults. Existing local product messages and icons remain editable and can override these shared values."
      },
      {
        "type": "text",
        "id": "global_shipping_trust_text",
        "label": "Product shipping message",
        "default": "Free 3–5 day U.S. shipping"
      },
      {
        "type": "image_picker",
        "id": "global_shipping_trust_icon",
        "label": "Product shipping icon"
      },
      {
        "type": "text",
        "id": "global_guarantee_trust_text",
        "label": "Product guarantee message",
        "default": "Money-back guarantee"
      },
      {
        "type": "image_picker",
        "id": "global_guarantee_trust_icon",
        "label": "Product guarantee icon"
      },
      {
        "type": "text",
        "id": "global_returns_trust_text",
        "label": "Product returns message",
        "default": "30-day returns"
      },
      {
        "type": "image_picker",
        "id": "global_returns_trust_icon",
        "label": "Product returns icon"
      }
    ]
  },
  {
    "name": "Breadcrumbs",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_breadcrumbs",
        "label": "Show breadcrumbs",
        "default": true,
        "info": "Breadcrumbs remain hidden on the homepage, password, and gift-card pages. Product breadcrumbs stay hidden on mobile to preserve the current layout."
      }
    ]
  },
  {
    "name": "Catalog search",
    "settings": [
      {
        "type": "product",
        "id": "catalog_search_keyboard_product",
        "label": "Primary keyboard product",
        "info": "Variants are grouped into one search card per configured model option value."
      },
      {
        "type": "text",
        "id": "catalog_search_model_option_name",
        "label": "Model option name",
        "default": "Model",
        "info": "Must match the keyboard product option that represents the iPad model."
      },
      {
        "type": "collection",
        "id": "catalog_search_accessories_collection",
        "label": "Accessories collection",
        "info": "Each product in this collection becomes one accessory search result."
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  }
]
