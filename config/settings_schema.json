  {
    "name": "Breadcrumbs",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_breadcrumbs",
        "label": "Show breadcrumbs",
        "default": true,
        "info": "Set page and device visibility below."
      },
      {
        "type": "checkbox",
        "id": "breadcrumbs_mobile",
        "label": "Show on mobile",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "breadcrumbs_desktop",
        "label": "Show on desktop",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "breadcrumbs_product",
        "label": "Show on product pages",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "breadcrumbs_collection",
        "label": "Show on collection pages",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "breadcrumbs_page",
        "label": "Show on page pages",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "breadcrumbs_blog",
        "label": "Show on blog pages",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "breadcrumbs_article",
        "label": "Show on article pages",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "breadcrumbs_search",
        "label": "Show on search pages",
        "default": true
      }
    ]
  },
  {
    "name": "Catalog search",
    "settings": [
      {
        "type": "product",
        "id": "catalog_search_keyboard_product",
        "label": "Primary keyboard product",
        "info": "Variants are grouped into one search card per configured model option value."
      },
      {
        "type": "text",
        "id": "catalog_search_model_option_name",
        "label": "Model option name",
        "default": "Model",
        "info": "Must match the keyboard product option that represents the iPad model."
      },
      {
        "type": "collection",
        "id": "catalog_search_accessories_collection",
        "label": "Accessories collection",
        "info": "Each product in this collection becomes one accessory search result."
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      },
      {
        "type": "checkbox",
        "id": "use_original_heading_font",
        "label": "Use NOXREV Oxanium heading font",
        "default": true
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Alternative heading font",
        "info": "Used when the Oxanium option above is off.",
        "default": "work_sans_n4"
      },
      {
        "type": "range",
        "id": "body_scale",
        "label": "Body text scale",
        "min": 80,
        "max": 150,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Heading text scale",
        "min": 80,
        "max": 150,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
