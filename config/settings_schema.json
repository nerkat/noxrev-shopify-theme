[
  {
    "name": "theme_info",
    "theme_name": "NOXREV",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "SEO and social sharing",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "image_picker",
        "id": "social_share_image",
        "label": "Default social sharing image",
        "info": "Used when a page has no featured image. Recommended size: 1200 x 630 px."
      }
    ]
  },
  {
    "name": "Shared NOXREV content",
    "settings": [
      {
        "type": "text",
        "id": "global_support_email",
        "label": "Support email",
        "default": "support@noxrev.com",
        "info": "Used when a section's own support email is blank."
      },
      {
        "type": "url",
        "id": "global_model_guide_url",
        "label": "Find your iPad model guide",
        "info": "Used when a section's own model guide link is blank."
      },
      {
        "type": "url",
        "id": "global_social_tiktok_url",
        "label": "TikTok profile"
      },
      {
        "type": "url",
        "id": "global_social_instagram_url",
        "label": "Instagram profile"
      },
      {
        "type": "url",
        "id": "global_social_facebook_url",
        "label": "Facebook profile"
      },
      {
        "type": "url",
        "id": "global_social_youtube_url",
        "label": "YouTube profile"
      }
    ]
  },
  {
    "name": "Catalog search",
    "settings": [
      {
        "type": "product",
        "id": "catalog_search_keyboard_product",
        "label": "Primary keyboard product",
        "info": "Variants are grouped into one search card per configured model option value."
      },
      {
        "type": "text",
        "id": "catalog_search_model_option_name",
        "label": "Model option name",
        "default": "Model",
        "info": "Must match the keyboard product option that represents the iPad model."
      },
      {
        "type": "collection",
        "id": "catalog_search_accessories_collection",
        "label": "Accessories collection",
        "info": "Each product in this collection becomes one accessory search result."
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  }
]
