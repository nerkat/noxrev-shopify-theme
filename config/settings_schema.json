  {
    "name": "SEO and social sharing",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "image_picker",
        "id": "social_share_image",
        "label": "Default social sharing image",
        "info": "Used when a page has no featured image. Recommended size: 1200 x 630 px."
      }
    ]
  },
  {
    "name": "Shared NOXREV content",
    "settings": [
      {
        "type": "text",
        "id": "global_support_email",
        "label": "Support email",
        "default": "support@noxrev.com",
        "info": "Shared by the header drawer, footer, contact page, and homepage support card when global contact is enabled. Sections can keep their own contact details."
      },
      {
        "type": "text",
        "id": "global_support_phone",
        "label": "Support phone",
        "info": "Optional shared phone number for the header drawer and footer. Leave blank if you do not offer phone support."
      },
      {
        "type": "url",
        "id": "global_model_guide_url",
        "label": "Find your iPad model guide",
        "info": "Shared fallback for the homepage feature, About CTA, contact page, cart, and cart drawer. A section-specific link takes priority."
      },
      {
        "type": "url",
        "id": "global_social_tiktok_url",
        "label": "TikTok profile"
      },
      {
        "type": "url",
        "id": "global_social_instagram_url",
        "label": "Instagram profile"
      },
      {
        "type": "url",
        "id": "global_social_facebook_url",
        "label": "Facebook profile"
      },
      {
        "type": "url",
        "id": "global_social_youtube_url",
        "label": "YouTube profile"
      },
      {
        "type": "header",
        "content": "Product service benefit defaults. Existing local product messages and icons remain editable and can override these shared values."
      },
      {
        "type": "text",
        "id": "global_shipping_trust_text",
        "label": "Product shipping message",
        "default": "Free 3–5 day U.S. shipping"
      },
      {
        "type": "image_picker",
        "id": "global_shipping_trust_icon",
        "label": "Product shipping icon"
      },
      {
        "type": "text",
        "id": "global_guarantee_trust_text",
        "label": "Product guarantee message",
        "default": "Money-back guarantee"
      },
      {
        "type": "image_picker",
        "id": "global_guarantee_trust_icon",
        "label": "Product guarantee icon"
      },
      {
        "type": "text",
        "id": "global_returns_trust_text",
        "label": "Product returns message",
        "default": "30-day returns"
